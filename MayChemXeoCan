		ElasticBehavior=Enum.ElasticBehavior.Never,
		ScrollingEnabled=true,
		Visible=false,
		Active=true,
		ClipsDescendants=true,
		Parent=Content
	})
	SS.Round(page,20)
	SS.GlassStroke(page,.60,1)
	SS.GlassGradient(page,C.White,C.PSoft,108)

	SS.New("UIPadding",{
		PaddingTop=UDim.new(0,8),
		PaddingBottom=UDim.new(0,10),
		PaddingLeft=UDim.new(0,12),
		PaddingRight=UDim.new(0,12),
		Parent=page
	})

	SS.New("UIListLayout",{
		Padding=UDim.new(0,8),
		SortOrder=Enum.SortOrder.LayoutOrder,
		Parent=page
	})

	local tab=nil
	if not hiddenTab then
		tab=SS.New("TextButton",{
			Size=UDim2.new(1,-2,0,42),
			BackgroundColor3=C.White,
			BackgroundTransparency=.68,
			BorderSizePixel=0,
			Text=title,
			TextColor3=C.Sub,
			TextSize=math.clamp(State.TabTextSize or 9,8,14),
			Font=Enum.Font.GothamBold,
			TextWrapped=true,
			AutoButtonColor=false,
			Active=true,
			Parent=Tabs
		})
		SS.Round(tab,13)
		SS.GlassStroke(tab,.72,1)
		SS.GlassGradient(tab,C.White,C.GlassStrong,105)
		SS.GlassInteractive(tab,.95)
		local marker=SS.New("Frame",{
			Name="ActiveMarker",Size=UDim2.fromOffset(3,20),Position=UDim2.new(0,3,.5,-10),
			BackgroundColor3=C.P,BackgroundTransparency=.05,BorderSizePixel=0,Visible=false,Parent=tab
		})
		SS.Round(marker,4)
	end

	local pageScale=SS.New("UIScale",{Name="PageScale",Scale=1,Parent=page})
	self.Pages[id]=page
	self.Tabs[id]=tab
	self.PageScales[id]=pageScale

	local function Select(force)
		if self.OpenPicker and self.OpenPicker.ToggleList then self.OpenPicker:ToggleList(false) end
		if Input.Owner and not force then return false end
		if force and Input.Owner then SS.Release(Input.Owner) end
		if self.Active==id and page.Visible then return true end
		Content.Visible=true

		for k,p in pairs(self.Pages) do
			local on=k==id
			p.Visible=on
			p.Active=on
			p.ZIndex=on and 25 or 1
			local t=self.Tabs[k]
			if t then
				Tween(t,{
					BackgroundColor3=on and C.PSoft or C.White,
					BackgroundTransparency=on and .30 or .68,
					TextColor3=on and C.PText or C.Sub
				},.16)
				local m=t:FindFirstChild("ActiveMarker")
				if m then m.Visible=on end
			end
		end

		self.Active=id
		if id~="Settings" then self.LastNormalPage=id end
		self.LastPageChange=os.clock()
		page.CanvasPosition=Vector2.zero
		pageScale.Scale=1
		page.Position=UDim2.fromOffset(8,2)
		page.BackgroundTransparency=.70
		Tween(page,{Position=UDim2.fromOffset(0,0),BackgroundTransparency=.56},.12)
		if SS.LiquidPulse then SS.LiquidPulse(.58) end
		return true
	end

	self.PageSelectors[id]=Select
	if tab then
		SS.BindTapWithoutDrag(tab,function() Select(true) end,11)
	end

	if not hiddenTab and not self.Active and not self._InitialPageQueued then
		self._InitialPageQueued=true
		task.defer(function()
			if not self.Active then Select() end
		end)
	end

	return page
end

function UI:SetSettingsMode(enabled,skipSelect)
	enabled=enabled==true
	if self.SettingsMode==enabled and (not enabled or self.Active=="Settings") then return end
	if Input.Owner then SS.Release(Input.Owner) end

	if enabled then
		if self.Active and self.Active~="Settings" then self.PreSettingsPage=self.Active end
		self.SettingsMode=true
		SettingsButton.Visible=false
		SettingsBackButton.Visible=true
		SS.SetLocalizedText(HeaderTitle,"SHIFT SYNC  •  CÀI ĐẶT")
		Tween(Content,{Position=UDim2.fromOffset(8,54),Size=UDim2.new(1,-16,1,-62)},.14)
		Tween(Sidebar,{Position=UDim2.fromOffset(-12,54),BackgroundTransparency=.96},.10)
		task.delay(.12,function()
			if UI.SettingsMode then Sidebar.Visible=false end
		end)
		self:SelectPage("Settings",true)
	else
		self.SettingsMode=false
		Sidebar.Visible=true
		Sidebar.Position=UDim2.fromOffset(-12,54)
		Sidebar.BackgroundTransparency=.96
		SettingsButton.Visible=true
		SettingsBackButton.Visible=false
		SS.SetLocalizedText(HeaderTitle,"SHIFT SYNC  ◇")
		Tween(Sidebar,{Position=UDim2.fromOffset(8,54),BackgroundTransparency=.70},.14)
		Tween(Content,{Position=UDim2.fromOffset(90,54),Size=UDim2.new(1,-98,1,-62)},.14)
		if not skipSelect then
			local target=self.PreSettingsPage or self.LastNormalPage or "Aim"
			if target=="Settings" or not self.PageSelectors[target] then target="Aim" end
			self:SelectPage(target,true)
		end
	end
end

function UI:SelectPage(id,force)
	local selectFn=self.PageSelectors and self.PageSelectors[id]
	if not selectFn then return false end
	if id~="Settings" and self.SettingsMode then self:SetSettingsMode(false,true) end
	return selectFn(force==true)==true
end

