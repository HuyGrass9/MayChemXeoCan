	local p=Open.AbsolutePosition

	Open.Position=UDim2.fromOffset(
		math.clamp(p.X,4,math.max(4,v.X-s.X-4)),
		math.clamp(p.Y,4,math.max(4,v.Y-s.Y-4))
	)
end

local FirstFit=true

function SS.Fit()
	if Destroyed then return end
	local v=SS.VP()

	local baseW=math.clamp(v.X-18,340,580)
	if v.X>1100 then baseW=math.clamp(v.X*.58,620,760)
	elseif v.X>720 then baseW=math.clamp(v.X*.60,520,680) end
	local baseH=math.clamp(math.floor(v.Y*.68),330,560)
	local widthScale=math.clamp((State.MenuWidth or State.MenuSize or 100)/100,.70,1.50)
	local heightScale=math.clamp((State.MenuHeight or State.MenuSize or 100)/100,.70,1.50)

	local maxW=math.max(300,v.X-34)
	local maxH=math.max(280,v.Y-34)
	local w=math.clamp(math.floor(baseW*widthScale+.5),300,maxW)
	local h=math.clamp(math.floor(baseH*heightScale+.5),280,maxH)

	Main.Size=UDim2.fromOffset(w,h)
	Shadow.Size=UDim2.fromOffset(w+10,h+12)

	if FirstFit then
		local x=math.floor((v.X-w)/2)
		local y=math.floor((v.Y-h)/2)
		Main.Position=UDim2.fromOffset(x,y)
		Shadow.Position=UDim2.fromOffset(x+5,y+7)
		FirstFit=false
	else
		task.defer(SS.ClampMain)
	end

	task.defer(SS.ClampOpen)
	task.defer(SS.SyncAllMacros)
end
