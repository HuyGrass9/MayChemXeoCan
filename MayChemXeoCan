	warn(report)
	pcall(function()
		local env=_G
		if type(getgenv)=="function" then
			local ok,v=pcall(getgenv)
			if ok and type(v)=="table" then env=v end
		end
		env.ShiftSyncBootStage=__ShiftSyncBootStage
		env.ShiftSyncBootError=report
	end)

	if type(writefile)=="function" then
		pcall(writefile,"ShiftSync_BootError.txt",report)
	end

	if __ShiftSyncShowStartupErrors then
	pcall(function()
		local players=game:GetService("Players")
