function SS.CanHostScreenGui(parent)
	if typeof(parent)~="Instance" then return false end
	local probe=Instance.new("ScreenGui")
	probe.Name="ShiftSyncParentProbe"
	probe.ResetOnSpawn=false
	local ok=pcall(function() probe.Parent=parent end)
	pcall(function() probe:Destroy() end)
	return ok
end

function SS.GetParent()
	if type(gethui)=="function" then
		local ok,v=pcall(gethui)
		if ok and SS.CanHostScreenGui(v) then return v,"gethui" end
	end

	local okCore,core=pcall(function() return game:GetService("CoreGui") end)
	if okCore and SS.CanHostScreenGui(core) then return core,"CoreGui" end

	local pg=LP:FindFirstChildOfClass("PlayerGui") or LP:WaitForChild("PlayerGui",10)
	if pg and SS.CanHostScreenGui(pg) then return pg,"PlayerGui" end
	error("[ShiftSync Boot] no compatible GUI parent")
end

function SS.CleanupStaleUIEverywhere()
	local candidates={}
	local seen={}
	local function add(parent)
		if typeof(parent)=="Instance" and not seen[parent] then
			seen[parent]=true
			candidates[#candidates+1]=parent
		end
	end
	if type(gethui)=="function" then
		local ok,v=pcall(gethui)
		if ok then add(v) end
	end
	local okCore,core=pcall(function() return game:GetService("CoreGui") end)
	if okCore then add(core) end
	add(LP:FindFirstChildOfClass("PlayerGui"))

	local names={
		ShiftSyncUI=true,
		ShiftSyncIconLayer=true,
		ShiftSyncQuickTweenLayer=true,
		ShiftSyncMacroLayer=true,
		ShiftSyncFOVLayer=true
	}
	for _,parent in ipairs(candidates) do
		pcall(function()
			for _,child in ipairs(parent:GetChildren()) do
				if names[child.Name] then child:Destroy() end
			end
		end)
	end
	pcall(function()
		for _,child in ipairs(Lighting:GetChildren()) do
			if child.Name=="ShiftSyncLiquidGlassBlur" then child:Destroy() end
		end
	end)
end

