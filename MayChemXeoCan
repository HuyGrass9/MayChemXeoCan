function SS.RebuildAccentPalette(hue,saturation,brightness)
	hue=math.clamp(tonumber(hue) or 270,0,360)
	local h=(hue%360)/360
	local sat=math.clamp((tonumber(saturation) or 100)/100,.45,1.55)
	local val=math.clamp((tonumber(brightness) or 100)/100,.65,1.25)
	C.P=Color3.fromHSV(h,math.clamp(.32*sat,.08,.70),math.clamp(.72*val,.42,.98))
	C.P2=Color3.fromHSV(h,math.clamp(.22*sat,.05,.55),math.clamp(.84*val,.50,1))
	C.PSoft=Color3.fromHSV(h,math.clamp(.10*sat,.02,.30),math.clamp(.94*val,.62,1))
	C.PText=Color3.fromHSV(h,math.clamp(.38*sat,.10,.78),math.clamp(.42*val,.28,.82))
	return hue
end

function SS.RebuildSurfacePalette(hue,tint,brightness)
	hue=math.clamp(tonumber(hue) or 270,0,360)
	local h=(hue%360)/360
	local t=math.clamp((tonumber(tint) or 18)/100,0,.60)
	local b=math.clamp((tonumber(brightness) or 100)/100,.70,1.25)
	local function surface(sat,value)
		return Color3.fromHSV(h,math.clamp(sat*t,0,.34),math.clamp(value*b,.34,1))
	end
	C.BG=surface(.42,.93)
	C.Card=surface(.30,.97)
	C.Card2=surface(.46,.90)
	C.Glass=surface(.38,.94)
	C.GlassStrong=surface(.52,.86)
	C.GlassSoft=surface(.22,.985)
	C.Border=surface(.34,.88)
	return hue
end

