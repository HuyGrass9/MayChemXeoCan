	})

	SS.Round(btn,14)
	SS.Stroke(btn,.25)

	local iconScale=SS.New("UIScale",{Scale=1,Parent=btn})

	self.Button=btn

	local dragging=false
	local moved=false
	local activeInput=nil
	local startPos=nil
	local startButton=nil

	SS.Keep(btn.InputBegan:Connect(function(input)
		if dragging then return end
		if input.UserInputType~=Enum.UserInputType.Touch
		and input.UserInputType~=Enum.UserInputType.MouseButton1 then
			return
		end
		dragging=true
		moved=false
		activeInput=input
		startPos=input.Position
		startButton=btn.Position
		Tween(iconScale,{Scale=.9},.08)
	end))

	SS.Keep(UIS.InputChanged:Connect(function(input)
		if not dragging or not activeInput then return end
		local valid=false
		if activeInput.UserInputType==Enum.UserInputType.Touch then
			valid=input==activeInput
		else
			valid=input.UserInputType==Enum.UserInputType.MouseMovement
		end
		if not valid then return end

		local delta=input.Position-startPos
		if delta.Magnitude>6 then
			moved=true
		end

		local cam=workspace.CurrentCamera
		local viewport=cam and cam.ViewportSize or Vector2.new(800,600)
		btn.Position=UDim2.fromOffset(
			math.clamp(startButton.X.Offset+delta.X,4,viewport.X-self.Size-4),
			math.clamp(startButton.Y.Offset+delta.Y,4,viewport.Y-self.Size-4)
		)
	end))

	SS.Keep(UIS.InputEnded:Connect(function(input)
		if not dragging or not activeInput then return end
		local ended=input==activeInput
		if activeInput.UserInputType==Enum.UserInputType.MouseButton1 then
			ended=input.UserInputType==Enum.UserInputType.MouseButton1
		end
		if not ended then return end

		dragging=false
		activeInput=nil
		Tween(iconScale,{Scale=1},.12)
		if not moved and UI and UI.SetVisible then
			UI:SetVisible(not UI.Visible)
		end
	end))

	return btn
end

