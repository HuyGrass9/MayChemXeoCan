function SS.WriteShiftSyncConfig()
	if type(writefile)~="function" then return false end
	local ok,encoded=pcall(function()
		return HttpService:JSONEncode(SS.BuildShiftSyncConfig())
	end)
	if not ok or not encoded then return false end
	local wrote=pcall(writefile,ShiftSyncConfigFile,encoded)
	if wrote then ConfigDirty=false end
	return wrote
end

function SS.SaveShiftSyncConfig(immediate)
	if type(writefile)~="function" then return end
	ConfigDirty=true
	ConfigSaveSerial+=1
	local serial=ConfigSaveSerial
	if immediate then
		SS.WriteShiftSyncConfig()
		return
	end
	task.delay(.22,function()
		if Destroyed or serial~=ConfigSaveSerial or not ConfigDirty then return end
		SS.WriteShiftSyncConfig()
	end)
end

function SS.FlushShiftSyncConfig()
	if not ConfigDirty then return end
	ConfigSaveSerial+=1
	SS.WriteShiftSyncConfig()
end

function SS.LoadShiftSyncConfig()
	if type(readfile)~="function" or type(isfile)~="function" then return end
	local existsOk,exists=pcall(isfile,ShiftSyncConfigFile)
	if not existsOk or not exists then return end
	pcall(function()
		local d=HttpService:JSONDecode(readfile(ShiftSyncConfigFile))
		if type(d)~="table" then return end
		local loadedVersion=tonumber(d.Version) or 0
		if d.ESP~=nil then State.ESP=d.ESP==true end
		if d.Tracer~=nil then State.Tracer=d.Tracer==true end
		State.VisualRange=math.clamp(tonumber(d.VisualRange) or State.VisualRange,100,5000)
		if d.HP~=nil then State.HP=d.HP==true end
		if d.FOVEnabled~=nil then State.FOVEnabled=d.FOVEnabled==true end
		State.FOVRadius=math.clamp(tonumber(d.FOVRadius) or State.FOVRadius,40,500)
		State.FOVOpacity=math.clamp(tonumber(d.FOVOpacity) or State.FOVOpacity,5,90)
		if d.FOVHighlight~=nil then State.FOVHighlight=d.FOVHighlight==true end
		if d.NPCAim~=nil then State.NPCAim=d.NPCAim==true end
		do
			local targetType=tostring(d.AimTargetType or State.AimTargetType)
			if targetType=="NPC" or targetType=="Auto" then targetType="Workspace" end
			if targetType~="Player" and targetType~="Workspace" then targetType="Workspace" end
			State.AimTargetType=targetType
		end
		State.SelectedNPCTargets=SS.CopyStringList(d.SelectedNPCTargets)
		if d.WorkspaceAimAutoRefresh~=nil then State.WorkspaceAimAutoRefresh=d.WorkspaceAimAutoRefresh==true else State.WorkspaceAimAutoRefresh=true end
		if d.WorkspaceAimHitboxStrict~=nil then State.WorkspaceAimHitboxStrict=d.WorkspaceAimHitboxStrict==true else State.WorkspaceAimHitboxStrict=true end
		State.NPCAimRange=math.clamp(tonumber(d.NPCAimRange) or State.NPCAimRange,50,3000)
		if d.NPCAimPart=="Torso" then
			State.NPCAimPart="Torso"
		else
			State.NPCAimPart="Head"
		end
		if d.IgnoreAllies~=nil then
			State.IgnoreAllies=d.IgnoreAllies==true
		else
			local npcOld=d.NPCAllyCheck~=false
			local teamOld=d.PlayerTeamCheck~=false
			State.IgnoreAllies=npcOld and teamOld
		end
		if d.NPCWallCheck~=nil then State.NPCWallCheck=d.NPCWallCheck==true end
		if d.NPCPrediction~=nil then State.NPCPrediction=d.NPCPrediction==true end
		if d.AimOnlyWithTool~=nil then State.AimOnlyWithTool=d.AimOnlyWithTool==true end
		if d.Speed~=nil then State.Speed=d.Speed==true end
		State.SpeedValue=math.clamp(tonumber(d.SpeedValue) or State.SpeedValue,16,500)
		if d.Jump~=nil then State.Jump=d.Jump==true end
		State.JumpValue=math.clamp(tonumber(d.JumpValue) or State.JumpValue,50,500)
		State.ForwardDistance=math.clamp(tonumber(d.ForwardDistance) or State.ForwardDistance,25,1000)
		State.TweenSpeed=math.clamp(tonumber(d.TweenSpeed) or State.TweenSpeed,10,120)
		State.TweenWorkspaceOffsetY=math.clamp(tonumber(d.TweenWorkspaceOffsetY) or State.TweenWorkspaceOffsetY,-20,40)
		State.TweenWorkspaceStopDistance=math.clamp(tonumber(d.TweenWorkspaceStopDistance) or State.TweenWorkspaceStopDistance,0,20)
		if d.TweenWorkspaceFaceTarget~=nil then State.TweenWorkspaceFaceTarget=d.TweenWorkspaceFaceTarget==true end
		if d.TweenWorkspaceStaticOnly~=nil then State.TweenWorkspaceStaticOnly=d.TweenWorkspaceStaticOnly==true else State.TweenWorkspaceStaticOnly=true end
		if loadedVersion<65 then
			State.TweenSpeed=math.min(State.TweenSpeed,45)
		end
		State.FollowDistance=math.clamp(tonumber(d.FollowDistance) or State.FollowDistance,2,12)
		State.MenuSize=math.clamp(tonumber(d.MenuSize) or State.MenuSize,70,140)
		State.MenuWidth=math.clamp(tonumber(d.MenuWidth) or State.MenuSize or 100,70,150)
		State.MenuHeight=math.clamp(tonumber(d.MenuHeight) or State.MenuSize or 100,70,150)
		State.MenuTransparency=math.clamp(tonumber(d.MenuTransparency) or State.MenuTransparency,8,30)
		State.MenuBlur=math.clamp(tonumber(d.MenuBlur) or State.MenuBlur,0,20)
		State.TabTextSize=math.clamp(tonumber(d.TabTextSize) or State.TabTextSize,8,14)
		State.ThemeHue=math.clamp(tonumber(d.ThemeHue) or State.ThemeHue,0,360)
		State.ThemeSaturation=math.clamp(tonumber(d.ThemeSaturation) or State.ThemeSaturation,45,155)
		State.ThemeBrightness=math.clamp(tonumber(d.ThemeBrightness) or State.ThemeBrightness,65,125)
		State.SurfaceHue=math.clamp(tonumber(d.SurfaceHue) or State.SurfaceHue,0,360)
		State.SurfaceTint=math.clamp(tonumber(d.SurfaceTint) or State.SurfaceTint,0,60)
		State.SurfaceBrightness=math.clamp(tonumber(d.SurfaceBrightness) or State.SurfaceBrightness,70,125)
		do
			local cp=tostring(d.ColorPreset or "")
			if cp=="Lavender" or cp=="Blue" or cp=="Rose" or cp=="Graphite" then
				State.ColorPreset=cp
			else
				local h=State.ThemeHue
				if h>=195 and h<245 then State.ColorPreset="Blue"
				elseif h>=315 or h<20 then State.ColorPreset="Rose"
				elseif State.ThemeSaturation<70 then State.ColorPreset="Graphite"
				else State.ColorPreset="Lavender" end
			end
			local gp=tostring(d.GlassPreset or "")
			if gp=="Clear" or gp=="Balanced" or gp=="Dense" then State.GlassPreset=gp
			elseif State.MenuTransparency>=30 then State.GlassPreset="Clear"
			elseif State.MenuTransparency<=19 then State.GlassPreset="Dense"
			else State.GlassPreset="Balanced" end
		end
		State.ESPScale=math.clamp(tonumber(d.ESPScale) or 60,40,135)
		State.UIAnimation=math.clamp(tonumber(d.UIAnimation) or State.UIAnimation,70,140)
		State.UIRoundness=math.clamp(tonumber(d.UIRoundness) or State.UIRoundness,65,145)
		if d.ShowStartupErrors~=nil then State.ShowStartupErrors=d.ShowStartupErrors==true end
		if d.FixLag~=nil then State.FixLag=d.FixLag==true end
		State.Language=(tostring(d.Language or "ENG"):upper()=="VIE") and "VIE" or "ENG"
		State.FunctionStudio={}
		if type(d.FunctionStudio)=="table" then
			local used={}
			for index,entry in ipairs(d.FunctionStudio) do
				if type(entry)=="table" and #State.FunctionStudio<18 then
					local id=math.max(1,math.floor(tonumber(entry.Id) or index))
					while used[id] do id+=1 end
					used[id]=true
					local minValue=math.floor(math.clamp(tonumber(entry.Min) or 0,-10000,9999)+.5)
					local maxValue=math.floor(math.clamp(tonumber(entry.Max) or 100,-9999,10000)+.5)
					if maxValue<=minValue then maxValue=math.min(10000,minValue+1) end
					State.FunctionStudio[#State.FunctionStudio+1]={
						Id=id,
						TabName=tostring(entry.TabName or "Game"):sub(1,18),
						Name=tostring(entry.Name or ("Function "..tostring(id))):sub(1,40),
						ControlType=(entry.ControlType=="Toggle" or entry.ControlType=="Button" or entry.ControlType=="TextBox") and entry.ControlType or "Slider",
						Min=minValue,
						Max=maxValue,
						Value=math.clamp(tonumber(entry.Value) or 50,minValue,maxValue),
						TextValue=tostring(entry.TextValue or ""):sub(1,500),
						Code=tostring(entry.Code or ""):sub(1,12000),
						Enabled=entry.Enabled==true
					}
				end
			end
		end
		if d.MacroSelected=="Forward" or d.MacroSelected=="Back" or d.MacroSelected=="Follow" or d.MacroSelected=="Next" then State.MacroSelected=d.MacroSelected end
		local loadedMacros=type(d.Macros)=="table" and d.Macros or nil
		for id,m in pairs(State.Macros) do
			local src=loadedMacros and loadedMacros[id] or nil
			if type(src)=="table" then
				if src.Visible~=nil then m.Visible=src.Visible==true end
				m.X=tonumber(src.X) or m.X
				m.Y=tonumber(src.Y) or m.Y
				m.Size=math.clamp(tonumber(src.Size) or m.Size,36,88)
				m.Transparency=math.clamp(tonumber(src.Transparency) or m.Transparency,0,.9)
			end
		end
		if not loadedMacros then
			local oldSize=math.clamp(tonumber(d.QuickTweenSize) or 48,36,88)
			local oldTransparency=math.clamp(tonumber(d.QuickTweenTransparency) or 0,0,.9)
			local oldX=tonumber(d.QuickTweenX) or 8
			local oldY=tonumber(d.QuickTweenY) or 220
			State.Macros.Forward.Visible=d.ShowTweenForwardButton~=false
			State.Macros.Back.Visible=d.ShowTweenBackButton~=false
			State.Macros.Follow.Visible=d.ShowFollowButton==true
			State.Macros.Next.Visible=State.Macros.Follow.Visible
			for index,id in ipairs({"Forward","Back","Follow","Next"}) do
				local m=State.Macros[id]
				m.Size=oldSize
				m.Transparency=oldTransparency
				m.X=oldX+(index-1)*(oldSize+8)
				m.Y=oldY
			end
