function SS.ReadProjectileSpeedFromObject(obj)
	for name,value in pairs(obj:GetAttributes()) do
		if ProjectileSpeedNames[SS.NormalizeKey(name)] then
			local number=tonumber(value)
			if number and number>=40 and number<=8000 then
				return number
			end
		end
	end

	if obj:IsA("NumberValue") or obj:IsA("IntValue") then
		if ProjectileSpeedNames[SS.NormalizeKey(obj.Name)] then
			local number=tonumber(obj.Value)
			if number and number>=40 and number<=8000 then
				return number
			end
		end
	end

	return nil
end

