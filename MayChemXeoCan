SS.LocaleReverse={}
for vi,en in pairs(SS.LocaleExact) do SS.LocaleReverse[en]=vi end
SS.LocaleRefs=setmetatable({}, {__mode="k"})
SS.DynamicLocaleRefs=setmetatable({}, {__mode="k"})
function SS.LocaleCanonical(text)
	text=tostring(text or "")
	return SS.LocaleReverse[text] or text
end
function SS.IsLocalizableText(text)
	text=tostring(text or "")
	return SS.LocaleExact[text]~=nil or SS.LocaleReverse[text]~=nil
end
function SS.LocalizeText(text)
	local canonical=SS.LocaleCanonical(text)
	if State.Language=="VIE" then return canonical end
	return SS.LocaleExact[canonical] or canonical
end
function SS.LocalizeDynamic(text)
	local value=SS.LocalizeText(text)
	if State.Language=="VIE" then return value end
	local replacements={
		{"đã chọn","selected"},{"chưa chọn","not selected"},{"mục tiêu","targets"},{"vật thể tĩnh","static object"},
		{"vật thể động","dynamic object"},{"siêu mạnh","ultra"},{"giảm tải","reduced load"},{"nền nhẹ","light background"}
	}
	for _,pair in ipairs(replacements) do value=value:gsub(pair[1],pair[2]) end
	return value
end
function SS.RegisterLocalized(instance,property,source)
	if typeof(instance)~="Instance" or type(property)~="string" then return end
	local canonical=SS.LocaleCanonical(source)
	if not SS.LocaleExact[canonical] then return end
	local refs=SS.LocaleRefs[instance]
	if not refs then refs={}; SS.LocaleRefs[instance]=refs end
	refs[property]=canonical
	pcall(function() instance[property]=SS.LocalizeText(canonical) end)
end
function SS.SetLocalizedText(instance,text,property,dynamic)
	if typeof(instance)~="Instance" then return end
	property=property or "Text"
	local source=tostring(text or "")
	if SS.IsLocalizableText(source) then
		local drefs=SS.DynamicLocaleRefs[instance]
		if drefs then drefs[property]=nil end
		SS.RegisterLocalized(instance,property,source)
	else
		local refs=SS.LocaleRefs[instance]
		if refs then refs[property]=nil end
		if dynamic then
			local drefs=SS.DynamicLocaleRefs[instance]
			if not drefs then drefs={}; SS.DynamicLocaleRefs[instance]=drefs end
			drefs[property]=source
		else
			local drefs=SS.DynamicLocaleRefs[instance]
			if drefs then drefs[property]=nil end
		end
		pcall(function() instance[property]=(dynamic and SS.LocalizeDynamic(source) or source) end)
	end
end
function SS.RefreshLanguage()
	for instance,props in pairs(SS.LocaleRefs) do
		if instance and instance.Parent then
			for property,canonical in pairs(props) do
				pcall(function() instance[property]=SS.LocalizeText(canonical) end)
			end
		end
	end
	for instance,props in pairs(SS.DynamicLocaleRefs) do
		if instance and instance.Parent then
			for property,source in pairs(props) do
				pcall(function() instance[property]=SS.LocalizeDynamic(source) end)
			end
		end
	end
	if SS.LanguageButton and SS.LanguageButton.Parent then SS.LanguageButton.Text=State.Language end
end

