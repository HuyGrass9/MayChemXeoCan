function SS.Safe(fn,...)
	if not fn then return end
	local args={...}
	task.spawn(function()
		local ok,err=pcall(function()
			fn(table.unpack(args))
		end)
		if not ok then
			warn("[ShiftSync] "..tostring(err))
		end
	end)
end

function SS.CallSafe(fn,...)
	if not fn then return true end
	local ok,err=pcall(fn,...)
	if not ok then warn("[ShiftSync] "..tostring(err)) end
	return ok
end

local PropertyWarnings={}
function SS.New(class,props)
	local ok,o=pcall(Instance.new,class)
	if not ok or not o then
		error("[ShiftSync UI] cannot create "..tostring(class)..": "..tostring(o))
	end

	local parent=props and props.Parent or nil
	local localeSources={}
	for k,v in pairs(props or {}) do
		if k~="Parent" then
			local applied=v
			if type(v)=="string" and (k=="Text" or k=="PlaceholderText") and SS.LocalizeText and SS.IsLocalizableText and SS.IsLocalizableText(v) then
				localeSources[k]=v
				applied=SS.LocalizeText(v)
			end
			local setOk,setErr=pcall(function() o[k]=applied end)
			if not setOk then
				PropertyWarnings[#PropertyWarnings+1]=tostring(class).."."..tostring(k)..": "..tostring(setErr)
			end
		end
	end
	if parent~=nil then
		local parentOk,parentErr=pcall(function() o.Parent=parent end)
		if not parentOk then
			pcall(function() o:Destroy() end)
			error("[ShiftSync UI] cannot parent "..tostring(class)..": "..tostring(parentErr))
		end
	end
	if SS.RegisterLocalized then
		for property,source in pairs(localeSources) do SS.RegisterLocalized(o,property,source) end
	end
	return o
end

