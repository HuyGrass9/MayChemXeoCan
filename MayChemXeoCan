local RuntimeSupervisorElapsed=0
SS.RuntimeAimMisses=0
SS.RuntimeVisualMisses=0
SS.Keep(RS.Heartbeat:Connect(function(dt)
	if Destroyed then return end
	PerformanceController:Tick(dt)
	RuntimeSupervisorElapsed+=dt
	if RuntimeSupervisorElapsed<.70 then return end
	RuntimeSupervisorElapsed=0

	local now=os.clock()
	if GlassBlur and UI and UI.Visible then
		local target=(State.FixLag or PerformanceController.LowFPS) and 0 or math.clamp(State.MenuBlur or 7,0,13)
		if math.abs((GlassBlur.Size or 0)-target)>.5 then pcall(function() GlassBlur.Size=target end) end
	end
	if SS.PerformanceStatusCard and SS.PerformanceStatusCard.Set then
		local level=PerformanceController.AutoLevel or 0
		local mode=level>=2 and "siêu mạnh" or (level==1 and "giảm tải" or "nền nhẹ")
		SS.PerformanceStatusCard.Set(SS.LocalizeText(State.FixLag and "Fix lag: BẬT" or "Fix lag: TẮT"),string.format("FPS %.0f • %s",PerformanceController.FPS,SS.LocalizeText(mode)))
	end
	local needAim=State.NPCAim or State.FOVEnabled
	local aimAlive=FOVController.Connection and FOVController:IsAlive(1.80)
	if needAim then
		if not FOVController.Connection then
			SS.RuntimeAimMisses=0
			FOVController:Start(false)
		elseif not aimAlive then
			SS.RuntimeAimMisses=(SS.RuntimeAimMisses or 0)+1
			if SS.RuntimeAimMisses>=3 then
				SS.RuntimeAimMisses=0
				FOVController:Start(true)
			end
		else
			SS.RuntimeAimMisses=0
		end
	elseif FOVController.Connection then
		SS.RuntimeAimMisses=0
		FOVController:Stop()
	end

	local needVisual=State.ESP or State.Tracer or State.HP
	local visualAlive=VisualConn and (now-(VisualLastFrameClock or 0)<1.80)
	if needVisual then
		if not VisualConn then
			SS.RuntimeVisualMisses=0
			SS.StartVisualLoop(false)
		elseif not visualAlive then
			SS.RuntimeVisualMisses=(SS.RuntimeVisualMisses or 0)+1
			if SS.RuntimeVisualMisses>=3 then
				SS.RuntimeVisualMisses=0
				pcall(function() VisualConn:Disconnect() end)
				VisualConn=nil
				SS.StartVisualLoop(false)
			end
		else
			SS.RuntimeVisualMisses=0
		end
	elseif VisualConn then
		SS.RuntimeVisualMisses=0
		SS.StopVisualIfUnused()
	end

end))


function UI:Destroy()
	if Destroyed then return end
	SS.FlushShiftSyncConfig()
	PerformanceController:RestoreCullAll()
	PerformanceController:SetEnabled(false,true)
	Destroyed=true

	if Input.Owner then
		local finish=Input.Finish
		Input.Owner=nil
		Input.Source=nil
		Input.Move=nil
		Input.Finish=nil
		if finish then pcall(finish) end
	end

	State.ESP=false
	State.Tracer=false
	State.HP=false
	State.NPCAim=false
	State.FOVEnabled=false


	SS.StopVisualIfUnused()
	SS.StopHP()
	BallisticsController:Stop()
	FOVController:Stop()
	FollowController:Stop()

	State.Speed=false
	State.Jump=false
	SS.ApplyMovement()

	for _,fn in ipairs(Cleanups)do
		pcall(fn)
	end
	table.clear(Cleanups)

	for _,c in ipairs(Connections)do
		pcall(function()c:Disconnect()end)
	end
	table.clear(Connections)

	if CameraConnection then
		pcall(function()CameraConnection:Disconnect()end)
		CameraConnection=nil
	end

	if GUI then
		GUI:Destroy()
	end
	if IconLayer then
		IconLayer:Destroy()
	end
	if MacroLayer then
		MacroLayer:Destroy()
	end
	if FOVLayer then
		FOVLayer:Destroy()
	end
	if GlassBlur then
		pcall(function() GlassBlur:Destroy() end)
	end

	if ENV.ShiftSyncUI==UI then
		ENV.ShiftSyncUI=nil
		ENV.ShiftSyncRuntimeCleanup=nil
	end
end

