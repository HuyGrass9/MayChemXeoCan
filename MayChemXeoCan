function SS.FormatCustomError(err)
	local message=tostring(err or "Lỗi không xác định")
	local line=tonumber(message:match(":(%d+):"))
	if line then
		line=math.max(1,line-1)
		message=message:gsub(":%d+:",":"..tostring(line)..":",1)
	end
	message=message:gsub("%[string [^%]]+%]","custom")
	return message:sub(1,260),line
end

function SS.ValidateCustomSource(source,id)
	source=tostring(source or "")
	if source:gsub("%s+","")=="" then return true,nil,nil,nil end
	local compact=string.lower(source)
	if compact:match("while%s+true%s+do") and not compact:match("task%.wait%s*%(") and not compact:match("[^%w]wait%s*%(") then
		return false,"Vòng lặp while true cần task.wait() để tránh treo game",nil,nil
	end
	if type(loadstring)~="function" then return false,"Executor không hỗ trợ loadstring",nil,nil end
	local wrapped="return function(ctx)\n"..source.."\nend"
	local okCompile,chunk,compileErr=pcall(loadstring,wrapped)
	if not okCompile or type(chunk)~="function" then
		local text,line=SS.FormatCustomError(compileErr or chunk)
		return false,text,line,nil
	end
	local okBuild,fn=pcall(chunk)
	if not okBuild or type(fn)~="function" then
		local text,line=SS.FormatCustomError(fn)
		return false,text,line,nil
	end
	return true,nil,nil,fn
end

function SS.CustomExample(controlType)
