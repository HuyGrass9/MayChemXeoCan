local function __ShiftSyncTrace(err)
	local message=tostring(err)
	local ok,tb=pcall(function()
		return debug.traceback(message,2)
	end)
	return ok and tb or message
end

local __ShiftSyncBootOK,__ShiftSyncBootError=xpcall(__ShiftSyncMain,__ShiftSyncTrace)
