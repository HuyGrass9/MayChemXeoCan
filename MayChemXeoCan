function BallisticsController:GetProfile(tool)
	if not tool then return nil end
	local key=tostring(game.PlaceId).."|"..tostring(tool.Name)
	local profile=self.Profiles[key]
	if not profile then
		profile={LearnedSpeed=nil,Samples=0,Confidence=0,LastEstimate=nil,Latency=0,SampleBuffer={}}
		self.Profiles[key]=profile
	else
		profile.Latency=math.clamp(tonumber(profile.Latency) or 0,0,.35)
		if type(profile.SampleBuffer)~="table" then profile.SampleBuffer={} end
	end
	return profile
end

function BallisticsController:GetShotOrigin(tool)
	if not tool then
		local root=SS.GetRoot()
		return root and root.Position or nil
	end

	local cached=self.OriginCache[tool]
	if cached and cached.Parent then
		return cached:IsA("Attachment") and cached.WorldPosition or cached.Position
	end

	local best=nil
	for _,obj in ipairs(tool:GetDescendants()) do
		if obj:IsA("Attachment") or obj:IsA("BasePart") then
			local n=SS.NormalizeKey(obj.Name)
			if n:find("muzzle",1,true)
				or n:find("firepoint",1,true)
				or n:find("shootpoint",1,true)
				or n:find("bulletspawn",1,true)
				or n:find("barrel",1,true)
				or n=="tip"
			then
				best=obj
				break
			end
		end
	end
	if not best then best=tool:FindFirstChild("Handle") end
	if best and (best:IsA("Attachment") or best:IsA("BasePart")) then
		self.OriginCache[tool]=best
		return best:IsA("Attachment") and best.WorldPosition or best.Position
	end

	local root=SS.GetRoot()
	return root and root.Position or nil
end

function BallisticsController:GetMetadataSpeed(tool)
	if not tool then return nil end
	local now=os.clock()
	local cached=self.MetadataCache[tool]
	if cached and now-cached.Time<.6 then
		return cached.Speed
	end

	local speed=SS.ReadProjectileSpeedFromObject(tool)
	if not speed then
		for _,obj in ipairs(tool:GetDescendants()) do
			speed=SS.ReadProjectileSpeedFromObject(obj)
			if speed then break end
		end
	end

	if speed then speed=math.clamp(speed,40,8000) end
	self.MetadataCache[tool]={Time=now,Speed=speed}
	return speed
end

function BallisticsController:GetEffectiveSpeed(tool)
	tool=tool or self.Tool or SS.GetEquippedToolObject()
	local metadata=self:GetMetadataSpeed(tool)
	local profile=self:GetProfile(tool)
	local learned=profile and profile.LearnedSpeed or nil
	local samples=profile and profile.Samples or 0
	local confidence=profile and profile.Confidence or 0
	local speed,source

	if metadata then
		speed=metadata
		source="Tool"
	elseif learned and samples>=4 and confidence>=.42 then
		speed=learned
		source="Auto"
	elseif learned and samples>=4 then
		speed=learned*.55+300*.45
		source="Learning"
	else
		speed=300
		source="Fallback"
	end

	speed=math.clamp(tonumber(speed) or 300,40,8000)
	self.Stats.LastSpeed=speed
	self.Stats.LastSource=source
	return speed,source,confidence
end
function BallisticsController:PurgePending(now)
	now=now or os.clock()
	for i=#self.PendingShots,1,-1 do
		if now-self.PendingShots[i].Time>3.5 then
			table.remove(self.PendingShots,i)
		end
	end
	while #self.PendingShots>20 do table.remove(self.PendingShots,1) end

	local active={}
	for _,shot in ipairs(self.PendingShots) do
		if shot.Humanoid then active[shot.Humanoid]=true end
	end
	if self.UnwatchHumanoid then
		local stale={}
		for hum in pairs(self.Watched) do
			if not active[hum] then stale[#stale+1]=hum end
		end
		for _,hum in ipairs(stale) do self:UnwatchHumanoid(hum) end
	end
end
function SS.Median(values)
	if #values==0 then return 0 end
	table.sort(values)
	local mid=math.floor((#values+1)/2)
	if #values%2==1 then return values[mid] end
	return (values[mid]+values[mid+1])*.5
end

function SS.FitBallisticSamples(samples)
	if type(samples)~="table" or #samples<4 then return nil,nil,0 end
	local function fit(list)
		local n=#list
		if n<4 then return nil,nil end
		local sumD,sumT=0,0
		for _,v in ipairs(list) do
			sumD+=v.D
			sumT+=v.T
		end
		local meanD,meanT=sumD/n,sumT/n
		local varD,cov=0,0
		for _,v in ipairs(list) do
			local dd=v.D-meanD
			varD+=dd*dd
			cov+=dd*(v.T-meanT)
		end
		if varD<900 then return nil,nil end
		local slope=cov/varD
		if slope<=0 then return nil,nil end
		local speed=1/slope
		local latency=meanT-meanD/speed
		if speed<40 or speed>8000 or latency<-.05 or latency>.45 then return nil,nil end
		return speed,math.clamp(latency,0,.35)
	end

	local speed,latency=fit(samples)
	if not speed then return nil,nil,0 end
	local residuals={}
	for _,v in ipairs(samples) do
		residuals[#residuals+1]=math.abs(v.T-(latency+v.D/speed))
	end
	local med=SS.Median(residuals)
	local threshold=math.max(.035,med*2.8)
	local inliers={}
	for _,v in ipairs(samples) do
		if math.abs(v.T-(latency+v.D/speed))<=threshold then inliers[#inliers+1]=v end
	end
	if #inliers>=4 and #inliers<#samples then
		local s2,l2=fit(inliers)
		if s2 then speed,latency=s2,l2 end
	end
	return speed,latency,#inliers
end

function BallisticsController:RefitProfile(profile)
	if not profile then return false end
	local speed,latency,inliers=SS.FitBallisticSamples(profile.SampleBuffer)
	if not speed then return false end
	local alpha=(profile.Samples or 0)<6 and .42 or .24
	if profile.LearnedSpeed then
		profile.LearnedSpeed=profile.LearnedSpeed+(speed-profile.LearnedSpeed)*alpha
	else
		profile.LearnedSpeed=speed
	end
	profile.Latency=(profile.Latency or 0)+(latency-(profile.Latency or 0))*.35
	profile.Confidence=math.clamp((inliers or 0)/8,0,1)
	return true
end

function BallisticsController:OnDamage(humanoid,damageAmount)
	if damageAmount<=0 then return end
	local now=os.clock()
	self:PurgePending(now)

	local bestIndex=nil
	local bestScore=math.huge
	local bestTolerance=nil
	for i,shot in ipairs(self.PendingShots) do
		if shot.Humanoid==humanoid and shot.Tool and shot.Tool.Parent then
			local dt=now-shot.Time
			if dt>=.012 and dt<=3.25 then
				local profile=self:GetProfile(shot.Tool)
				local latency=profile and profile.Latency or 0
				local expected=latency+shot.Distance/math.max(shot.SpeedAtShot or 300,40)
				local tolerance=math.clamp(.075+expected*.42,.11,.38)
				local score=math.abs(dt-expected)
				if score<bestScore then
					bestScore=score
					bestIndex=i
					bestTolerance=tolerance
				end
			end
		end
	end

	if not bestIndex or bestScore>(bestTolerance or .2) then
		self.Stats.Rejected+=1
		return
	end

	local shot=table.remove(self.PendingShots,bestIndex)
	local dt=math.max(now-shot.Time,.012)
	local profile=self:GetProfile(shot.Tool)
	if not profile then return end

	profile.SampleBuffer[#profile.SampleBuffer+1]={D=shot.Distance,T=dt}
	while #profile.SampleBuffer>24 do table.remove(profile.SampleBuffer,1) end
	profile.Samples=(profile.Samples or 0)+1

	local fitted=self:RefitProfile(profile)
	local latency=math.clamp(profile.Latency or 0,0,.35)
	local flightTime=math.max(dt-latency,.012)
	local estimate=math.clamp(shot.Distance/flightTime,40,8000)
	profile.LastEstimate=estimate
	if not fitted then
		profile.Confidence=math.min(profile.Confidence or 0,.38)
	end

	self.Stats.DamageMatches+=1
	self.Stats.Samples+=1
	self.Stats.LastDistance=shot.Distance
	self.Stats.LastTravelTime=dt
	self.Stats.LastEstimate=estimate
	self:PurgePending(now)
end

function BallisticsController:UnwatchHumanoid(humanoid)
	local bundle=self.Watched[humanoid]
	if not bundle then return end
	for _,conn in pairs(bundle) do
		if conn then pcall(function() conn:Disconnect() end) end
	end
	self.Watched[humanoid]=nil
end

function BallisticsController:WatchHumanoid(humanoid)
	if not humanoid or self.Watched[humanoid] then return end
	local lastHealth=humanoid.Health
	local bundle={}
	bundle.Health=humanoid.HealthChanged:Connect(function(newHealth)
		local previous=lastHealth
		lastHealth=newHealth
		if newHealth<previous then
			self:OnDamage(humanoid,previous-newHealth)
		end
	end)
	bundle.Died=humanoid.Died:Connect(function()
		task.defer(function() self:UnwatchHumanoid(humanoid) end)
	end)
	bundle.Ancestry=humanoid.AncestryChanged:Connect(function(_,parent)
		if not parent then
			task.defer(function() self:UnwatchHumanoid(humanoid) end)
		end
	end)
	self.Watched[humanoid]=bundle
end
function BallisticsController:RecordShot()
	if not State.NPCPrediction then return end
	local target=FOVController and FOVController.CachedEntry or nil
	local tool=self.Tool or SS.GetEquippedToolObject()
	if not target or not tool then return end
	if not target.Humanoid or target.Humanoid.Health<=0 or not target.Part or not target.Part.Parent then return end

	local origin=self:GetShotOrigin(tool)
	if not origin then return end
	local distance=(origin-target.Part.Position).Magnitude
	if distance<1 or distance>(State.NPCAimRange or 650)+30 then return end

	local speed=self:GetEffectiveSpeed(tool)
	self:WatchHumanoid(target.Humanoid)
	self.PendingShots[#self.PendingShots+1]={
		Time=os.clock(),
		Distance=distance,
		Humanoid=target.Humanoid,
		Tool=tool,
		SpeedAtShot=speed,
		TargetKind=target.Kind
	}
	self.Stats.Shots+=1
	self:PurgePending()
end

function BallisticsController:UpdateTool(force)
	local now=os.clock()
	if not force and now-self.LastToolCheck<.15 then return self.Tool end
	self.LastToolCheck=now
	local tool=SS.GetEquippedToolObject()
	if tool==self.Tool then return tool end

	if self.ToolActivatedConn then
		self.ToolActivatedConn:Disconnect()
		self.ToolActivatedConn=nil
	end
	self.Tool=tool
	if tool then
		self.ToolActivatedConn=tool.Activated:Connect(function()
			self:RecordShot()
		end)
	end
	return tool
end

function BallisticsController:GetStatus()
	local tool=self.Tool or SS.GetEquippedToolObject()
	local speed,source,confidence=self:GetEffectiveSpeed(tool)
	local profile=self:GetProfile(tool)
	return speed,source,confidence,profile and profile.Samples or 0,profile and profile.Latency or 0
end

function BallisticsController:Stop()
	if self.ToolActivatedConn then
		self.ToolActivatedConn:Disconnect()
		self.ToolActivatedConn=nil
	end
	self.Tool=nil
	local watched={}
	for hum in pairs(self.Watched) do watched[#watched+1]=hum end
	for _,hum in ipairs(watched) do self:UnwatchHumanoid(hum) end
	table.clear(self.PendingShots)
end

local TargetMotionCache=setmetatable({}, {__mode="k"})

function SS.ClampHorizontal(v,maxMagnitude)
	local horizontal=Vector3.new(v.X,0,v.Z)
	if horizontal.Magnitude>maxMagnitude then
		horizontal=horizontal.Unit*maxMagnitude
	end
	return horizontal
end

function SS.GetTargetMotion(part,humanoid)
	local model=part and part.Parent
	if not model then return Vector3.zero,Vector3.zero,nil,nil end
	local motionPart=model:FindFirstChild("HumanoidRootPart")
	if not motionPart or not motionPart:IsA("BasePart") then motionPart=part end

	local now=os.clock()
	local position=motionPart.Position
	local physics=motionPart.AssemblyLinearVelocity
	local grounded=humanoid and humanoid.FloorMaterial~=Enum.Material.Air
	local rec=TargetMotionCache[model]

	local function sanitize(v)
		local horizontal=SS.ClampHorizontal(v,150)
		return Vector3.new(horizontal.X,math.clamp(v.Y,-95,95),horizontal.Z)
	end

	if not rec then
		local initial=sanitize(physics)
		rec={
			Position=position,
			Time=now,
			Velocity=initial,
			RawVelocity=initial,
			RawAcceleration=Vector3.zero,
			Acceleration=Vector3.zero,
			AccelStability=0,
			VerticalVelocity=grounded and 0 or initial.Y,
			GroundY=grounded and position.Y or nil,
			GroundTime=grounded and now or nil,
			WasGrounded=grounded,
			Turn=0
		}
		TargetMotionCache[model]=rec
		return rec.Velocity,rec.Acceleration,rec,motionPart
	end

	local dt=now-rec.Time
	if dt>=1/240 then
		local measured=(position-rec.Position)/math.max(dt,1/240)
		local raw=sanitize(measured*.42+physics*.58)
		local previousRaw=rec.RawVelocity or rec.Velocity or raw

		local oldHorizontal=Vector3.new(previousRaw.X,0,previousRaw.Z)
		local newHorizontal=Vector3.new(raw.X,0,raw.Z)
		local turn=0
		if oldHorizontal.Magnitude>3 and newHorizontal.Magnitude>3 then
			local dot=math.clamp(oldHorizontal.Unit:Dot(newHorizontal.Unit),-1,1)
			turn=math.clamp((1-dot)*.5,0,1)
		end

		local rawAccel=(raw-previousRaw)/math.max(dt,1/240)
		local accelHorizontal=SS.ClampHorizontal(rawAccel,320)
		rawAccel=Vector3.new(accelHorizontal.X,0,accelHorizontal.Z)

		local prevAccel=rec.RawAcceleration or Vector3.zero
		local stability=rec.AccelStability or 0
		if rawAccel.Magnitude>8 and prevAccel.Magnitude>8 then
			local align=rawAccel.Unit:Dot(prevAccel.Unit)
			if align>.62 and turn<.16 then
				stability=math.min(1,stability+dt*5.5)
			else
				stability=math.max(0,stability-dt*9)
			end
		else
			stability=math.max(0,stability-dt*4)
		end
		if turn>.2 then stability*=.22 end

		local currentHorizontal=Vector3.new(rec.Velocity.X,0,rec.Velocity.Z)
		local gain=18+turn*42
		local alpha=1-math.exp(-gain*math.min(dt,.085))
		local filteredHorizontal=currentHorizontal:Lerp(newHorizontal,math.clamp(alpha,.12,.94))

		local state=humanoid and humanoid:GetState() or nil
		local justAirborne=rec.WasGrounded and not grounded
		local jumping=state==Enum.HumanoidStateType.Jumping
		local verticalVelocity=rec.VerticalVelocity or raw.Y
		if grounded then
			verticalVelocity=0
		elseif justAirborne or jumping or math.abs(raw.Y-verticalVelocity)>24 then
			verticalVelocity=raw.Y
		else
			local vAlpha=1-math.exp(-30*math.min(dt,.085))
			verticalVelocity=verticalVelocity+(raw.Y-verticalVelocity)*math.clamp(vAlpha,.22,.9)
		end

		local accelAlpha=1-math.exp(-12*math.min(dt,.085))
		rec.Acceleration=rec.Acceleration:Lerp(rawAccel,math.clamp(accelAlpha,.08,.65))
		rec.AccelStability=stability
		rec.RawAcceleration=rawAccel
		rec.RawVelocity=raw
		rec.VerticalVelocity=verticalVelocity
		rec.Velocity=Vector3.new(filteredHorizontal.X,verticalVelocity,filteredHorizontal.Z)
		rec.Turn=math.max(turn,(rec.Turn or 0)*math.exp(-dt*9))

		if grounded then
			rec.GroundY=position.Y
			rec.GroundTime=now
		end
		rec.WasGrounded=grounded
		rec.Position=position
		rec.Time=now
	end

	return rec.Velocity,rec.Acceleration,rec,motionPart
end
function SS.PredictTargetAtTime(part,humanoid,time,velocity,acceleration,rec,motionPart)
	local position=part.Position
	local t=math.max(time,0)
	local horizontalVelocity=Vector3.new(velocity.X,0,velocity.Z)

	local horizontalAccel=Vector3.zero
	local stability=rec and (rec.AccelStability or 0) or 0
	local turn=rec and (rec.Turn or 0) or 0
	if stability>.48 and turn<.24 then
		horizontalAccel=SS.ClampHorizontal(acceleration,180)*math.clamp(stability*.36,0,.36)
	end
	local accelTime=math.min(t,.24)
	local horizontalLead=horizontalVelocity*t+horizontalAccel*(.5*accelTime*accelTime)
	local maxHorizontalLead=math.max(6,math.min(180,horizontalVelocity.Magnitude*t*1.35+8))
	if horizontalLead.Magnitude>maxHorizontalLead then
		horizontalLead=horizontalLead.Unit*maxHorizontalLead
	end

	local verticalLead=0
	if humanoid then
		local state=humanoid:GetState()
		local airborne=humanoid.FloorMaterial==Enum.Material.Air
			or state==Enum.HumanoidStateType.Jumping
			or state==Enum.HumanoidStateType.Freefall
		if airborne then
			local verticalTime=math.min(t,.72)
			local vy=math.clamp((rec and rec.VerticalVelocity) or velocity.Y,-90,90)
			verticalLead=vy*verticalTime-.5*WS.Gravity*verticalTime*verticalTime

			if rec and rec.GroundY and rec.GroundTime and motionPart and os.clock()-rec.GroundTime<1.15 then
				local partOffset=position.Y-motionPart.Position.Y
				local floorAimY=rec.GroundY+partOffset
				verticalLead=math.max(verticalLead,floorAimY-position.Y)
			end
			verticalLead=math.clamp(verticalLead,-18,18)
		end
	end

	return position+horizontalLead+Vector3.new(0,verticalLead,0)
end
function SS.GetPredictedAimPosition(part,humanoid,distance,origin)
	local position=part.Position
	if not State.NPCPrediction then return position end

	local projectileSpeed=BallisticsController:GetEffectiveSpeed()
	origin=origin or (WS.CurrentCamera and WS.CurrentCamera.CFrame.Position) or position
	local shotOrigin=BallisticsController:GetShotOrigin(BallisticsController.Tool or SS.GetEquippedToolObject())
	if shotOrigin then origin=shotOrigin end
	local velocity,acceleration,rec,motionPart=SS.GetTargetMotion(part,humanoid)
	local baseDistance=(origin-position).Magnitude
	if baseDistance<=0 then baseDistance=tonumber(distance) or 0 end
	local maxTravel=math.clamp((State.NPCAimRange or 650)/math.max(projectileSpeed,40),.35,2.4)
	local travelTime=math.clamp(baseDistance/math.max(projectileSpeed,40),0,maxTravel)
	local predicted=position

	for _=1,3 do
		predicted=SS.PredictTargetAtTime(part,humanoid,travelTime,velocity,acceleration,rec,motionPart)
		local nextTime=math.clamp((predicted-origin).Magnitude/math.max(projectileSpeed,40),0,maxTravel)
		travelTime=travelTime*.35+nextTime*.65
	end

	return predicted
end

local LOSParams=RaycastParams.new()
LOSParams.FilterType=Enum.RaycastFilterType.Exclude
LOSParams.IgnoreWater=true
local LOSIgnore={}
local LOSCache=setmetatable({}, {__mode="k"})

function SS.GetLOSParams(extraIgnore)
	table.clear(LOSIgnore)
	local char=LP.Character
	local cam=WS.CurrentCamera
	local tool=BallisticsController.Tool or SS.GetEquippedToolObject()
	if char then LOSIgnore[#LOSIgnore+1]=char end
	if cam then LOSIgnore[#LOSIgnore+1]=cam end
	if tool and tool.Parent then LOSIgnore[#LOSIgnore+1]=tool end
	if extraIgnore then
		for _,obj in ipairs(extraIgnore) do if obj then LOSIgnore[#LOSIgnore+1]=obj end end
	end
	LOSParams.FilterDescendantsInstances=LOSIgnore
	return LOSParams
end
function SS.IsLOSVisualPassThrough(hit)
	if not hit or not hit.Parent then return true end
	if hit:IsA("BasePart") then
		if hit.Transparency>=.92 then return true end
		local accessory=hit:FindFirstAncestorOfClass("Accessory")
		if accessory then return true end
		local tool=hit:FindFirstAncestorOfClass("Tool")
		if tool then return true end
		local p=hit.Parent
		local n=string.lower(tostring((p and p.Name) or "").." "..tostring(hit.Name or ""))
		if (n:find("effect",1,true) or n:find("vfx",1,true) or n:find("particle",1,true) or n:find("debris",1,true)) and hit.Transparency>=.35 then return true end
		if (not hit.CanCollide) and hit.Transparency>=.62 and hit.Size.Magnitude<14 then return true end
	end
	return false
end
function SS.RaycastVisibilitySample(origin,targetModel,targetPosition,maxSkips)
	local delta=targetPosition-origin
	if delta.Magnitude<.08 then return true end
	local ignored={}
	maxSkips=math.clamp(tonumber(maxSkips) or 5,1,7)
	for _=1,maxSkips do
		local ok,result=pcall(function() return WS:Raycast(origin,delta,SS.GetLOSParams(ignored)) end)
		if not ok then return false end
		if not result then return true end
		local hit=result.Instance
		if hit and hit:IsDescendantOf(targetModel) then return true end
		if SS.IsLOSVisualPassThrough(hit) then
			ignored[#ignored+1]=hit
		else
			return false
		end
	end
	return false
end
function SS.CollectLOSSamples(targetModel,targetPart,expanded)
	local points={}
	local function add(part,pos)
		if not part or not part:IsA("BasePart") or not part.Parent then return end
		pos=pos or part.Position
		for _,p in ipairs(points) do if (p-pos).Magnitude<.18 then return end end
		points[#points+1]=pos
	end
	if targetPart and targetPart:IsA("BasePart") and targetPart.Parent then
		add(targetPart,targetPart.Position)
		if expanded then
			local side=math.clamp(targetPart.Size.X*.28,.18,.70)
			local up=math.clamp(targetPart.Size.Y*.20,.16,.55)
			add(targetPart,targetPart.Position+targetPart.CFrame.RightVector*side)
			add(targetPart,targetPart.Position-targetPart.CFrame.RightVector*side)
			add(targetPart,targetPart.Position+targetPart.CFrame.UpVector*up)
			add(targetPart,targetPart.Position-targetPart.CFrame.UpVector*up*.65)
		end
	else
		add(targetModel:FindFirstChild("Head",true))
		add(targetModel:FindFirstChild("UpperTorso",true) or targetModel:FindFirstChild("Torso",true) or targetModel:FindFirstChild("HumanoidRootPart",true))
	end
	return points
end
function SS.HasLineOfSight(cam,targetModel,targetPosition,targetPart)
	if not State.NPCWallCheck then return true end
	if not cam or not targetModel or not targetModel.Parent or not targetPosition then return false end
	local now=os.clock()
	local current=FOVController and FOVController.Target==targetModel
	local cameraOrigin=cam.CFrame.Position
	local shotOrigin=BallisticsController:GetShotOrigin(BallisticsController.Tool or SS.GetEquippedToolObject()) or cameraOrigin
	local primary=(targetPart and targetPart.Parent and targetPart.Position) or targetPosition
	local cached=LOSCache[targetModel]
	local ttl=current and .032 or .075
	if cached and now-cached.Time<=ttl and (cached.Origin-cameraOrigin).Magnitude<=.55 and (cached.Target-primary).Magnitude<=.75 then
		return cached.Visible
	end
	local points=SS.CollectLOSSamples(targetModel,targetPart,current)
	if #points==0 then points[1]=primary end
	local cameraVisible=false
	local maxCameraSamples=current and math.min(#points,5) or math.min(#points,2)
	for i=1,maxCameraSamples do
		if SS.RaycastVisibilitySample(cameraOrigin,targetModel,points[i],5) then cameraVisible=true break end
	end
	if not cameraVisible then
		LOSCache[targetModel]={Time=now,Origin=cameraOrigin,Target=primary,Visible=false}
		return false
	end
	local visible=true
	if (shotOrigin-cameraOrigin).Magnitude>1.2 then
		visible=false
		local shotSamples=current and math.min(#points,3) or 1
		for i=1,shotSamples do
			if SS.RaycastVisibilitySample(shotOrigin,targetModel,points[i],5) then visible=true break end
		end
	end
	LOSCache[targetModel]={Time=now,Origin=cameraOrigin,Target=primary,Visible=visible}
	return visible
end

function SS.GetPlayerAimPart(model,hum)
	if not model or not hum or hum.Health<=0 then return nil end
	if State.NPCAimPart=="Torso" then
		return model:FindFirstChild("UpperTorso")
			or model:FindFirstChild("Torso")
			or model:FindFirstChild("LowerTorso")
			or model:FindFirstChild("HumanoidRootPart")
	end
	return model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
end

