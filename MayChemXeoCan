function SS.RefreshCustomManager(preferId)
	local entries={}
	for _,entry in ipairs(State.FunctionStudio) do if type(entry)=="table" and not entry.Removed then entries[#entries+1]=entry end end
	if #entries==0 then
		SS.CustomManagerIndex=1
		SS.CustomManagerPicker:SetItems({},nil,true)
		SS.CustomManagerPicker:Set("Chưa có chức năng","Tạo chức năng ở phía trên",false,"Sửa")
		return
	end
	local index=math.clamp(SS.CustomManagerIndex or 1,1,#entries)
	if preferId then
		for i,entry in ipairs(entries) do if entry.Id==preferId then index=i break end end
	end
	SS.CustomManagerIndex=index
	SS.CustomManagerEntries=entries
	local items={}
	for _,entry in ipairs(entries) do items[#items+1]={Text=entry.Name,Detail=entry.TabName.." • "..entry.ControlType,StateText="SỬA"} end
	SS.CustomManagerPicker:SetItems(items,function(i)
		SS.CustomManagerIndex=i
		local entry=entries[i]
		if entry then SS.OpenCustomEditor(entry) end
	end,true)
	local current=entries[index]
	SS.CustomManagerPicker:Set(current.Name,current.TabName.." • "..current.ControlType,false,"Sửa")
end
function SS.StepCustomManager(delta)
	local entries=SS.CustomManagerEntries or {}
	if #entries<=0 then SS.RefreshCustomManager() entries=SS.CustomManagerEntries or {} end
	if #entries<=0 then return end
	SS.CustomManagerIndex=((SS.CustomManagerIndex-1+(delta or 0))%#entries)+1
	local entry=entries[SS.CustomManagerIndex]
	SS.CustomManagerPicker:Set(entry.Name,entry.TabName.." • "..entry.ControlType,false,"Sửa")
end
SS.CustomManagerPicker:Bind(function() SS.StepCustomManager(-1) end,function() SS.StepCustomManager(1) end,function()
	local entry=(SS.CustomManagerEntries or {})[SS.CustomManagerIndex]
	if entry then SS.OpenCustomEditor(entry) end
end,SS.RefreshCustomManager)
