function SS.GlassButtonSurface(o,accent,danger)
	local dangerSoft=Color3.fromRGB(237,218,222)
	o.BackgroundColor3=danger and dangerSoft or (accent and C.P2 or C.GlassSoft)
	o.BackgroundTransparency=danger and .34 or (accent and .34 or .48)
