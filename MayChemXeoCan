local NPCMaintenanceElapsed=0
local WorkspaceQueueElapsed=0
local WorkspaceSweepElapsed=0
local WorkspaceSweepList={}
local WorkspaceSweepIndex=1
SS.Keep(RS.Heartbeat:Connect(function(dt)
	WorkspaceQueueElapsed+=dt
	if WorkspaceQueueElapsed>=.08 and type(SS.GetNPCShape)=="function" and SS.WorkspaceQueueHead<=#WorkspaceTargetQueue then
		WorkspaceQueueElapsed=0
		local budget=10
		while budget>0 and SS.WorkspaceQueueHead<=#WorkspaceTargetQueue do
			budget-=1
			local model=WorkspaceTargetQueue[SS.WorkspaceQueueHead]
			SS.WorkspaceQueueHead+=1
			WorkspaceTargetQueued[model]=nil
			if model and model.Parent then SS.RefreshWorkspaceTarget(model) end
		end
		if SS.WorkspaceQueueHead>#WorkspaceTargetQueue then
			table.clear(WorkspaceTargetQueue)
			SS.WorkspaceQueueHead=1
		end
	end

	NPCMaintenanceElapsed+=dt
	if NPCMaintenanceElapsed>=2.4 and WorkspaceSweepIndex>#WorkspaceSweepList then
		NPCMaintenanceElapsed=0
		for model,hum in pairs(NPCCache) do
			if not model or not model.Parent or not hum or not hum.Parent or hum.Health<=0 then
				NPCCache[model]=nil
				NPCFriendlyCache[model]=nil
				NPCShapeCache[model]=nil
				WorkspaceTargetCache[model]=nil
			end
		end
		table.clear(WorkspaceSweepList)
		for model in pairs(WorkspaceTargetCache) do WorkspaceSweepList[#WorkspaceSweepList+1]=model end
		WorkspaceSweepIndex=1
		SS.WorkspaceTargetCount=#WorkspaceSweepList
		SS.WorkspaceBrowseDirty=true
	end

	WorkspaceSweepElapsed+=dt
	if WorkspaceSweepElapsed>=.12 and WorkspaceSweepIndex<=#WorkspaceSweepList then
		WorkspaceSweepElapsed=0
		local budget=4
		while budget>0 and WorkspaceSweepIndex<=#WorkspaceSweepList do
			budget-=1
			local model=WorkspaceSweepList[WorkspaceSweepIndex]
			WorkspaceSweepIndex+=1
			local rec=WorkspaceTargetCache[model]
			if not model or not model.Parent or not model:IsDescendantOf(WS) then
				WorkspaceTargetCache[model]=nil
				WorkspaceHealthCache[model]=nil
			else
				local info
				local hum=rec and rec.HealthInfo and rec.HealthInfo.Humanoid
				if hum and hum.Parent then
					info={Humanoid=hum,Health=hum.Health,MaxHealth=math.max(1,hum.MaxHealth),Alive=hum.Health>0,Source="Humanoid"}
				else
					info=SS.ReadWorkspaceHealth(model,true)
				end
				if not info or not info.Alive then
					WorkspaceTargetCache[model]=nil
				else
					rec=rec or {}
					rec.HealthInfo=info
					rec.Seen=os.clock()
					WorkspaceTargetCache[model]=rec
				end
			end
		end
		if WorkspaceSweepIndex>#WorkspaceSweepList then
			local count=0
			for _ in pairs(WorkspaceTargetCache) do count+=1 end
			SS.WorkspaceTargetCount=count
			SS.WorkspaceBrowseDirty=true
			if SS.WorkspaceNPCPicker and SS.WorkspaceNPCPicker.Expanded and SS.RefreshWorkspaceBrowseList then
				pcall(SS.RefreshWorkspaceBrowseList,true)
			elseif SS.RefreshWorkspaceBrowseCards then
				pcall(SS.RefreshWorkspaceBrowseCards)
			end
		end
	end
end))

function SS.IsWorkspaceAimCandidateAllowed(model)
	if not model then return false end
	if #(State.SelectedNPCTargets or {})<=0 then return true end
	if not SS.SelectedNPCSet or next(SS.SelectedNPCSet)==nil then SS.RebuildSelectedNPCSet() end
	return SS.SelectedNPCSet[model.Name]==true
end

function SS.ToggleSelectedNPC(modelOrName)
	local name=typeof(modelOrName)=="Instance" and modelOrName.Name or tostring(modelOrName or "")
	name=name:gsub("[%c]",""):gsub("^%s+",""):gsub("%s+$",""):sub(1,80)
	if name=="" then return false end
	local nextList,removed={},false
	for _,value in ipairs(State.SelectedNPCTargets or {}) do
		if tostring(value)~=name then nextList[#nextList+1]=tostring(value) else removed=true end
	end
	if not removed then nextList[#nextList+1]=name end
	State.SelectedNPCTargets=nextList
	SS.RebuildSelectedNPCSet()
	SS.SaveShiftSyncConfig(true)
	return not removed
end

function SS.ClearSelectedNPCs()
