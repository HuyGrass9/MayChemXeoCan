function SS.ProjectBox(frame,cf,size,cam,smoothAlpha)
	local hx,hy,hz=size.X*.5,size.Y*.5,size.Z*.5
	local minX,minY=math.huge,math.huge
	local maxX,maxY=-math.huge,-math.huge
	local found=false

	if VisualQualityMode=="Low" then
		local top=cam:WorldToViewportPoint(cf:PointToWorldSpace(Vector3.new(0,hy,0)))
		local bottom=cam:WorldToViewportPoint(cf:PointToWorldSpace(Vector3.new(0,-hy,0)))
		if top.Z>0 and bottom.Z>0 then
			local height=math.max(4,math.abs(bottom.Y-top.Y))
			local centerX=(top.X+bottom.X)*.5
			local width=math.max(3,height*math.clamp(size.X/math.max(size.Y,.1),.34,.72))
			minX=centerX-width*.5
			maxX=centerX+width*.5
			minY=math.min(top.Y,bottom.Y)
			maxY=math.max(top.Y,bottom.Y)
			found=true
		end
	else
		for xi=-1,1,2 do
			for yi=-1,1,2 do
				for zi=-1,1,2 do
					local world=cf:PointToWorldSpace(Vector3.new(hx*xi,hy*yi,hz*zi))
					local p,on=cam:WorldToViewportPoint(world)
					if on and p.Z>0 then
						found=true
						minX=math.min(minX,p.X)
						minY=math.min(minY,p.Y)
						maxX=math.max(maxX,p.X)
						maxY=math.max(maxY,p.Y)
					end
				end
			end
		end
	end
	if not found or maxX<=minX or maxY<=minY then
		frame.Visible=false
		return nil
	end
	local targetPos=UDim2.fromOffset(minX,minY)
	local targetSize=UDim2.fromOffset(maxX-minX,maxY-minY)
	if frame.Visible and smoothAlpha and smoothAlpha<.999 then
		frame.Position=frame.Position:Lerp(targetPos,smoothAlpha)
		frame.Size=frame.Size:Lerp(targetSize,smoothAlpha)
	else
		frame.Position=targetPos
		frame.Size=targetSize
	end
	frame.Visible=true
	return minX,minY,maxX,maxY
end

function SS.SetTracer(line,a,b,record,smoothAlpha)
	if record and smoothAlpha and smoothAlpha<.999 then
		record.TracerA=record.TracerA and record.TracerA:Lerp(a,smoothAlpha) or a
		record.TracerB=record.TracerB and record.TracerB:Lerp(b,smoothAlpha) or b
		a,b=record.TracerA,record.TracerB
	end
	local dx=b.X-a.X
	local dy=b.Y-a.Y
	local len=math.sqrt(dx*dx+dy*dy)
	if len<1 then
		line.Visible=false
		return
	end
	local tracerThickness=math.clamp(1.2+math.clamp((State.ESPScale or 60)/100,.40,1.35)*.9,1.4,2.8)
	line.Size=UDim2.fromOffset(len,tracerThickness)
	line.Position=UDim2.fromOffset((a.X+b.X)*.5,(a.Y+b.Y)*.5)
	line.Rotation=math.deg(math.atan2(dy,dx))
	line.Visible=true
end

function SS.StartVisualLoop(force)
	if force then
		if VisualConn then
			pcall(function() VisualConn:Disconnect() end)
			VisualConn=nil
		end
		pcall(function() RS:UnbindFromRenderStep(VisualBindName) end)
		SS.ClearVisuals()
	end
	if VisualConn then return end
	VisualElapsed=0
	SS.VisualLastCameraLook=nil
	VisualLastFrameClock=os.clock()
	local visualBound=true
	VisualConn={Disconnect=function()
		if not visualBound then return end
		visualBound=false
		pcall(function() RS:UnbindFromRenderStep(VisualBindName) end)
	end}
	RS:BindToRenderStep(VisualBindName,Enum.RenderPriority.Camera.Value+10,function(dt)
		if not visualBound then return end
		VisualLastFrameClock=os.clock()
		VisualFrameCount+=1
		local ok,err=pcall(function()
			VisualElapsed+=dt
			local visualDt=math.clamp(dt,1/240,.06)
			local instantFPS=1/math.max(visualDt,1/240)
			VisualFPS=VisualFPS+(instantFPS-VisualFPS)*math.clamp(visualDt*3.8,0,1)

			if VisualFPS>=104 then VisualTargetHz=120
			elseif VisualFPS>=79 then VisualTargetHz=90
			elseif VisualFPS>=52 then VisualTargetHz=60
			elseif VisualFPS>=38 then VisualTargetHz=45
			else VisualTargetHz=30 end
			if VisualQualityMode=="High" then
				if VisualFPS<36 then VisualQualityMode="Low" end
			else
				if VisualFPS>50 then VisualQualityMode="High" end
			end
			State.VisualRange=(VisualFPS<42 and 850) or (VisualFPS<62 and 1250) or 1800
			local fpsStress=math.clamp((55-VisualFPS)/30,0,1)
			if VisualQualityMode=="Low" then fpsStress=math.clamp(fpsStress+.18,0,1) end
			local response=72-fpsStress*12
			local smoothAlpha=1-math.exp(-response*visualDt)
			if not State.ESP and not State.Tracer and not State.HP then
				for _,b in pairs(Visuals) do SS.HideVisual(b) end
				return
			end
			if UI and UI.Visible then
				for _,b in pairs(Visuals) do SS.HideVisual(b) end
				return
			end

			local cam=WS.CurrentCamera
			local localRoot=SS.GetRoot()
			if not cam or not localRoot then
				for _,b in pairs(Visuals) do SS.HideVisual(b) end
				return
			end

			local cameraMotionBoost=0
			local cameraAngle=0
			local look=cam.CFrame.LookVector
			if SS.VisualLastCameraLook then
				local dot=math.clamp(SS.VisualLastCameraLook:Dot(look),-1,1)
				cameraAngle=math.acos(dot)
				cameraMotionBoost=math.clamp(cameraAngle/math.rad(2.0),0,.46)
			end
			SS.VisualLastCameraLook=look

			table.clear(VisualSeen)
			local seen=VisualSeen
			local themeVersion=SS.ThemeVersion or 0
			local espScaleValue=State.ESPScale or 60
			local iconMode="Diamond"
			local iconText="◇"
			local espVisualScale=math.clamp(espScaleValue/100,.40,1.35)
			for _,plr in ipairs(PlayerRegistry) do
				if plr~=LP then
					seen[plr]=true
					local char=plr.Character
					local root=char and char:FindFirstChild("HumanoidRootPart")
					local head=char and char:FindFirstChild("Head")
					local hum=char and char:FindFirstChildOfClass("Humanoid")
					local b=Visuals[plr]
					local valid=char and char.Parent and char:IsDescendantOf(WS)
						and root and root:IsA("BasePart") and root.Parent==char
						and head and head:IsA("BasePart") and head.Parent==char
						and hum and hum.Parent==char and hum.Health>0
					local rootPoint,rootOn=nil,false
					if valid then rootPoint,rootOn=cam:WorldToViewportPoint(root.Position) end
					if valid and (not rootOn or not rootPoint or rootPoint.Z<=0) then valid=false end

					if b and b.Character~=char then
						SS.HideVisual(b)
						b.TracerA=nil
						b.TracerB=nil
						b.LastScreenCenter=nil
						b.LastWorldPos=nil
					end

					if not valid then
						if b then SS.HideVisual(b) end
					else
						local distance=(localRoot.Position-root.Position).Magnitude
						if distance>State.VisualRange then
							if b then SS.HideVisual(b) end
						else
							b=b or SS.EnsureVisual(plr)
							b.Character=char
							local playerAlpha=math.clamp(smoothAlpha+cameraMotionBoost,.30,.97)
							if cameraAngle>math.rad(.35) then playerAlpha=1 end
							local screenCenter=Vector2.new(rootPoint.X,rootPoint.Y)
							if b.LastScreenCenter then
								local screenJump=(screenCenter-b.LastScreenCenter).Magnitude
								local pxPerSecond=screenJump/math.max(visualDt,1/240)
								local motionBoost=math.clamp(pxPerSecond/1250,0,.48)
								playerAlpha=math.clamp(playerAlpha+motionBoost,.28,.975)
								if screenJump>130 then playerAlpha=1 end
							end
							if b.LastWorldPos and (root.Position-b.LastWorldPos).Magnitude>22 then playerAlpha=1 end
							b.LastScreenCenter=screenCenter
							b.LastWorldPos=root.Position
							if b.ThemeVersion~=themeVersion or b.ESPScaleValue~=espScaleValue or b.IconMode~=iconMode then
								b.ThemeVersion=themeVersion
								b.ESPScaleValue=espScaleValue
								b.IconMode=iconMode
								b.BoxStroke.Color=C.P
								b.Tracer.BackgroundColor3=C.P
								b.Icon.TextColor3=C.P
								b.Icon.Text=iconText
								b.Icon.Visible=iconText~=""
							end

							local minX,minY,maxX,maxY
							if State.ESP then
								local bodyHeight=math.clamp((hum.HipHeight or 2)+4.8,5.6,9.5)*espVisualScale
								local bodyWidth=math.clamp(root.Size.X*2.25,3.6,6.0)*espVisualScale
								minX,minY,maxX,maxY=SS.ProjectBox(
									b.Box,
									root.CFrame*CFrame.new(0,.35,0),
									Vector3.new(bodyWidth,bodyHeight,math.clamp(root.Size.Z*2.4,2.4,4.5)*espVisualScale),
									cam,
									playerAlpha
								)
							else
								b.Box.Visible=false
							end

							if State.ESP or State.HP then
								local anchor,on=cam:WorldToViewportPoint(head.Position+Vector3.new(0,.55,0))
								if on and anchor.Z>0 then
									local scale=espVisualScale
									b.Icon.Size=UDim2.fromOffset(math.max(8,math.floor(14*scale)),math.max(10,math.floor(18*scale)))
									b.Icon.Position=UDim2.fromOffset(math.max(3,math.floor(4*scale)),1)
									b.Icon.TextSize=math.clamp(math.floor(10*scale+.5),6,12)
									local baseWidth=minX and math.clamp((maxX-minX)/math.max(espVisualScale,.01),92,166) or 118
									local width=math.floor(math.clamp(baseWidth*scale,50,160)+.5)
									local height=math.floor(math.max(State.HP and 21 or 14,(State.HP and 34 or 22)*scale)+.5)
									local centerX=minX and (minX+maxX)*.5 or anchor.X
									local topY=minY and (minY-height-8) or (anchor.Y-height-18)

									local targetCardSize=UDim2.fromOffset(width,height)
									if b.Card.Visible then
										b.Card.Size=b.Card.Size:Lerp(targetCardSize,playerAlpha)
									else
										b.Card.Size=targetCardSize
									end
									b.Name.TextSize=math.clamp(math.floor(9*scale+.5),6,11)
									if not b.LastTextUpdate or VisualLastFrameClock-b.LastTextUpdate>=.10 then
										b.LastTextUpdate=VisualLastFrameClock
										b.Name.Text=(plr.DisplayName or plr.Name).."  ·  "..math.floor(distance+.5).." studs"
									end
									if b.Icon.Visible then
										b.Name.Position=UDim2.fromOffset(math.max(11,math.floor(19*scale)),1)
										b.Name.Size=UDim2.new(1,-math.max(14,math.floor(23*scale)),0,math.max(11,math.floor(18*scale)))
									else
										b.Name.Position=UDim2.fromOffset(4,1)
										b.Name.Size=UDim2.new(1,-8,0,math.max(11,math.floor(18*scale)))
									end

									b.HPTrack.Visible=State.HP
									if State.HP then
										local maxHealth=math.max(1,hum.MaxHealth)
										local health=math.max(0,hum.Health)
										local ratio=math.clamp(health/maxHealth,0,1)
										b.HPTrack.Size=UDim2.new(1,-6,0,math.max(5,math.floor(9*scale)))
										b.HPTrack.Position=UDim2.new(0,3,1,-math.max(7,math.floor(12*scale)))
										local hpGoal=UDim2.new(ratio,0,1,0)
										if b.HPFill.Visible then
											b.HPFill.Size=b.HPFill.Size:Lerp(hpGoal,playerAlpha)
										else
											b.HPFill.Size=hpGoal
										end
										b.HPFill.BackgroundColor3=SS.HealthColor(ratio)
										b.HPText.TextSize=math.clamp(math.floor(7*scale+.5),5,8)
										if not b.LastHealthTextUpdate or VisualLastFrameClock-b.LastHealthTextUpdate>=.10 or b.LastHealthValue~=math.floor(health+.5) then
											b.LastHealthTextUpdate=VisualLastFrameClock
											b.LastHealthValue=math.floor(health+.5)
											b.HPText.Text=string.format("%d / %d",b.LastHealthValue,math.floor(maxHealth+.5))
										end
									end

									local cardX=math.clamp(centerX-width*.5,2,math.max(2,cam.ViewportSize.X-width-2))
									local cardY=math.clamp(topY,2,math.max(2,cam.ViewportSize.Y-height-2))
									local cardTarget=UDim2.fromOffset(cardX,cardY)
									if b.Card.Visible then b.Card.Position=b.Card.Position:Lerp(cardTarget,playerAlpha) else b.Card.Position=cardTarget end
									b.Card.Visible=true
								else
									b.Card.Visible=false
								end
							else
								b.Card.Visible=false
							end

							if State.Tracer then
								if rootOn and rootPoint.Z>0 then
									SS.SetTracer(b.Tracer,Vector2.new(cam.ViewportSize.X*.5,cam.ViewportSize.Y-4),Vector2.new(rootPoint.X,rootPoint.Y),b,playerAlpha)
								else
									b.Tracer.Visible=false
								end
							else
								b.Tracer.Visible=false
							end
						end
					end
				end
			end

			for plr in pairs(Visuals) do
				if not seen[plr] or plr.Parent~=Players then SS.ClearVisualPlayer(plr) end
			end
		end)
		if ok then
			SS.VisualErrorCount=0
		else
			SS.VisualErrorCount=(SS.VisualErrorCount or 0)+1
			if os.clock()-(SS.VisualLastErrorWarn or 0)>1.5 then
				SS.VisualLastErrorWarn=os.clock()
				warn("[ShiftSync Visual] "..tostring(err))
			end
			if SS.VisualErrorCount>=10 then
				SS.VisualErrorCount=0
				task.defer(function() if SS.ScheduleRuntimeRearm then SS.ScheduleRuntimeRearm("esp-error",.10) end end)
			end
		end
	end)
end

