function SS.EnsureTapDispatcher()
	if SS.TapDispatcherReady then return end
	SS.TapDispatcherReady=true
	SS.Keep(UIS.InputChanged:Connect(function(input)
		local active=SS.TapActive
		if not active or not active.Start then return end
		local source=active.Input
		local valid=(source.UserInputType==Enum.UserInputType.Touch and input==source)
			or (source.UserInputType==Enum.UserInputType.MouseButton1 and input.UserInputType==Enum.UserInputType.MouseMovement)
		if valid and (input.Position-active.Start).Magnitude>=active.Threshold then active.Moved=true end
	end))
	SS.Keep(UIS.InputEnded:Connect(function(input)
		local active=SS.TapActive
		if not active then return end
		local source=active.Input
		local ended=input==source or (source.UserInputType==Enum.UserInputType.MouseButton1 and input.UserInputType==Enum.UserInputType.MouseButton1)
		if not ended then return end
		SS.TapActive=nil
		if not active.Moved and not Input.Owner and active.Button and active.Button.Parent then SS.CallSafe(active.Callback) end
	end))
end

function SS.BindTapWithoutDrag(button,callback,threshold)
	if not button then return end
	SS.EnsureTapDispatcher()
	SS.Keep(button.InputBegan:Connect(function(input)
		if Input.Owner or SS.TapActive then return end
		if input.UserInputType~=Enum.UserInputType.Touch and input.UserInputType~=Enum.UserInputType.MouseButton1 then return end
		SS.TapActive={Button=button,Callback=callback,Threshold=tonumber(threshold) or 11,Input=input,Start=input.Position,Moved=false}
	end))
end

function UI:AddPage(id,title,options)
	if self.Pages[id] then return self.Pages[id] end
	options=type(options)=="table" and options or {}
