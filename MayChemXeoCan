function SS.Capture(owner,input,onMove,onFinish)
	if Input.Owner then return false end
	Input.Owner=owner
	Input.Source=input
	Input.Move=onMove
	Input.Finish=onFinish
	return true
end

function SS.Release(owner)
	if Input.Owner~=owner then return end
	local finish=Input.Finish
	Input.Owner=nil
	Input.Source=nil
	Input.Move=nil
	Input.Finish=nil
	if finish then SS.CallSafe(finish) end
end

SS.Keep(UIS.InputChanged:Connect(function(i)
	if not Input.Owner or not Input.Source or not Input.Move then return end

	if Input.Source.UserInputType==Enum.UserInputType.Touch then
		if i==Input.Source then
			Input.Move(i.Position)
		end
	elseif Input.Source.UserInputType==Enum.UserInputType.MouseButton1 then
		if i.UserInputType==Enum.UserInputType.MouseMovement then
			Input.Move(i.Position)
		end
	end
end))

SS.Keep(UIS.InputEnded:Connect(function(i)
	if not Input.Owner or not Input.Source then return end

	if i==Input.Source
	or (Input.Source.UserInputType==Enum.UserInputType.MouseButton1
		and i.UserInputType==Enum.UserInputType.MouseButton1) then
		SS.Release(Input.Owner)
	end
end))

