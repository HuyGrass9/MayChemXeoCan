function UI:AddSlider(section,key,title,min,max,default,callback)
	assert(max>min,"max phải lớn hơn min")

	local box=SS.New("Frame",{
		Size=UDim2.new(1,0,0,42),
		Visible=true,
		BackgroundColor3=C.Glass,
		BackgroundTransparency=.46,
		BorderSizePixel=0,
		ClipsDescendants=true,
		Parent=section
	})
	SS.Round(box,12)
	SS.GlassStroke(box,.70,1)
	SS.GlassGradient(box,C.GlassSoft,C.GlassStrong,112)

	local value=math.clamp(tonumber(default) or min,min,max)
	local label=SS.New("TextLabel",{
		Size=UDim2.new(1,-18,0,16),
		Position=UDim2.fromOffset(9,4),
		BackgroundTransparency=1,
		Text="",
		TextColor3=C.Text,
		TextSize=10,
		Font=Enum.Font.GothamBold,
		TextXAlignment=Enum.TextXAlignment.Left,
		Parent=box
	})

	local track=SS.New("Frame",{
		Size=UDim2.new(1,-22,0,5),
		Position=UDim2.new(0,11,0,31),
		BackgroundColor3=Color3.fromRGB(170,164,180),
		BackgroundTransparency=.56,
		BorderSizePixel=0,
		Parent=box
	})
	SS.Round(track,5)

	local fill=SS.New("Frame",{
		BackgroundColor3=C.P,
		BackgroundTransparency=.18,
		BorderSizePixel=0,
		Parent=track
	})
	SS.Round(fill,5)

	local knob=SS.New("Frame",{
		Size=UDim2.fromOffset(15,15),
		AnchorPoint=Vector2.new(.5,.5),
		BackgroundColor3=C.White,
		BorderSizePixel=0,
		Parent=track
	})
	SS.Round(knob,8)
	SS.GlassStroke(knob,.34,1.2)

	local hit=SS.New("TextButton",{
		Size=UDim2.new(1,0,0,24),
		Position=UDim2.new(0,0,.5,-12),
		BackgroundTransparency=1,
		Text="",
		AutoButtonColor=false,
		Active=true,
		Parent=track
	})

	local owner="SLIDER_"..tostring(key)
	local pendingTouch=nil
	local pendingStart=nil
	local pendingMoveConn=nil
	local pendingEndConn=nil
	local scrollingParent=nil

	local p=section
	while p do
		if p:IsA("ScrollingFrame") then
			scrollingParent=p
			break
		end
		p=p.Parent
	end

	local function Render(fire)
		local a=(value-min)/(max-min)
		fill.Size=UDim2.fromScale(a,1)
		knob.Position=UDim2.new(a,0,.5,0)
		label.Text=SS.LocalizeText(title)..": "..tostring(value)
		if fire~=false then
			SS.CallSafe(callback,value)
		end
	end

	local function FromX(x,fire)
		local width=track.AbsoluteSize.X
		if width<=0 then return end
		local a=math.clamp((x-track.AbsolutePosition.X)/width,0,1)
		local nv=math.floor(min+(max-min)*a+.5)
		if nv~=value then
			value=nv
			Render(fire)
		end
	end

	local function ClearPending()
		pendingTouch=nil
		pendingStart=nil
		if pendingMoveConn then pendingMoveConn:Disconnect() pendingMoveConn=nil end
		if pendingEndConn then pendingEndConn:Disconnect() pendingEndConn=nil end
	end

	local function BeginTouch(input)
		if pendingTouch or Input.Owner then return end
		pendingTouch=input
		pendingStart=input.Position

		pendingMoveConn=UIS.InputChanged:Connect(function(changed)
			if changed~=pendingTouch or not pendingStart then return end
			local delta=changed.Position-pendingStart
			local ax=math.abs(delta.X)
			local ay=math.abs(delta.Y)
			if ay>=10 and ay>ax then
				ClearPending()
				return
			end
			if ax>=10 and ax>ay*1.15 then
				local touch=pendingTouch
				ClearPending()
				local oldScroll=scrollingParent and scrollingParent.ScrollingEnabled
				if scrollingParent then scrollingParent.ScrollingEnabled=false end
				if SS.Capture(owner,touch,function(pos)
					FromX(pos.X,true)
				end,function()
					if scrollingParent and oldScroll~=nil then
						scrollingParent.ScrollingEnabled=oldScroll
					end
				end) then
					FromX(changed.Position.X,true)
				elseif scrollingParent and oldScroll~=nil then
					scrollingParent.ScrollingEnabled=oldScroll
				end
			end
		end)

		pendingEndConn=UIS.InputEnded:Connect(function(ended)
			if ended==pendingTouch then
				ClearPending()
			end
		end)
	end

	SS.Keep(hit.InputBegan:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.Touch then
			BeginTouch(i)
		elseif i.UserInputType==Enum.UserInputType.MouseButton1 then
			if SS.Capture(owner,i,function(pos)
				FromX(pos.X,true)
			end) then
				FromX(i.Position.X,true)
			end
		end
	end))

	local api={}
	api.Get=function() return value end
	api.Set=function(a,b,c)
		local v,fire
		if a==api then v=b; fire=c else v=a; fire=b end
		v=tonumber(v)
		if not v then return false end
		value=math.clamp(v,min,max)
		Render(fire)
		return true
	end
	api.SetRange=function(a,b,c,d)
		local newMin,newMax,fire
		if a==api then newMin,newMax,fire=b,c,d else newMin,newMax,fire=a,b,c end
		newMin=tonumber(newMin)
		newMax=tonumber(newMax)
		if not newMin or not newMax or newMax<=newMin then return false end
		min=math.floor(newMin+.5)
		max=math.floor(newMax+.5)
		value=math.clamp(value,min,max)
		Render(fire)
		return true
	end
	api.SetVisible=function(a,b)
		local visible=(a==api) and b or a
		if box then box.Visible=visible~=false end
	end
	api.Visible=function() return box and box.Visible==true end
	api.Box=box

	self.Sliders[key]=api
	self:AddCleanup(ClearPending)
	Render(false)
	return api
end

