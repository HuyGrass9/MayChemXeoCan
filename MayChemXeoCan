function SS.FormatLocationStatus(slot)
	local d=State.TweenSlots[slot]
	if type(d)~="table" then return "Chưa lưu",false end
	local x,y,z=tonumber(d.x),tonumber(d.y),tonumber(d.z)
	if not x or not y or not z then return "Chưa lưu",false end
	return string.format("Đã lưu  •  X %.1f   Y %.1f   Z %.1f",x,y,z),true
end

function SS.RefreshLocationRow(slot)
	local row=LocationRows[slot]
	if not row then return end
	local text,saved=SS.FormatLocationStatus(slot)
	row.SetStatus(text,saved)
end

function SS.SaveLocation(slot)
	local root=SS.GetRoot()
	if not root then return end
	local cf=root.CFrame
	local rx,ry,rz=cf:ToOrientation()
	State.TweenSlots[slot]={x=cf.X,y=cf.Y,z=cf.Z,rx=rx,ry=ry,rz=rz}
	if MovementController then MovementController:Save(slot,cf) end
	SS.SaveShiftSyncConfig()
	SS.RefreshLocationRow(slot)
end

function SS.DeleteLocation(slot)
	State.TweenSlots[slot]=nil
	if MovementController and MovementController.Slots then MovementController.Slots[slot]=nil end
	SS.SaveShiftSyncConfig()
	SS.RefreshLocationRow(slot)
end

function SS.GetSavedLocation(slot)
	if MovementController then
		local cf=MovementController:Get(slot)
		if cf then return cf end
	end
	local d=State.TweenSlots[slot]
	if type(d)~="table" then return nil end
	local x,y,z=tonumber(d.x),tonumber(d.y),tonumber(d.z)
	if not x or not y or not z then return nil end
	local rx,ry,rz=tonumber(d.rx) or 0,tonumber(d.ry) or 0,tonumber(d.rz) or 0
	return CFrame.new(x,y,z)*CFrame.fromOrientation(rx,ry,rz)
end

function SS.GoLocation(slot)
	local root=SS.GetRoot()
	local cf=root and SS.GetSavedLocation(slot)
	if not root or not cf or not MovementController then return end
	State.BackCFrame=root.CFrame
	MovementController:TweenPart(root,cf)
end

for i=1,3 do
	local slot=tostring(i)
	local initialText,initialSaved=SS.FormatLocationStatus(slot)
	LocationRows[slot]=UI:AddLocationSlot(Locations,"Point"..slot,"Điểm "..slot,initialText,function()
		SS.SaveLocation(slot)
	end,function()
		SS.GoLocation(slot)
	end,function()
		SS.DeleteLocation(slot)
	end)
	LocationRows[slot].SetStatus(initialText,initialSaved)
end


