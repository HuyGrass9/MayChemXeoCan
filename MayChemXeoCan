		return
	end

	if self.Target==model and self.Highlight and self.Highlight.Parent and self.Highlight.Adornee==model then
		return
	end
	if self.Highlight then
		pcall(function() self.Highlight:Destroy() end)
		self.Highlight=nil
	end

	local hi=Instance.new("Highlight")
	hi.Name="ShiftSyncAimTarget"
	hi.Adornee=model
	hi.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
	hi.FillColor=C.P
	hi.OutlineColor=C.White
	hi.FillTransparency=.78
	hi.OutlineTransparency=.08
	hi.Parent=model
	self.Highlight=hi
end

function FOVController:IsPointInsideFOV(cam,worldPosition,scale)
	if not cam or not worldPosition then return false,math.huge end
	local point,onScreen=cam:WorldToViewportPoint(worldPosition)
	if not onScreen or point.Z<=0 then return false,math.huge end
	local v=cam.ViewportSize; local center=Vector2.new(v.X*.5,v.Y*.5)
	local radius=math.max(40,tonumber(self.AutoRadius or State.FOVRadius) or 160)*math.max(.5,tonumber(scale) or 1)
	local d=(Vector2.new(point.X,point.Y)-center).Magnitude
	return d<=radius,d
end

function FOVController:EvaluateModel(model,kind,cam,center,localRoot,radiusScale,player)
	local hum
	local part
	local healthInfo=nil
	local displayName=model and model.Name or "Target"
	local range=State.NPCAimRange or 650

	if kind=="Player" then
		player=player or (model and Players:GetPlayerFromCharacter(model))
		if not player or player==LP or not model or model~=player.Character then return nil end
		if State.IgnoreAllies and SS.IsFriendlyPlayer(player) then return nil end
		hum=model:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health<=0 then return nil end
		part=SS.GetPlayerAimPart(model,hum)
		displayName=(player.DisplayName and player.DisplayName~="") and player.DisplayName or player.Name
	else
		if not model or not model.Parent or Players:GetPlayerFromCharacter(model) then return nil end
		local rec=WorkspaceTargetCache[model]
		healthInfo=SS.ReadWorkspaceHealth(model,false) or (rec and rec.HealthInfo)
		if not healthInfo or not healthInfo.Alive then
			WorkspaceTargetCache[model]=nil
			WorkspaceHealthCache[model]=nil
			NPCCache[model]=nil
			return nil
		end
		hum=healthInfo.Humanoid

		local shape=rec and rec.Shape or nil
		if not shape or not shape.Head or not shape.Head.Parent or not shape.Core or not shape.Core.Parent then
			NPCShapeCache[model]=nil
			shape=SS.GetNPCShape(model,hum)
			if rec then rec.Shape=shape end
		end
		if not shape then return nil end
		local coarse=shape.Core or shape.Root or shape.Head
		if not coarse or not coarse:IsA("BasePart") then return nil end
		if (localRoot.Position-coarse.Position).Magnitude>range+10 then return nil end
		local cp,on=cam:WorldToViewportPoint(coarse.Position)
		if not on or cp.Z<=0 then return nil end
		local coarseScreen=(Vector2.new(cp.X,cp.Y)-center).Magnitude
		local coarseRadius=(State.FOVRadius or 160)*math.max(1,tonumber(radiusScale) or 1)+60
		if coarseScreen>coarseRadius then return nil end

		if State.IgnoreAllies and SS.IsFriendlyNPC(model) then return nil end
		part=SS.GetNPCPart(model,hum)
	end

	if not part or not part.Parent then return nil end
	local worldDistance=(localRoot.Position-part.Position).Magnitude
	if worldDistance>range then return nil end

	local screenPos,onScreen=cam:WorldToViewportPoint(part.Position)
	if not onScreen or screenPos.Z<=0 then return nil end
	local screenDistance=(Vector2.new(screenPos.X,screenPos.Y)-center).Magnitude
	local allowedRadius=(State.FOVRadius or 160)*math.max(1,tonumber(radiusScale) or 1)
	if screenDistance>allowedRadius then return nil end

	local aimPosition=SS.GetPredictedAimPosition(part,hum,worldDistance,cam.CFrame.Position)
	if not SS.HasLineOfSight(cam,model,aimPosition,part) then return nil end

	return {
		Kind=kind,
		Player=player,
		Model=model,
		Humanoid=hum,
		HealthInfo=healthInfo,
		Part=part,
		DisplayName=displayName,
		AimPosition=aimPosition,
		ScreenDistance=screenDistance,
		WorldDistance=worldDistance
	}
end

function FOVController:IsKindAllowed(kind)
	local selected=State.AimTargetType
	if selected=="Auto" then return kind=="Player" or kind=="Workspace" end
	return kind==selected
end

function FOVController:EvaluateCurrent(cam,center,localRoot,radiusScale)
	if not self.Target or not self:IsKindAllowed(self.TargetKind) then return nil end
	if self.TargetKind=="Player" then
		return self:EvaluateModel(self.Target,"Player",cam,center,localRoot,radiusScale,Players:GetPlayerFromCharacter(self.Target))
	end
	return self:EvaluateModel(self.Target,"Workspace",cam,center,localRoot,radiusScale,nil)
end

function FOVController:IsTargetDead()
	if not self.Target or not self.Target.Parent then return true end
	if self.TargetKind=="Player" then
		local plr=Players:GetPlayerFromCharacter(self.Target)
		local hum=self.Target:FindFirstChildOfClass("Humanoid")
		return not plr or not hum or hum.Health<=0
	end
	local info=SS.ReadWorkspaceHealth(self.Target,false)
	return not info or not info.Alive
end

function FOVController:IsBetter(entry,best)
	if not best then return true end
	local fov=math.max(40,tonumber(State.FOVRadius) or 160)
	local range=math.max(50,tonumber(State.NPCAimRange) or 650)
	local function score(item)
		local screenN=math.clamp((item.ScreenDistance or fov)/fov,0,2.5)
		local distN=math.clamp((item.WorldDistance or range)/range,0,2.5)
		local motion=TargetMotionCache[item.Model]
		local unstable=motion and math.clamp((motion.Turn or 0)*.30+(motion.Accel or 0)/220*.18,0,.35) or 0
		local value=screenN*.72+distN*.28+unstable
		if self.Target and item.Model==self.Target then value-=.11 end
		if item.Kind=="Workspace" and #(State.SelectedNPCTargets or {})>0 then value-=.025 end
		return value
	end
	local a,b=score(entry),score(best)
	local keepingCurrent=self.Target and best.Model==self.Target and entry.Model~=self.Target
	local margin=keepingCurrent and .075 or .012
	return a<b-margin
end
function FOVController:GetAdaptiveAimSettings(entry,angularError,frameDt)
	frameDt=math.clamp(frameDt or 1/60,1/240,.06)
	local instantFPS=1/frameDt
	local fpsBlend=1-math.exp(-3.2*frameDt)
	self.AdaptiveFPS=(self.AdaptiveFPS or instantFPS)+(instantFPS-(self.AdaptiveFPS or instantFPS))*fpsBlend

	local part=entry and entry.Part
	local velocity=(part and part:IsA("BasePart")) and part.AssemblyLinearVelocity.Magnitude or 0
	local distance=entry and tonumber(entry.WorldDistance) or 0
	local motion=entry and entry.Model and TargetMotionCache[entry.Model]
	local turn=motion and math.clamp(motion.Turn or 0,0,2) or 0
	local accel=motion and motion.Acceleration and motion.Acceleration.Magnitude or 0
	local speedN=math.clamp(velocity/90,0,1)
	local turnN=math.clamp(turn/1.8,0,1)
	local accelN=math.clamp(accel/120,0,1)
	local farN=math.clamp((distance-120)/900,0,1)
	local angleN=math.clamp((angularError or 0)/math.rad(20),0,1)
	local lowFps=math.clamp((58-(self.AdaptiveFPS or 60))/34,0,1)
	local jitter=math.clamp(self.AimJitter or 0,0,1)

	local tracking=math.clamp(.57 + speedN*.25 + angleN*.20 + turnN*.055 + accelN*.035
		- lowFps*.075 - farN*.025,.43,.97)
	local stability=math.clamp(.78 + lowFps*.12 + farN*.045 + jitter*.18 + turnN*.045
		- speedN*.105 - angleN*.075,.58,.975)
	local hold=math.clamp(.31 + farN*.065 + lowFps*.045 + jitter*.055 - speedN*.055 - turnN*.04,.14,.44)
	local maxTurnRate=math.rad(118 + tracking*155 + angleN*175 + speedN*58)
	local deadzone=math.rad(.008 + stability*.026 + lowFps*.018)
	return tracking,stability,hold,maxTurnRate,deadzone
end

function FOVController:GetTarget(cam,center,localRoot,frameDt)
	local now=os.clock()
	if self.TargetKind and not self:IsKindAllowed(self.TargetKind) then
		self:ClearTarget()
	end

	local current=nil
	if self.Target then
		current=self:EvaluateCurrent(cam,center,localRoot,1.0)
		if current then
			self.InvalidSince=nil
		else
			if self:IsTargetDead() then
				self.Target=nil
				self.TargetKind=nil
				self.CachedEntry=nil
				self.InvalidSince=nil
			else
				if not self.InvalidSince then self.InvalidSince=now end
				if now-self.InvalidSince<self.InvalidGrace then
					local cached=self.CachedEntry
					if cached and cached.Model==self.Target and cached.Part and cached.Part.Parent then
						local inside=self:IsPointInsideFOV(cam,cached.Part.Position,1.0)
						if inside then
							cached.WorldDistance=(localRoot.Position-cached.Part.Position).Magnitude
							cached.AimPosition=SS.GetPredictedAimPosition(cached.Part,cached.Humanoid,cached.WorldDistance,cam.CFrame.Position)
							current=cached
						end
					end
				else
					self.Target=nil
					self.TargetKind=nil
					self.CachedEntry=nil
					self.InvalidSince=nil
				end
			end
		end
	end

	local _,_,holdSeconds=self:GetAdaptiveAimSettings(current or self.CachedEntry,0,frameDt or self.LastFrameDt or 1/60)
	local canSwitch=(not current) or (now-(self.LastTargetSwitch or 0)>=holdSeconds)
	local best=current
	if canSwitch and (State.AimTargetType=="Player" or State.AimTargetType=="Auto") then
		for _,plr in ipairs(PlayerRegistry) do
			if plr~=LP and plr.Character and (not current or plr.Character~=current.Model) then
				local entry=self:EvaluateModel(plr.Character,"Player",cam,center,localRoot,1,plr)
				if entry and self:IsBetter(entry,best) then best=entry end
			end
		end
	end
	if canSwitch and (State.AimTargetType=="Workspace" or State.AimTargetType=="Auto") then
		for model in pairs(WorkspaceTargetCache) do
			if SS.IsWorkspaceAimCandidateAllowed(model) and (not current or model~=current.Model) then
				local entry=self:EvaluateModel(model,"Workspace",cam,center,localRoot,1,nil)
				if entry and self:IsBetter(entry,best) then best=entry end
			end
		end
	end

	if best then
		if current and best.Model~=current.Model then
			local _,_,adaptiveHold=self:GetAdaptiveAimSettings(current,0,frameDt or self.LastFrameDt or 1/60)
			if self.Challenger~=best.Model then
				self.Challenger=best.Model
				self.ChallengerSince=now
				best=current
			elseif now-(self.ChallengerSince or now)<math.max(.10,adaptiveHold*.70) then
				best=current
			else
				self.Challenger=nil
				self.ChallengerSince=0
			end
		else
			self.Challenger=nil
			self.ChallengerSince=0
		end

		local switched=self.Target~=best.Model
		self.Target=best.Model
		self.TargetKind=best.Kind
		self.CachedEntry=best
		self.InvalidSince=nil
		if switched then
			self.LastTargetSwitch=now
			self:ReleaseAimState(false)
		end
		return best
	end

	self:ClearTarget()
	return nil
end
function FOVController:GetStableAimBase(target,dt)
	local model=target and target.Model
	local part=target and target.Part
	if not model or not part or not part.Parent then return part and part.Position or nil end
	local core=model:FindFirstChild("HumanoidRootPart",true)
		or model:FindFirstChild("UpperTorso",true)
		or model:FindFirstChild("Torso",true)
		or model.PrimaryPart
	if not core or not core:IsA("BasePart") then return part.Position end

	local localOffset=core.CFrame:PointToObjectSpace(part.Position)
	if self.StableAnchorTarget~=model or self.StableAnchorCore~=core or not self.StableAnchorOffset
		or (self.StableAnchorOffset-localOffset).Magnitude>5
	then
		self.StableAnchorTarget=model
		self.StableAnchorCore=core
		self.StableAnchorOffset=localOffset
	else
		local frameDt=math.clamp(dt or 1/60,1/240,.06)
		local speed=core.AssemblyLinearVelocity.Magnitude
		local response=math.clamp(9.5+speed*.045,9.5,16.5)
		local a=1-math.exp(-response*frameDt)
		self.StableAnchorOffset=self.StableAnchorOffset:Lerp(localOffset,math.clamp(a,.08,.42))
	end
	return core.CFrame:PointToWorldSpace(self.StableAnchorOffset)
end

function FOVController:ApplyAimCamera(cam,localRoot,target,dt)
	if not target or not target.Part or not target.Part.Parent or not localRoot or not localRoot.Parent then
		self:ReleaseAimState(false)
		return
	end
	if cam.CameraType==Enum.CameraType.Scriptable then
		self:ReleaseAimState(false)
		return
	end

	local char=SS.GetCharacter()
	local subject=cam.CameraSubject
	if subject and char then
		local validSubject=(subject:IsA("Humanoid") and subject.Parent==char)
			or (subject:IsA("BasePart") and subject:IsDescendantOf(char))
		if not validSubject then
			self:ReleaseAimState(false)
			return
		end
	end

	local current=cam.CFrame
	local cameraPos=current.Position
	local rootPos=localRoot.Position
	local strictInside=self:IsPointInsideFOV(cam,target.Part.Position,1.0)
	if not strictInside then self:ClearTarget(); return end
	local frameDt=math.clamp(dt or 1/60,1/240,.06)
	local preAimLook=current.LookVector
	local externalTurn=0
	if self.LastAppliedLook then
		externalTurn=math.acos(math.clamp(self.LastAppliedLook:Dot(preAimLook),-1,1))/math.max(frameDt,1/240)
	end
	local rawCameraTurnN=math.clamp(externalTurn/math.rad(220),0,1)
	local cameraBlend=1-math.exp(-10*frameDt)
	self.CameraTurnN=(self.CameraTurnN or 0)+(rawCameraTurnN-(self.CameraTurnN or 0))*cameraBlend

	if self.LastLocalRootPosition and self.LastCameraPosition then
		local rootDelta=(rootPos-self.LastLocalRootPosition).Magnitude
		local camDelta=(cameraPos-self.LastCameraPosition).Magnitude
		if rootDelta>12 then
			self.CameraLagFrames=3
		elseif rootDelta>1.35 and camDelta<math.max(.25,rootDelta*.30) then
			self.CameraLagFrames=math.max(self.CameraLagFrames or 0,2)
		end
	end
	self.LastLocalRootPosition=rootPos
	self.LastCameraPosition=cameraPos
	if (self.CameraLagFrames or 0)>0 then
		self.CameraLagFrames-=1
		self.WasAiming=false
		if self.AdaptiveAlpha then self.AdaptiveAlpha*=.55 end
		if self.AimJitter then self.AimJitter*=.82 end
		return
	end

	local rawPartBase=target.Part.Position
	local rawBase=self:GetStableAimBase(target,frameDt) or rawPartBase
	local rawAim=target.AimPosition or rawPartBase
	local rawLead=rawAim-rawPartBase
	if self.LastAimRaw then
		local rawStep=(rawAim-self.LastAimRaw).Magnitude
		local expected=target.Part.AssemblyLinearVelocity.Magnitude*frameDt
		local noise=math.clamp(math.max(0,rawStep-expected*1.55)/3.2,0,1)
		local jitterBlend=1-math.exp(-7.2*frameDt)
		self.AimJitter=(self.AimJitter or 0)+(noise-(self.AimJitter or 0))*jitterBlend
	end
	self.LastAimRaw=rawAim

	if self.SmoothedLeadTarget~=target.Model or not self.SmoothedLead
		or (self.SmoothedLead-rawLead).Magnitude>32
	then
		self.SmoothedLeadTarget=target.Model
		self.SmoothedLead=rawLead
	else
		local motion=TargetMotionCache[target.Model]
		local turn=motion and math.clamp(motion.Turn or 0,0,1) or 0
		local tracking,stability=self:GetAdaptiveAimSettings(target,0,frameDt)
		local leadError=(rawLead-self.SmoothedLead).Magnitude
		local noise=math.clamp(self.AimJitter or 0,0,1)
		local response=(11+tracking*26+math.min(leadError,18)*.55)
			* (1-.46*stability) * (1-.34*noise) * (1-.18*turn)
		local leadAlpha=1-math.exp(-math.max(4,response)*frameDt)
		if leadError>8 then leadAlpha=math.max(leadAlpha,math.clamp(leadError/80,.08,.36)) end
		self.SmoothedLead=self.SmoothedLead:Lerp(rawLead,math.clamp(leadAlpha,.018,.68))
	end

	local lead=self.SmoothedLead or rawLead
	local aimPosition=rawBase+lead
	local viewport=cam.ViewportSize
	local center=Vector2.new(viewport.X*.5,viewport.Y*.5)
	local radius=math.max(self.AutoRadius or State.FOVRadius or 160,80)
	local baseScreen,baseOn=cam:WorldToViewportPoint(rawBase)
	local predScreen,predOn=cam:WorldToViewportPoint(aimPosition)
	if baseOn and predOn and baseScreen.Z>0 and predScreen.Z>0 then
		local baseDist=(Vector2.new(baseScreen.X,baseScreen.Y)-center).Magnitude
		local predDist=(Vector2.new(predScreen.X,predScreen.Y)-center).Magnitude
		local limit=radius*.94
		if predDist>limit and predDist>baseDist+.5 then
			local factor=math.clamp((limit-baseDist)/(predDist-baseDist),0,1)
			aimPosition=rawBase+lead*factor
		end
	end
	local delta=aimPosition-cameraPos
	if delta.Magnitude<=.08 then return end

	local aimScreen,onScreen=cam:WorldToViewportPoint(rawBase)
	local screenErrorN=0
	local screenMotionN=self.ScreenMotionN or 0
	if onScreen and aimScreen.Z>0 then
		local screen=Vector2.new(aimScreen.X,aimScreen.Y)
		screenErrorN=math.clamp((screen-center).Magnitude/radius,0,1.7)
		if self.LastAimScreen then
			local pxPerSecond=(screen-self.LastAimScreen).Magnitude/math.max(frameDt,1/240)
			local rawMotion=math.clamp(pxPerSecond/1350,0,1)
			local motionBlend=1-math.exp(-9*frameDt)
			screenMotionN+=(rawMotion-screenMotionN)*motionBlend
		end
		self.LastAimScreen=screen
	else
		self.LastAimScreen=nil
		screenMotionN*=math.exp(-8*frameDt)
	end
	self.ScreenMotionN=screenMotionN

	local goal=CFrame.lookAt(cameraPos,aimPosition,Vector3.yAxis)
	local dot=math.clamp(current.LookVector:Dot(goal.LookVector),-1,1)
	local angularError=math.acos(dot)
	local tracking,stability,_,maxTurnRate,deadzone=self:GetAdaptiveAimSettings(target,angularError,frameDt)
	local motion=TargetMotionCache[target.Model]
	local turn=motion and (motion.Turn or 0) or 0
	local angleN=math.clamp(angularError/math.rad(18),0,1)
	local cameraTurnN=math.clamp(self.CameraTurnN or 0,0,1)
	local motionN=math.clamp(self.ScreenMotionN or 0,0,1)
	local userTurnDamp=1-math.min(.38,cameraTurnN*.34)
	local responsiveness=(11.8+tracking*31+angleN*18+turn*4.4+screenErrorN*19+motionN*14)*(1-.20*stability)*userTurnDamp
	local alpha=1-math.exp(-responsiveness*frameDt)
	maxTurnRate*=(1+math.min(screenErrorN,1)*.34+motionN*.20)*(1-math.min(.24,cameraTurnN*.20))
	deadzone*=1-math.min(.54,motionN*.26+math.min(screenErrorN,1)*.18)
	if angularError>1e-5 then
		alpha=math.min(alpha,math.clamp((maxTurnRate*frameDt)/angularError,0,1))
	end
	if angularError<deadzone and deadzone>0 then
		alpha*=math.clamp(angularError/deadzone,0,1)
	end
	if screenErrorN>.18 or motionN>.18 then
		local catchup=1-math.exp(-(9+screenErrorN*17+motionN*11)*frameDt)
		catchup*=1-math.min(.30,cameraTurnN*.25)
		alpha=math.max(alpha,math.clamp(catchup,0,.68))
	end
	local currentAlpha=self.AdaptiveAlpha or 0
	local alphaRate=((alpha>currentAlpha) and (28+motionN*12) or 15)*(1-math.min(.26,cameraTurnN*.22))
	local alphaBlend=1-math.exp(-alphaRate*frameDt)
	if currentAlpha<=0 then
		self.AdaptiveAlpha=math.min(alpha,.28)
	else
		self.AdaptiveAlpha=currentAlpha+(alpha-currentAlpha)*alphaBlend
	end
	alpha=math.clamp(self.AdaptiveAlpha,0,.92)

	local blended=current:Lerp(goal,alpha)
	cam.CFrame=CFrame.new(cameraPos)*(blended-blended.Position)
	self.LastAppliedLook=cam.CFrame.LookVector
	self.WasAiming=true
end
function FOVController:Update(dt)
	local active=State.FOVEnabled or State.NPCAim
	if not active then
		FOVCircle.Visible=false
		self:ClearTarget()
		return
	end

	BallisticsController:UpdateTool(false)
	local cam=WS.CurrentCamera
	local localRoot=SS.GetRoot()
	if not cam or not localRoot then
		self:ClearTarget()
		return
	end

	local viewport=cam.ViewportSize
	self.AutoRadiusElapsed=(self.AutoRadiusElapsed or .6)+(dt or 0)
	if not self.AutoRadius or self.AutoRadiusElapsed>=.55 or self.AutoViewport~=viewport then
		self.AutoRadiusElapsed=0
		self.AutoViewport=viewport
		local density=(tonumber(SS.WorkspaceTargetCount) or 0)+math.max(0,#PlayerRegistry-1)
		local autoRadius=math.clamp(math.min(viewport.X,viewport.Y)*.23,105,235)
		if density>24 then autoRadius*=.88 elseif density<5 then autoRadius*=1.06 end
		self.AutoRadius=math.floor(math.clamp(autoRadius,95,250)+.5)
	end
	local radius=self.AutoRadius or 160
	State.FOVRadius=radius
	State.FOVOpacity=24
	local opacity=.24
	if self.LastRadius~=radius then
		self.LastRadius=radius
		FOVCircle.Size=UDim2.fromOffset(radius*2,radius*2)
	end
	if self.LastOpacity~=opacity then
		self.LastOpacity=opacity
		FOVStroke.Transparency=opacity
	end
	FOVCircle.Visible=State.FOVEnabled==true

	local targetCount=tonumber(SS.WorkspaceTargetCount) or 0
	local perfFPS=tonumber(PerformanceController.FPS) or 60
	if State.AimTargetType=="Player" then
		self.ScanInterval=(perfFPS<42) and 1/40 or 1/60
	elseif targetCount>90 then
		self.ScanInterval=1/20
	elseif targetCount>35 then
		self.ScanInterval=1/30
	else
		self.ScanInterval=1/45
	end
	if perfFPS<42 then self.ScanInterval*=1.25 end
	self.ScanElapsed+=(dt or 0)
	local cached=self.CachedEntry
	local needScan=not cached
		or not cached.Model or not cached.Model.Parent
		or not cached.Part or not cached.Part.Parent
		or self.ScanElapsed>=self.ScanInterval

	self.LastFrameDt=dt or self.LastFrameDt or 1/60
	if needScan then
		self.ScanElapsed=0
		local viewport=cam.ViewportSize
		local center=Vector2.new(viewport.X*.5,viewport.Y*.5)
		local target=self:GetTarget(cam,center,localRoot,self.LastFrameDt)
		self.CachedEntry=target
		self.LastTargetUpdate=os.clock()
		if target then
			self.Target=target.Model
			self.TargetKind=target.Kind
			if State.FOVHighlight then self:SetHighlight(target.Model) else self:SetHighlight(nil) end
			if State.FOVEnabled then
				FOVTargetLabel.Text=string.format("%s  •  %d studs",target.DisplayName or target.Model.Name,math.floor(target.WorldDistance+.5))
				FOVTargetLabel.Visible=true
			end
		else
			self:ClearTarget()
		end
	end

	local target=self.CachedEntry
	local toolReady=(not State.AimOnlyWithTool) or SS.HasEquippedTool()
	if State.NPCAim and target and toolReady then
		target.WorldDistance=(localRoot.Position-target.Part.Position).Magnitude
		target.AimPosition=SS.GetPredictedAimPosition(target.Part,target.Humanoid,target.WorldDistance,cam.CFrame.Position)
		self:ApplyAimCamera(cam,localRoot,target,dt)
	else
		self:ReleaseAimState()
	end
end

function FOVController:IsAlive(timeout)
	if not self.Connection then return false end
	return os.clock()-(self.LastFrameClock or 0)<(timeout or 1.0)
end

function FOVController:Start(force)
	if force and self.Connection then self:Stop() end
	if self.Connection then return end
	pcall(function() RS:UnbindFromRenderStep(self.BindName) end)
	self.ScanElapsed=self.ScanInterval
	self.LastFrameClock=os.clock()
	local callback=function(dt)
		self.LastFrameClock=os.clock()
		self.FrameCount=(self.FrameCount or 0)+1
		local ok,err=pcall(function() self:Update(dt) end)
		if ok then
			self.ErrorCount=0
		else
			self.ErrorCount=(self.ErrorCount or 0)+1
			if os.clock()-(self.LastErrorWarn or 0)>1.5 then
				self.LastErrorWarn=os.clock()
				warn("[ShiftSync Aim] "..tostring(err))
			end
			if self.ErrorCount>=10 then
				self.ErrorCount=0
				task.defer(function()
					if SS.ScheduleRuntimeRearm then SS.ScheduleRuntimeRearm("aim-error",.08) end
				end)
			end
		end
	end

	local bound=false
	local ok=pcall(function()
		RS:BindToRenderStep(self.BindName,Enum.RenderPriority.Camera.Value+5,callback)
		bound=true
	end)
	if ok and bound then
		self.Connection={Disconnect=function() pcall(function() RS:UnbindFromRenderStep(self.BindName) end) end}
	else
		self.Connection=RS.RenderStepped:Connect(callback)
	end
end

function FOVController:Stop()
	if self.Connection then
		pcall(function() self.Connection:Disconnect() end)
		self.Connection=nil
	end
	pcall(function() RS:UnbindFromRenderStep(self.BindName) end)
	self.ScanElapsed=0
	self.LastRadius=nil
	self.LastOpacity=nil
	self:ClearTarget()
	FOVCircle.Visible=false
end

function FOVController:SetEnabled(v)
	State.FOVEnabled=v==true
	if State.FOVEnabled or State.NPCAim then self:Start() else self:Stop() end
end

function FOVController:SetAim(v)
	State.NPCAim=v==true
	if State.NPCAim or State.FOVEnabled then self:Start() else self:Stop() end
end

function SS.ThemeColorNear(a,b)
	if typeof(a)~="Color3" or typeof(b)~="Color3" then return false end
	return math.abs(a.R-b.R)+math.abs(a.G-b.G)+math.abs(a.B-b.B)<0.004
end

function SS.ApplyThemeHue(hue)
	SS.ThemeVersion=(SS.ThemeVersion or 0)+1
	local oldP,oldP2,oldSoft,oldText=C.P,C.P2,C.PSoft,C.PText
	State.ThemeHue=SS.RebuildAccentPalette(hue,State.ThemeSaturation,State.ThemeBrightness)

	local function remapColor(c)
		if SS.ThemeColorNear(c,oldP) then return C.P end
		if SS.ThemeColorNear(c,oldP2) then return C.P2 end
		if SS.ThemeColorNear(c,oldSoft) then return C.PSoft end
		if SS.ThemeColorNear(c,oldText) then return C.PText end
		return c
	end

	local function recolor(root)
		if not root or not root.Parent then return end
		local list={root}
		for _,obj in ipairs(root:GetDescendants()) do list[#list+1]=obj end
		for _,obj in ipairs(list) do
			pcall(function()
				if obj:IsA("GuiObject") then
					obj.BackgroundColor3=remapColor(obj.BackgroundColor3)
					if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
						obj.TextColor3=remapColor(obj.TextColor3)
						obj.TextStrokeColor3=remapColor(obj.TextStrokeColor3)
					end
					if obj:IsA("ScrollingFrame") then
						obj.ScrollBarImageColor3=remapColor(obj.ScrollBarImageColor3)
					end
				elseif obj:IsA("UIStroke") then
					obj.Color=remapColor(obj.Color)
				elseif obj:IsA("UIGradient") then
					local points={}
					for _,kp in ipairs(obj.Color.Keypoints) do
						points[#points+1]=ColorSequenceKeypoint.new(kp.Time,remapColor(kp.Value))
					end
					obj.Color=ColorSequence.new(points)
				end
			end)
		end
	end

	recolor(GUI)
	recolor(IconLayer)
	recolor(MacroLayer)
	recolor(FOVLayer)
	FOVStroke.Color=C.P
	if FOVController.Highlight then
		FOVController.Highlight.FillColor=C.P
	end
end

function SS.ApplySurfaceTheme(hue)
	local oldBG,oldCard,oldCard2=C.BG,C.Card,C.Card2
	local oldGlass,oldStrong,oldSoft,oldBorder=C.Glass,C.GlassStrong,C.GlassSoft,C.Border
	State.SurfaceHue=SS.RebuildSurfacePalette(hue,State.SurfaceTint,State.SurfaceBrightness)

	local function near(a,b)
		return math.abs(a.R-b.R)<.025 and math.abs(a.G-b.G)<.025 and math.abs(a.B-b.B)<.025
	end
	local function remap(c)
		if near(c,oldBG) then return C.BG end
		if near(c,oldCard) then return C.Card end
		if near(c,oldCard2) then return C.Card2 end
		if near(c,oldGlass) then return C.Glass end
		if near(c,oldStrong) then return C.GlassStrong end
		if near(c,oldSoft) then return C.GlassSoft end
		if near(c,oldBorder) then return C.Border end
		return c
	end
	local function recolor(root)
		if not root or not root.Parent then return end
		local list={root}
		for _,obj in ipairs(root:GetDescendants()) do list[#list+1]=obj end
		for _,obj in ipairs(list) do
			pcall(function()
				if obj:IsA("GuiObject") then
					obj.BackgroundColor3=remap(obj.BackgroundColor3)
				elseif obj:IsA("UIStroke") then
					obj.Color=remap(obj.Color)
				elseif obj:IsA("UIGradient") then
					local points={}
					for _,kp in ipairs(obj.Color.Keypoints) do
						points[#points+1]=ColorSequenceKeypoint.new(kp.Time,remap(kp.Value))
					end
					obj.Color=ColorSequence.new(points)
				end
			end)
		end
	end
	recolor(GUI)
	recolor(IconLayer)
	recolor(MacroLayer)
end

function FollowController:RefreshButton()
	if QuickFollowButton then
		QuickFollowButton.Text=self.Active and "■" or "F"
		QuickFollowButton.TextColor3=self.Active and C.White or C.P
		QuickFollowButton.BackgroundColor3=self.Active and C.P or C.White
	end
	if QuickNextButton then
		QuickNextButton.Text="N"
		QuickNextButton.TextColor3=self.Active and C.P or C.Sub
		QuickNextButton.BackgroundColor3=C.White
	end
end

function FollowController:CancelTween()
	if self.Tween then
		pcall(function() self.Tween:Cancel() end)
		self.Tween=nil
	end
end

function FollowController:ClearToolHooks()
	if self.ToolChildConnection then
		self.ToolChildConnection:Disconnect()
		self.ToolChildConnection=nil
	end
	for tool,conn in pairs(self.ToolConnections) do
		if conn then conn:Disconnect() end
		self.ToolConnections[tool]=nil
	end
end

function FollowController:HookTool(tool)
	if not tool or not tool:IsA("Tool") or self.ToolConnections[tool] then return end
	self.ToolConnections[tool]=tool.Activated:Connect(function()
		if not self.Active then return end
		self.AttackPauseUntil=os.clock()+0.55
		self:CancelTween()
		if self.Root and self.Root.Parent then
			pcall(function() self.Root.Anchored=false end)
		end
	end)
end

function FollowController:HookCombat()
	self:ClearToolHooks()
	local char=SS.GetCharacter()
	if not char then return end
	for _,child in ipairs(char:GetChildren()) do
		self:HookTool(child)
	end
	self.ToolChildConnection=char.ChildAdded:Connect(function(child)
		self:HookTool(child)
	end)
end

function FollowController:Stop()
	if self.Connection then
		self.Connection:Disconnect()
		self.Connection=nil
	end
	self:CancelTween()
	self:ClearToolHooks()
	self.AttackPauseUntil=0
	local root=self.Root
	local hum=self.Humanoid
	if root and root.Parent and self.PreviousAnchored~=nil then
		pcall(function() root.Anchored=self.PreviousAnchored end)
	end
	if hum and hum.Parent and self.PreviousAutoRotate~=nil then
		pcall(function() hum.AutoRotate=self.PreviousAutoRotate end)
	end
	self.Active=false
	self.Target=nil
	self.Root=nil
	self.Humanoid=nil
	self.PreviousAnchored=nil
	self.PreviousAutoRotate=nil
	self.LastGoal=nil
	self.LastTargetPosition=nil
	self.UpdateElapsed=0
	State.FollowActive=false
	self:RefreshButton()
end

function FollowController:NextTarget()
	if not self.Active then return false end
	local root=SS.GetRoot()
	if not root then return false end
	local targets=SS.GetSortedTargets(root)
	if #targets==0 then return false end
	local nextIndex=1
	for i,item in ipairs(targets) do
		if item.Player==self.Target then
			nextIndex=(i % #targets)+1
			break
		end
	end
	self.Target=targets[nextIndex].Player
	self.LastGoal=nil
	self.LastTargetPosition=nil
	self.UpdateElapsed=0
	self.AttackPauseUntil=0
	self:CancelTween()
	self:RefreshButton()
	return true
end

function FollowController:StartTween(goalCFrame,targetRoot)
	local root=self.Root
	if not root or not root.Parent or not self.Active then return end
	self:CancelTween()
	local distance=(root.Position-goalCFrame.Position).Magnitude
	if distance<=0.55 then
		self.LastGoal=goalCFrame.Position
		pcall(function()
			root.Anchored=false
		end)
		return
	end
	local speed=math.clamp(State.TweenSpeed or 45,30,65)
	local duration=math.clamp(distance/speed,0.10,0.24)
	pcall(function()
		root.Anchored=false
	end)
	local tween=TS:Create(root,TweenInfo.new(duration,Enum.EasingStyle.Linear,Enum.EasingDirection.Out),{CFrame=goalCFrame})
	self.Tween=tween
	self.LastGoal=goalCFrame.Position
	local completedConn
	completedConn=tween.Completed:Connect(function()
		if completedConn then
			completedConn:Disconnect()
			completedConn=nil
		end
		if self.Tween==tween then self.Tween=nil end
		if self.Active and self.Root and self.Root.Parent then
			pcall(function() self.Root.Anchored=false end)
		end
	end)
	tween:Play()
end

function FollowController:Start()
	if self.Active then return true end
	local root=SS.GetRoot()
	local hum=SS.GetHumanoid()
	local target=SS.GetNearestPlayer(root)
	if not root or not hum or not target then return false end
	if MovementController then MovementController:Cancel() end
	self.Root=root
	self.Humanoid=hum
	self.Target=target
	self.PreviousAnchored=root.Anchored
	self.PreviousAutoRotate=hum.AutoRotate
	self.Active=true
	self.UpdateElapsed=0
	self.LastGoal=nil
	self.LastTargetPosition=nil
	State.FollowActive=true
	pcall(function()
		hum.AutoRotate=true
		root.Anchored=false
	end)
	self:HookCombat()

	self.Connection=RS.Heartbeat:Connect(function(dt)
		if not self.Active then return end
		local localRoot=SS.GetRoot()
		local localHum=SS.GetHumanoid()
		if localRoot~=self.Root or not localRoot or not localHum or localHum.Health<=0 then
			self:Stop()
			return
		end

		local targetRoot,targetHum=SS.GetTargetParts(self.Target)
		if not targetRoot or not targetHum then
			self:CancelTween()
			self.Target=SS.GetNearestPlayer(localRoot)
			targetRoot,targetHum=SS.GetTargetParts(self.Target)
			if not targetRoot or not targetHum then
				self:Stop()
				return
			end
			self.LastGoal=nil
			self.LastTargetPosition=nil
			self:RefreshButton()
		end

		if os.clock()<self.AttackPauseUntil then
			self:CancelTween()
			pcall(function()
				localRoot.Anchored=false
				localHum.AutoRotate=true
			end)
			return
		end

		self.UpdateElapsed+=dt
		if self.UpdateElapsed<0.07 then return end
		self.UpdateElapsed=0

		local followDistance=math.clamp(State.FollowDistance or 4,2,12)
		local targetVelocity=targetRoot.AssemblyLinearVelocity
		local horizontalVelocity=Vector3.new(targetVelocity.X,0,targetVelocity.Z)
		if horizontalVelocity.Magnitude>55 then
			horizontalVelocity=horizontalVelocity.Unit*55
		end
		local predicted=targetRoot.Position+horizontalVelocity*0.035
		local behind=predicted-targetRoot.CFrame.LookVector*followDistance
		local desiredY=targetRoot.Position.Y
		local desiredPosition=Vector3.new(behind.X,desiredY,behind.Z)
		local lookAt=Vector3.new(predicted.X,desiredPosition.Y,predicted.Z)
		local goalCFrame
		if (lookAt-desiredPosition).Magnitude>0.05 then
			goalCFrame=CFrame.lookAt(desiredPosition,lookAt,Vector3.yAxis)
		else
			goalCFrame=CFrame.new(desiredPosition)
		end

		local farFromGoal=(localRoot.Position-desiredPosition).Magnitude>1.0
		local goalMoved=not self.LastGoal or (self.LastGoal-desiredPosition).Magnitude>1.8
		if farFromGoal and (not self.Tween or goalMoved) then
			self:StartTween(goalCFrame,targetRoot)
		elseif not farFromGoal then
			self:CancelTween()
			pcall(function()
				localRoot.Anchored=false
				localHum.AutoRotate=true
			end)
		end
		self.LastTargetPosition=targetRoot.Position
	end)
	self:RefreshButton()
	return true
end

function FollowController:Toggle()
	if self.Active then self:Stop() else self:Start() end
end

MovementController={
	Speed=State.TweenSpeed or 60,
	ActiveTween=nil,
	ActivePart=nil,
	ActiveHumanoid=nil,
	PreviousAnchored=nil,
	PreviousAutoRotate=nil,
	Token=0,
	Slots={["1"]=nil,["2"]=nil,["3"]=nil}
}

function MovementController:SetSpeed(value)
	self.Speed=math.clamp(tonumber(value) or 45,5,120)
end

function MovementController:Save(slot,cf)
	if typeof(cf)~="CFrame" or (slot~="1" and slot~="2" and slot~="3") then return false end
	self.Slots[slot]=cf
	return true
end

function MovementController:Get(slot)
	return self.Slots[slot]
end

function MovementController:BuildRoute(part,target)
	if not part or not part.Parent or typeof(target)~="CFrame" then
		return {}
	end
	return {target}
end

function MovementController:RestorePhysics(part,humanoid)
	if part and part.Parent then
		pcall(function()
			part.AssemblyLinearVelocity=Vector3.zero
			part.AssemblyAngularVelocity=Vector3.zero
			if self.PreviousAnchored~=nil then
				part.Anchored=self.PreviousAnchored
			end
		end)
	end
	if humanoid and humanoid.Parent and self.PreviousAutoRotate~=nil then
		pcall(function()
			humanoid.AutoRotate=self.PreviousAutoRotate
		end)
	end
	self.PreviousAnchored=nil
	self.PreviousAutoRotate=nil
end

function MovementController:Cancel()
	self.Token+=1
	local tween=self.ActiveTween
	local part=self.ActivePart
	local humanoid=self.ActiveHumanoid
	self.ActiveTween=nil
	self.ActivePart=nil
	self.ActiveHumanoid=nil
	if tween then
		pcall(function() tween:Cancel() end)
	end
	self:RestorePhysics(part,humanoid)
end

function MovementController:TweenPart(part,target)
	if not part or not part.Parent or typeof(target)~="CFrame" then return false end
	FollowController:Stop()
	self:Cancel()

	local humanoid=part.Parent:FindFirstChildOfClass("Humanoid")
	local route=self:BuildRoute(part,target)
	if #route==0 then return false end

	self.Token+=1
	local token=self.Token
	self.PreviousAnchored=part.Anchored
	self.PreviousAutoRotate=humanoid and humanoid.AutoRotate or nil
	self.ActivePart=part
	self.ActiveHumanoid=humanoid

	pcall(function()
		part.AssemblyLinearVelocity=Vector3.zero
		part.AssemblyAngularVelocity=Vector3.zero
		part.Anchored=true
		if humanoid then humanoid.AutoRotate=false end
	end)

	task.spawn(function()
		local success=true

		for _,cf in ipairs(route) do
			if token~=self.Token or not part or not part.Parent then
				success=false
				break
			end

			local distance=(part.Position-cf.Position).Magnitude
			if distance<=0.1 then
				part.CFrame=cf
			else
				local duration=math.clamp(distance/math.max(self.Speed,5),0.06,20)
				local ok,tween=pcall(function()
					return TS:Create(
						part,
						TweenInfo.new(duration,Enum.EasingStyle.Linear,Enum.EasingDirection.InOut),
						{CFrame=cf}
					)
				end)

				if not ok or not tween then
					success=false
					break
				end

				self.ActiveTween=tween
				tween:Play()
				local playback=tween.Completed:Wait()

				if token~=self.Token then
					return
				end
				if playback~=Enum.PlaybackState.Completed then
					success=false
					break
				end
			end
		end

		if token~=self.Token then return end

		self.ActiveTween=nil
		self.ActivePart=nil
		self.ActiveHumanoid=nil

		if success and part and part.Parent then
			part.CFrame=route[#route]
		end

		self:RestorePhysics(part,humanoid)
	end)

	return true
end

for slot,data in pairs(State.TweenSlots or {}) do
	if (slot=="1" or slot=="2" or slot=="3") and type(data)=="table" then
		local x,y,z=tonumber(data.x),tonumber(data.y),tonumber(data.z)
		if x and y and z then
			local rx,ry,rz=tonumber(data.rx) or 0,tonumber(data.ry) or 0,tonumber(data.rz) or 0
			MovementController.Slots[slot]=CFrame.new(x,y,z)*CFrame.fromOrientation(rx,ry,rz)
		end
	end
end
MovementController:SetSpeed(State.TweenSpeed)

MovementController.WorkspaceTarget=nil
MovementController.WorkspaceTargetLabel="Chưa chọn"

function SS.GetWorkspaceTweenPart(obj)
	if not obj or typeof(obj)~="Instance" or not obj:IsDescendantOf(WS) then return nil end
	if obj:IsA("BasePart") then return obj end
	local model=obj:IsA("Model") and obj or obj:FindFirstAncestorOfClass("Model")
	if model then
		local part=model:FindFirstChild("HumanoidRootPart",true)
			or model.PrimaryPart
			or model:FindFirstChild("Head",true)
		if part and part:IsA("BasePart") then return part end
		local anyPart=model:FindFirstChildWhichIsA("BasePart",true)
		if anyPart then return anyPart end
	end
	return nil
end

function SS.SetWorkspaceTweenTarget(obj)
	local part=SS.GetWorkspaceTweenPart(obj)
	if not part then
		MovementController.WorkspaceTarget=nil
		MovementController.WorkspaceTargetLabel="Không tìm thấy BasePart hợp lệ"
		if SS.WorkspaceTweenStatus then SS.WorkspaceTweenStatus.Set("Chưa chọn",MovementController.WorkspaceTargetLabel) end
		return false
	end
	if LP.Character and part:IsDescendantOf(LP.Character) then return false end
	MovementController.WorkspaceTarget=part
	local model=part:FindFirstAncestorOfClass("Model")
	local label=(model and model.Name~=WS.Name) and (model.Name.." / "..part.Name) or part:GetFullName()
	MovementController.WorkspaceTargetLabel=label
	local root=SS.GetRoot()
	local distance=root and (root.Position-part.Position).Magnitude or 0
	if SS.WorkspaceTweenStatus then
		SS.WorkspaceTweenStatus.Set("Đã chọn • "..part.Name,string.format("%s  •  %.0f studs",label,distance))
	end
	return true
end

function SS.PickWorkspaceTweenTarget()
	local cam=WS.CurrentCamera
	if not cam then return false,"Camera chưa sẵn sàng" end
	local viewport=cam.ViewportSize
	local ray=cam:ViewportPointToRay(viewport.X*.5,viewport.Y*.5)
	local params=RaycastParams.new()
	params.FilterType=Enum.RaycastFilterType.Exclude
	params.IgnoreWater=true
	local exclude={}
	if LP.Character then exclude[#exclude+1]=LP.Character end
	params.FilterDescendantsInstances=exclude
	local ok,result=pcall(function() return WS:Raycast(ray.Origin,ray.Direction*5000,params) end)
	if not ok or not result or not result.Instance then return false,"Tâm màn hình chưa trỏ vào vật thể" end
	return SS.SetWorkspaceTweenTarget(result.Instance),result.Instance:GetFullName()
end


function SS.GetWorkspaceTweenGoal(part)
	local root=SS.GetRoot()
	if not root or not part or not part.Parent then return nil end
	local offsetY=math.clamp(State.TweenWorkspaceOffsetY or 0,-20,40)
	local stop=math.clamp(State.TweenWorkspaceStopDistance or 3,0,20)
	local targetPos=part.Position+Vector3.new(0,offsetY,0)
	local away=root.Position-targetPos
	local horizontal=Vector3.new(away.X,0,away.Z)
	if stop>0 then
		if horizontal.Magnitude<.05 then horizontal=-part.CFrame.LookVector else horizontal=horizontal.Unit end
		targetPos+=horizontal*stop
	end
	if State.TweenWorkspaceFaceTarget and (part.Position-targetPos).Magnitude>.05 then
		return CFrame.lookAt(targetPos,part.Position,Vector3.yAxis)
	end
	local rx,ry,rz=root.CFrame:ToOrientation()
	return CFrame.new(targetPos)*CFrame.fromOrientation(rx,ry,rz)
end

function SS.TweenToWorkspaceTarget()
	local part=MovementController.WorkspaceTarget
	if not part or not part.Parent or not part:IsDescendantOf(WS) then
		MovementController.WorkspaceTarget=nil
		if SS.WorkspaceTweenStatus then SS.WorkspaceTweenStatus.Set("Mục tiêu không còn tồn tại","Hãy chọn lại từ danh sách hoặc tâm màn hình") end
		return false
	end
	local root=SS.GetRoot()
	local goal=root and SS.GetWorkspaceTweenGoal(part)
	if not root or not goal then return false end
	State.BackCFrame=root.CFrame
	local ok=MovementController:TweenPart(root,goal)
	if SS.WorkspaceTweenStatus then
		local distance=(root.Position-goal.Position).Magnitude
		SS.WorkspaceTweenStatus.Set(ok and "Đang Tween" or "Không thể Tween",string.format("%s  •  %.0f studs",MovementController.WorkspaceTargetLabel,distance))
	end
	return ok
end

function SS.DoTweenForward()
	FollowController:Stop()
	local root=SS.GetRoot()
	if not root then return end
	State.BackCFrame=root.CFrame
	local target=root.CFrame+root.CFrame.LookVector*(State.ForwardDistance or 100)
	if MovementController then MovementController:TweenPart(root,target) end
end

function SS.DoTweenBack()
	FollowController:Stop()
	local root=SS.GetRoot()
	if root and State.BackCFrame and MovementController then
		MovementController:TweenPart(root,State.BackCFrame)
	end
end

function SS.MacroViewport()
	local cam=WS.CurrentCamera
	return cam and cam.ViewportSize or Vector2.new(800,600)
end

function SS.ClampMacro(id)
	local m=State.Macros[id]
	local btn=MacroButtons[id]
	if not m or not btn then return end
	local v=SS.MacroViewport()
	local size=math.clamp(tonumber(m.Size) or 48,36,88)
	m.Size=size
	m.X=math.clamp(tonumber(m.X) or 8,4,math.max(4,v.X-size-4))
	m.Y=math.clamp(tonumber(m.Y) or 220,4,math.max(4,v.Y-size-4))
end

function SS.RefreshMacroSelection()
	for id,stroke in pairs(MacroStrokes) do
		if stroke then
			stroke.Thickness=State.MacroEditMode and (State.MacroSelected==id and 2.5 or 1.25) or 1
			stroke.Transparency=State.MacroEditMode and (State.MacroSelected==id and 0 or .25) or .35
			stroke.Color=State.MacroEditMode and C.P or C.Border
		end
	end
end

function SS.SyncMacro(id)
	local m=State.Macros[id]
	local btn=MacroButtons[id]
	if not m or not btn then return end
	SS.ClampMacro(id)
	btn.Size=UDim2.fromOffset(m.Size,m.Size)
	btn.Position=UDim2.fromOffset(m.X,m.Y)
	btn.BackgroundTransparency=math.clamp(m.Transparency or 0,0,.9)
	btn.Visible=m.Visible==true
	btn.TextSize=math.clamp(math.floor(m.Size*.34),14,24)
end

function SS.SyncAllMacros()
	State.Macros.Next.Visible=State.Macros.Follow.Visible==true
	for _,id in ipairs({"Forward","Back","Follow","Next"}) do SS.SyncMacro(id) end
	if not State.Macros.Follow.Visible and FollowController.Active then FollowController:Stop() end
	SS.RefreshMacroSelection()
end

function SS.SelectMacro(id)
	if not State.Macros[id] then return end
	State.MacroSelected=id
	if MacroSelectControl then MacroSelectControl.Set(id,false) end
	if MacroSizeSlider then MacroSizeSlider.Set(State.Macros[id].Size,false) end
	if MacroTransparencySlider then MacroTransparencySlider.Set(math.floor((State.Macros[id].Transparency or 0)*100+.5),false) end
	SS.RefreshMacroSelection()
	SS.SaveShiftSyncConfig()
end

function SS.SetMacroEditMode(value)
	local nextValue=value==true
	if not nextValue and MacroDrag then
		local drag=MacroDrag
		if drag.Finish then
			drag.Finish()
		else
			MacroDrag=nil
			SS.ClampMacro(drag.Id)
			SS.SyncMacro(drag.Id)
		end
	end
	State.MacroEditMode=nextValue
	if MacroMoveBanner then MacroMoveBanner.Visible=nextValue end
	SS.RefreshMacroSelection()
	SS.SaveShiftSyncConfig()
	if nextValue and UI and UI.Visible then
		task.defer(function()
			if UI and UI.Visible then UI:SetVisible(false) end
		end)
	end
end

function SS.CreateMacroButton(id,text,callback)
	local btn=SS.New("TextButton",{
		Name="Macro"..id,
		BackgroundColor3=C.White,
		BorderSizePixel=0,
		Text=text,
		TextColor3=C.P,
		TextSize=16,
		Font=Enum.Font.GothamBold,
		AutoButtonColor=false,
		Active=true,
		Selectable=false,
		ZIndex=9997,
		Parent=MacroLayer
	})
	SS.Round(btn,14)
	local stroke=SS.New("UIStroke",{Color=C.Border,Thickness=1,Transparency=.35,Parent=btn})
	local scale=SS.New("UIScale",{Scale=1,Parent=btn})
	MacroButtons[id]=btn
	MacroStrokes[id]=stroke

	local interacting=false
	local moved=false
	local editAtStart=false
	local activeInput=nil
	local startPos=nil
	local startButton=nil
	local lastActivation=0

	SS.Keep(btn.InputBegan:Connect(function(input)
		if interacting then return end
		if input.UserInputType~=Enum.UserInputType.Touch
		and input.UserInputType~=Enum.UserInputType.MouseButton1 then
			return
		end

		interacting=true
		moved=false
		editAtStart=State.MacroEditMode==true
		activeInput=input
		startPos=input.Position
		startButton=btn.Position

		if editAtStart then
			SS.SelectMacro(id)
			MacroDrag={Id=id}
			Tween(scale,{Scale=.9},.08)
		end
	end))

	SS.Keep(UIS.InputChanged:Connect(function(input)
		if not interacting or not activeInput then return end
		local valid=false
		if activeInput.UserInputType==Enum.UserInputType.Touch then
			valid=input==activeInput
		else
			valid=input.UserInputType==Enum.UserInputType.MouseMovement
		end
		if not valid then return end

		local delta=input.Position-startPos
		if delta.Magnitude>6 then moved=true end
		if not editAtStart then return end

		local m=State.Macros[id]
		if not m then return end
		local viewport=SS.MacroViewport()
		local size=math.clamp(tonumber(m.Size) or 48,36,88)
		local x=math.clamp(startButton.X.Offset+delta.X,4,math.max(4,viewport.X-size-4))
		local y=math.clamp(startButton.Y.Offset+delta.Y,4,math.max(4,viewport.Y-size-4))
		btn.Position=UDim2.fromOffset(x,y)
		m.X=x
		m.Y=y
	end))

	SS.Keep(UIS.InputEnded:Connect(function(input)
		if not interacting or not activeInput then return end
		local ended=input==activeInput
		if activeInput.UserInputType==Enum.UserInputType.MouseButton1 then
			ended=input.UserInputType==Enum.UserInputType.MouseButton1
		end
		if not ended then return end

		interacting=false
		activeInput=nil

		if editAtStart then
			MacroDrag=nil
			Tween(scale,{Scale=1},.12)
			SS.ClampMacro(id)
			SS.SyncMacro(id)
			SS.SaveShiftSyncConfig()
		else
			if not moved then
				local now=os.clock()
				if now-lastActivation>=0.2 then
					lastActivation=now
					SS.Safe(callback)
				end
			end
		end
	end))

	return btn
end

