SS.LiquidPulseSerial=0
function SS.LiquidPulse(strength)
	if not UI.Visible or not Main.Visible then return end
	strength=math.clamp(tonumber(strength) or 1,.35,1.35)
	if State.FixLag then
		GlassLowerRim.BackgroundTransparency=.74
		Tween(GlassLowerRim,{BackgroundTransparency=.79},.14)
		return
	end
	SS.LiquidPulseSerial+=1
	GlassRefraction.Position=UDim2.new(-.10,0,-.08,0)
	GlassRefraction.Rotation=-8
	GlassRefraction.BackgroundTransparency=math.clamp(.958-.020*strength,.90,.97)
	GlassCaustic.BackgroundTransparency=math.clamp(.945-.045*strength,.86,.98)
	Tween(GlassRefraction,{BackgroundTransparency=.958},.24)
	Tween(GlassCaustic,{BackgroundTransparency=.945},.30)
	local sheenGradient=GlassSheen:FindFirstChildOfClass("UIGradient")
	if sheenGradient then
		sheenGradient.Offset=Vector2.new(-1.02,0)
		Tween(sheenGradient,{Offset=Vector2.new(1.02,0)},.32)
	end
	GlassLowerRim.BackgroundTransparency=.71
	GlassSheen.BackgroundTransparency=.905
	if GlassBlur then
		local target=math.clamp(State.MenuBlur or 7,0,13)
		if math.abs((GlassBlur.Size or 0)-target)>.2 then Tween(GlassBlur,{Size=target},.14) end
	end
end

