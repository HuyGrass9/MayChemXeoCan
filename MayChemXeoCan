	local api={Row=row,Title=titleLabel,Detail=detail,Value=valueButton,Action=action,ListFrame=listFrame,Scroller=scroller,Items={},Expanded=false}
	local generation=0

	local function ClearListButtons()
		generation+=1
		for _,child in ipairs(scroller:GetChildren()) do
			if child:IsA("GuiButton") then child:Destroy() end
		end
	end

	local function DesiredListHeight()
		local count=#(api.Items or {})
		if count<=0 then return 46 end
		return math.clamp(count*34+8,46,188)
	end

	function api.ToggleList(a,b)
		local force
		if a==api then force=b else force=a end
		local open=(force==nil) and (not api.Expanded) or force==true
		if open and UI.OpenPicker and UI.OpenPicker~=api and UI.OpenPicker.ToggleList then
			UI.OpenPicker:ToggleList(false)
		end
		api.Expanded=open
		if open then
			UI.OpenPicker=api
			if type(api.OnOpen)=="function" then SS.CallSafe(api.OnOpen) end
			local h=DesiredListHeight()
			listFrame.Visible=true
			listFrame.Size=UDim2.new(1,-16,0,0)
			listFrame.BackgroundTransparency=.42
			Tween(row,{Size=UDim2.new(1,0,0,70+h)},.20)
			Tween(listFrame,{Size=UDim2.new(1,-16,0,h),BackgroundTransparency=.18},.20)
			if SS.LiquidPulse then SS.LiquidPulse(.55) end
		else
			if UI.OpenPicker==api then UI.OpenPicker=nil end
			Tween(row,{Size=UDim2.new(1,0,0,70)},.18)
			Tween(listFrame,{Size=UDim2.new(1,-16,0,0),BackgroundTransparency=.48},.16)
			task.delay(.18,function() if not api.Expanded and listFrame then listFrame.Visible=false end end)
		end
	end

	function api.SetItems(a,b,c,d)
		local items,onChoose,closeOnChoose
		if a==api then items=b; onChoose=c; closeOnChoose=d else items=a; onChoose=b; closeOnChoose=c end
		api.Items=type(items)=="table" and items or {}
		api.OnChoose=onChoose
		api.CloseOnChoose=closeOnChoose==true
		ClearListButtons()
		local myGeneration=generation
		if #api.Items==0 then
			local empty=SS.New("TextButton",{
				Size=UDim2.new(1,0,0,32),BackgroundColor3=C.White,BackgroundTransparency=.68,
				BorderSizePixel=0,Text=SS.LocalizeText("Không có mục tiêu"),TextColor3=C.Sub,TextSize=9,
				Font=Enum.Font.GothamMedium,AutoButtonColor=false,Parent=scroller
			})
			SS.Round(empty,8)
		else
			local displayCount=math.min(#api.Items,72)
			for i=1,displayCount do
				local item=api.Items[i]
				local itemIndex=i
				local selected=item.Selected==true
				local btn=SS.New("TextButton",{
					Size=UDim2.new(1,0,0,32),BackgroundColor3=selected and C.PSoft or C.White,
					BackgroundTransparency=selected and .28 or .58,BorderSizePixel=0,Text="",
					AutoButtonColor=false,Parent=scroller
				})
				SS.Round(btn,8); SS.GlassStroke(btn,.68,1); SS.GlassInteractive(btn,.97)
				SS.New("TextLabel",{
					Size=UDim2.new(1,-72,0,15),Position=UDim2.fromOffset(8,2),BackgroundTransparency=1,
					Text=tostring(item.Text or item.Name or ("Mục "..i)),TextColor3=C.Text,TextSize=9,
					Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left,
					TextTruncate=Enum.TextTruncate.AtEnd,Parent=btn
				})
				SS.New("TextLabel",{
					Size=UDim2.new(1,-72,0,12),Position=UDim2.fromOffset(8,17),BackgroundTransparency=1,
					Text=tostring(item.Detail or ""),TextColor3=C.Sub,TextSize=7,
					Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left,
					TextTruncate=Enum.TextTruncate.AtEnd,Parent=btn
				})
				local stateLabel=SS.New("TextLabel",{
					Size=UDim2.fromOffset(50,20),Position=UDim2.new(1,-56,.5,-10),
					BackgroundColor3=selected and C.P or C.GlassSoft,BackgroundTransparency=selected and .24 or .48,
					BorderSizePixel=0,Text=tostring(item.StateText or (selected and "ON" or "")),
					TextColor3=selected and C.White or C.PText,TextSize=7,Font=Enum.Font.GothamBold,Parent=btn
				})
				SS.Round(stateLabel,7)
				btn.Activated:Connect(function()
					if Input.Owner or generation~=myGeneration then return end
					if type(api.OnChoose)=="function" then SS.CallSafe(api.OnChoose,itemIndex,item) end
					if api.CloseOnChoose then api:ToggleList(false) end
				end)
			end
			if #api.Items>displayCount then
				local more=SS.New("TextLabel",{Size=UDim2.new(1,0,0,28),BackgroundTransparency=1,Text="+ "..tostring(#api.Items-displayCount).." mục xa hơn",TextColor3=C.Sub,TextSize=8,Font=Enum.Font.GothamMedium,Parent=scroller})
			end
		end
		if api.Expanded then
			local h=DesiredListHeight()
			Tween(row,{Size=UDim2.new(1,0,0,70+h)},.16)
			Tween(listFrame,{Size=UDim2.new(1,-16,0,h)},.16)
		end
	end

	api.Set=function(a,b,c,d,e)
		local valueText,detailText,selected,actionText
		if a==api then valueText=b; detailText=c; selected=d; actionText=e else valueText=a; detailText=b; selected=c; actionText=d end
		SS.SetLocalizedText(valueButton,valueText or "Chưa có mục tiêu","Text",true)
		SS.SetLocalizedText(detail,detailText or "","Text",true)
		SS.SetLocalizedText(action,actionText or (selected and "Bỏ chọn" or "Chọn"),"Text",true)
		Tween(action,{BackgroundColor3=selected and C.P or C.PSoft,BackgroundTransparency=selected and .22 or .38,TextColor3=selected and C.White or C.PText},.14)
	end
	api.SetTitle=function(a,b) SS.SetLocalizedText(titleLabel,a==api and b or a or title,"Text",true) end
	api.Bind=function(a,b,c,d,e)
		local onPrev,onNext,onAction,onRefresh
		if a==api then onPrev=b; onNext=c; onAction=d; onRefresh=e else onPrev=a; onNext=b; onAction=c; onRefresh=d end
		SS.Keep(prev.Activated:Connect(function() if not Input.Owner then SS.CallSafe(onPrev) end end))
		SS.Keep(nextBtn.Activated:Connect(function() if not Input.Owner then SS.CallSafe(onNext) end end))
		SS.Keep(action.Activated:Connect(function() if not Input.Owner then SS.CallSafe(onAction) end end))
		SS.Keep(refresh.Activated:Connect(function() if not Input.Owner then SS.CallSafe(onRefresh) end end))
	end
	SS.Keep(valueButton.Activated:Connect(function()
		if Input.Owner then return end
		api:ToggleList()
	end))
	self.Pickers[key]=api
	return api
end

