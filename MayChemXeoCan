		SS.Keep(btn.Activated:Connect(function()
			if Input.Owner then return end
			Set(item.Id,true)
		end))
	end
	Set(current,false)
	local api={Row=row}
	api.Get=function() return current end
	api.Set=function(a,b,c)
		local value,fire
		if a==api then value=b; fire=c else value=a; fire=b end
		Set(value,fire)
