	SS.SaveShiftSyncConfig(true)
end

function SS.GetSortedWorkspaceCandidates()
	local list={}
	local root=SS.GetRoot()
	for model,rec in pairs(WorkspaceTargetCache) do
		if model and model.Parent then
			local info=(rec and rec.HealthInfo) or SS.ReadWorkspaceHealth(model,false)
			local shape=(rec and rec.Shape) or (SS.GetNPCShape and SS.GetNPCShape(model,info and info.Humanoid or nil) or nil)
			local part=shape and (shape.Core or shape.Root or shape.Head) or nil
			if info and info.Alive and part and part:IsA("BasePart") then
				list[#list+1]={
					Model=model,
					Part=part,
					Name=model.Name,
					Distance=root and (root.Position-part.Position).Magnitude or math.huge,
					Health=tonumber(info.Health) or 0,
					MaxHealth=math.max(1,tonumber(info.MaxHealth) or 1),
					Selected=SS.IsWorkspaceAimCandidateAllowed(model)
				}
			end
		end
	end
	table.sort(list,function(a,b)
		local ad=a.Distance or math.huge
		local bd=b.Distance or math.huge
		if math.abs(ad-bd)>1 then return ad<bd end
		return tostring(a.Name)<tostring(b.Name)
	end)
	return list
end

function SS.GetWorkspaceTweenBrowseList()
	local list={}
	local root=SS.GetRoot()
	local seen={}
	local stack=WS:GetChildren()
	local checked=0
	while #stack>0 and checked<30000 do
		local obj=table.remove(stack)
		checked+=1
		if obj:IsA("BasePart") and (not LP.Character or not obj:IsDescendantOf(LP.Character)) then
			local container=obj:FindFirstAncestorOfClass("Model") or obj
			if not seen[container] then
				seen[container]=true
				local part=SS.GetWorkspaceTweenPart(container)
				if part and part.Parent and (not State.TweenWorkspaceStaticOnly or part.Anchored) then
					list[#list+1]={Object=container,Part=part,Name=container.Name,Detail=(container:IsA("Model") and (container.Name.." / "..part.Name) or part:GetFullName()),Distance=root and (root.Position-part.Position).Magnitude or math.huge,Anchored=part.Anchored==true}
					if #list>260 then
						table.sort(list,function(a,b) return (a.Distance or math.huge)<(b.Distance or math.huge) end)
						for i=#list,181,-1 do list[i]=nil end
					end
				end
			end
		end
		for _,child in ipairs(obj:GetChildren()) do stack[#stack+1]=child end
		if checked%320==0 then task.wait() end
	end
	table.sort(list,function(a,b)
		local ad=a.Distance or math.huge
		local bd=b.Distance or math.huge
		if math.abs(ad-bd)>1 then return ad<bd end
		return tostring(a.Name)<tostring(b.Name)
	end)
	for i=#list,181,-1 do list[i]=nil end
	return list
end

function SS.IsGreenish(color)
	return color
		and color.G>=.48
		and color.G>color.R*1.14
		and color.G>color.B*1.06
end

function SS.IsSmallGreenDot(gui)
	if not gui:IsA("GuiObject") or not gui.Visible then return false end

	local name=string.lower(tostring(gui.Name or ""))
	if name:find("health",1,true) or name:find("hp",1,true) or name:find("bar",1,true) then
		return false
	end

	local green=false
	if gui:IsA("Frame") or gui:IsA("TextLabel") or gui:IsA("TextButton") then
		green=gui.BackgroundTransparency<.96 and SS.IsGreenish(gui.BackgroundColor3)
	elseif gui:IsA("ImageLabel") or gui:IsA("ImageButton") then
		green=gui.ImageTransparency<.96 and SS.IsGreenish(gui.ImageColor3)
	end
	if not green then return false end

	local w=math.max(math.abs(gui.Size.X.Offset),gui.AbsoluteSize.X)
	local h=math.max(math.abs(gui.Size.Y.Offset),gui.AbsoluteSize.Y)
	if w<=0 or h<=0 then return false end

	local maxSide=math.max(w,h)
	local minSide=math.min(w,h)
	if maxSide>42 then return false end
	if maxSide>24 and minSide/maxSide<.55 then return false end
	return true
end

function SS.IsSmallGreenPartMarker(part,head)
	if not part:IsA("BasePart") or part==head then return false end
	if part.Transparency>=.98 or not SS.IsGreenish(part.Color) then return false end
	if part.Size.X>3.5 or part.Size.Y>3.5 or part.Size.Z>3.5 then return false end

	local offset=part.Position-head.Position
	if offset.Magnitude>6 then return false end
	if offset.Y<.15 then return false end

	return true
end

function SS.IsFriendlyNPC(model)
	if not model or not model.Parent then return true end

	local now=os.clock()
	local cached=NPCFriendlyCache[model]
	if cached and now-cached.Time<3 then
		return cached.Value
	end

	local head=model:FindFirstChild("Head")
	local friendly=false

	if head and head:IsA("BasePart") then
		local stack=model:GetChildren()
		local checked=0
		while #stack>0 and checked<140 and not friendly do
			local obj=table.remove(stack)
			checked+=1
			if obj:IsA("BillboardGui") and obj.Enabled then
				for _,gui in ipairs(obj:GetDescendants()) do
					if SS.IsSmallGreenDot(gui) then friendly=true break end
				end
			elseif obj:IsA("BasePart") and SS.IsSmallGreenPartMarker(obj,head) then
				friendly=true
			end
			if not friendly then
				for _,child in ipairs(obj:GetChildren()) do stack[#stack+1]=child end
			end
		end
	end

	NPCFriendlyCache[model]={Time=now,Value=friendly}
	return friendly
end

function SS.GetNPCShape(model,hum)
	if not model or not model:IsA("Model") then return nil end
	if hum and hum.Health<=0 then return nil end

	local cached=NPCShapeCache[model]
	if cached
		and cached.Head and cached.Head.Parent
		and cached.Core and cached.Core.Parent
	then
		return cached
	end

	local function findPart(names)
		for _,name in ipairs(names) do
			local part=model:FindFirstChild(name,true)
			if part and part:IsA("BasePart") then return part end
		end
		return nil
	end

	local head=findPart({"Head","head","HitboxHead","HeadHitbox"})
	local root=findPart({"HumanoidRootPart","RootPart","Root","Hitbox","BodyRoot"})
	local upper=findPart({"UpperTorso","Chest","UpperBody"})
	local torso=findPart({"Torso","Body","BodyHitbox"})
	local lower=findPart({"LowerTorso","LowerBody"})
	local core=root or upper or torso or lower or model.PrimaryPart

	if not head or not core or not core:IsA("BasePart") then
		NPCShapeCache[model]=nil
		return nil
	end

	local partCount,checked=0,0
	local stack=model:GetChildren()
	while #stack>0 and checked<96 and partCount<4 do
		local obj=table.remove(stack)
		checked+=1
		if obj:IsA("BasePart") then partCount+=1 end
		if partCount<4 then
			for _,child in ipairs(obj:GetChildren()) do stack[#stack+1]=child end
		end
	end
	if partCount<4 then
		NPCShapeCache[model]=nil
		return nil
	end

	if State.WorkspaceAimHitboxStrict then
		local bodySpan=(head.Position-core.Position).Magnitude
		local coreMax=math.max(core.Size.X,core.Size.Y,core.Size.Z)
		if bodySpan<.65 or bodySpan>11.5 or coreMax>10.5 then
			NPCShapeCache[model]=nil
			return nil
		end
	end

	cached={
		Head=head,
		Root=root,
		Upper=upper,
		Torso=torso,
		Lower=lower,
		Core=core
	}
	NPCShapeCache[model]=cached
	return cached
end

function SS.GetNPCPart(model,hum)
	local shape=SS.GetNPCShape(model,hum)
	if not shape then return nil end

	if State.NPCAimPart=="Torso" then
		local torso=shape.Upper or shape.Torso or shape.Lower or shape.Root or shape.Core
		return torso and torso.Parent and torso or nil
	end

	return shape.Head and shape.Head.Parent and shape.Head or nil
end

local ProjectileSpeedNames={
	projectilespeed=true,
	bulletspeed=true,
	muzzlevelocity=true,
	shotspeed=true,
	bulletvelocity=true,
	projectilevelocity=true
}

function SS.NormalizeKey(value)
	return string.lower(tostring(value or "")):gsub("[^%w]","")
end

function SS.GetEquippedToolObject()
	local char=SS.GetCharacter()
	return char and char:FindFirstChildOfClass("Tool") or nil
