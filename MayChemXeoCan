			Parent=Lighting
		})
	end)
	if ok then
		GlassBlur=blurOrErr
	else
		PropertyWarnings[#PropertyWarnings+1]="BlurEffect disabled: "..tostring(blurOrErr)
	end
end

local UI
local WorkspaceTargetCache

local PerformanceController={
	Enabled=false,
	Originals=setmetatable({}, {__mode="k"}),
	GlobalShadows=nil,
	TerrainOriginal=nil,
	FPS=60,
	LowFPS=false,
	Stutter=false,
	AutoLevel=0,
	SampleTime=0,
	SampleFrames=0,
	WorstFrame=0,
	CullElapsed=0,
	DiscoveryElapsed=0,
	CullCursor=1,
	CullEntries={},
	CullKnown=setmetatable({}, {__mode="k"}),
	ProtectedCullModels=setmetatable({}, {__mode="k"}),
	CullOriginals=setmetatable({}, {__mode="k"}),
	Culled=setmetatable({}, {__mode="k"}),
	CulledCount=0,
	LastLevel=0,
	ScanQueue={},
	ScanHead=1,
	ScanReady=false,
	ScanComplete=false
}
function PerformanceController:CaptureEffect(obj)
	if not obj or self.Originals[obj]~=nil then return end
	if obj:IsA("BloomEffect") or obj:IsA("SunRaysEffect") or obj:IsA("DepthOfFieldEffect") or (obj:IsA("BlurEffect") and obj~=GlassBlur) then
		local ok,value=pcall(function() return obj.Enabled end)
		if ok then self.Originals[obj]=value end
	end
end
function PerformanceController:ApplyGameVisuals(enabled)
	if enabled then
		if self.GlobalShadows==nil then pcall(function() self.GlobalShadows=Lighting.GlobalShadows end) end
		for _,obj in ipairs(Lighting:GetChildren()) do
			self:CaptureEffect(obj)
			if self.Originals[obj]~=nil then pcall(function() obj.Enabled=false end) end
		end
		pcall(function() Lighting.GlobalShadows=false end)
		local terrain=WS:FindFirstChildOfClass("Terrain")
		if terrain and not self.TerrainOriginal then
			self.TerrainOriginal={}
			pcall(function() self.TerrainOriginal.Decoration=terrain.Decoration end)
			pcall(function() self.TerrainOriginal.WaterWaveSize=terrain.WaterWaveSize end)
			pcall(function() self.TerrainOriginal.WaterWaveSpeed=terrain.WaterWaveSpeed end)
			pcall(function() self.TerrainOriginal.WaterReflectance=terrain.WaterReflectance end)
		end
		if terrain then
			pcall(function() terrain.Decoration=false end)
			pcall(function() terrain.WaterWaveSize=0 end)
			pcall(function() terrain.WaterWaveSpeed=0 end)
			pcall(function() terrain.WaterReflectance=0 end)
		end
	else
		for obj,value in pairs(self.Originals) do if obj and obj.Parent then pcall(function() obj.Enabled=value end) end end
		if self.GlobalShadows~=nil then pcall(function() Lighting.GlobalShadows=self.GlobalShadows end) end
		local terrain=WS:FindFirstChildOfClass("Terrain")
		local o=self.TerrainOriginal
		if terrain and o then
			if o.Decoration~=nil then pcall(function() terrain.Decoration=o.Decoration end) end
			if o.WaterWaveSize~=nil then pcall(function() terrain.WaterWaveSize=o.WaterWaveSize end) end
			if o.WaterWaveSpeed~=nil then pcall(function() terrain.WaterWaveSpeed=o.WaterWaveSpeed end) end
			if o.WaterReflectance~=nil then pcall(function() terrain.WaterReflectance=o.WaterReflectance end) end
		end
		self.Originals=setmetatable({}, {__mode="k"}); self.GlobalShadows=nil; self.TerrainOriginal=nil
	end
end
function PerformanceController:IsCullablePart(part)
	if not part or not part:IsA("BasePart") or not part.Anchored then return false end
	if part.Transparency>=.985 then return false end
	if math.max(part.Size.X,part.Size.Y,part.Size.Z)>65 then return false end
	local char=LP.Character
	if char and part:IsDescendantOf(char) then return false end
	local cam=WS.CurrentCamera
	if cam and part:IsDescendantOf(cam) then return false end
	local model=part:FindFirstAncestorOfClass("Model")
	if model then
		if self.ProtectedCullModels[model] then return false end
		if model:FindFirstChildOfClass("Humanoid") then
			self.ProtectedCullModels[model]=true
			return false
		end
		if WorkspaceTargetCache and WorkspaceTargetCache[model] then return false end
	end
	return true
end

function PerformanceController:RegisterCullObject(obj)
	if not obj then return end
	if obj:IsA("Humanoid") then
		local model=obj.Parent
		if model and model:IsA("Model") then self.ProtectedCullModels[model]=true end
		return
	end
	if self.CullKnown[obj] then return end
	local kind=nil
	local anchor=nil
	if obj:IsA("BasePart") then
		if not self:IsCullablePart(obj) then return end
		kind="Part"; anchor=obj
	elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles")
		or obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") or obj:IsA("BillboardGui") or obj:IsA("SurfaceGui")
	then
		anchor=obj:FindFirstAncestorWhichIsA("BasePart")
		if not anchor or not self:IsCullablePart(anchor) then return end
		kind="Effect"
	else
		return
	end
	self.CullKnown[obj]=true
	self.CullEntries[#self.CullEntries+1]={Object=obj,Anchor=anchor,Kind=kind,Model=anchor and anchor:FindFirstAncestorOfClass("Model") or nil}
end
function PerformanceController:InitCullScan()
	if self.ScanReady then return end
	self.ScanReady=true
	self.ScanComplete=false
	table.clear(self.ScanQueue)
	self.ScanHead=1
	for _,obj in ipairs(WS:GetChildren()) do self.ScanQueue[#self.ScanQueue+1]=obj end
end
function PerformanceController:StepDiscovery(budget)
	if self.ScanComplete then return end
	self:InitCullScan()
	budget=math.max(1,math.floor(tonumber(budget) or 24))
	while budget>0 and self.ScanHead<=#self.ScanQueue do
		local obj=self.ScanQueue[self.ScanHead]
		self.ScanHead+=1
		budget-=1
		if obj and obj.Parent then
			self:RegisterCullObject(obj)
			local ok,children=pcall(function() return obj:GetChildren() end)
			if ok and children then
				for _,child in ipairs(children) do self.ScanQueue[#self.ScanQueue+1]=child end
			end
		end
	end
	if self.ScanHead>#self.ScanQueue then
		table.clear(self.ScanQueue)
		self.ScanHead=1
		self.ScanComplete=true
	end
end
function PerformanceController:CaptureCullOriginal(entry)
	local obj=entry and entry.Object
	if not obj or self.CullOriginals[obj]~=nil then return end
	if entry.Kind=="Part" then
		local ok,v=pcall(function() return obj.LocalTransparencyModifier end)
		if ok then self.CullOriginals[obj]={Kind="Part",Value=v} end
	else
		local ok,v=pcall(function() return obj.Enabled end)
		if ok then self.CullOriginals[obj]={Kind="Effect",Value=v} end
	end
end
function PerformanceController:SetCulled(entry,culled)
	local obj=entry and entry.Object
	if not obj or not obj.Parent then return end
	if culled then
		if self.Culled[obj] then return end
		self:CaptureCullOriginal(entry)
		local original=self.CullOriginals[obj]
		if not original then return end
		if entry.Kind=="Part" then
			pcall(function() obj.LocalTransparencyModifier=1 end)
		else
			pcall(function() obj.Enabled=false end)
		end
		self.Culled[obj]=true
		self.CulledCount=(self.CulledCount or 0)+1
	else
		if not self.Culled[obj] then return end
		local original=self.CullOriginals[obj]
		if original then
			if original.Kind=="Part" then pcall(function() obj.LocalTransparencyModifier=original.Value end)
			else pcall(function() obj.Enabled=original.Value end) end
		end
		self.Culled[obj]=nil
		self.CulledCount=math.max(0,(self.CulledCount or 1)-1)
	end
end
function PerformanceController:RestoreCullAll()
	for obj in pairs(self.Culled) do
		if obj and obj.Parent then
			local original=self.CullOriginals[obj]
			if original then
				if original.Kind=="Part" then pcall(function() obj.LocalTransparencyModifier=original.Value end)
				else pcall(function() obj.Enabled=original.Value end) end
			end
		end
		self.Culled[obj]=nil
	end
	self.CulledCount=0
end
function PerformanceController:GetAutoLevel()
	if self.Enabled then return 2 end
	local fps=tonumber(self.FPS) or 60
	local current=tonumber(self.AutoLevel) or 0
	if self.Stutter or fps<31 then return 2 end
	if current>=2 then
		if fps<40 then return 2 end
		if fps<52 then return 1 end
		return 0
	elseif current==1 then
		if fps<34 then return 2 end
		if fps>52 then return 0 end
		return 1
	end
	if fps<43 then return 1 end
	return 0
end
function PerformanceController:ShouldCull(anchor,level,cam,entry)
	if level<=0 or not anchor or not anchor.Parent or not cam then return false end
	if not anchor:IsA("BasePart") or not anchor.Anchored or anchor.Transparency>=.985 then return false end
	local model=entry and entry.Model
	if model then
		if self.ProtectedCullModels[model] then return false end
		if WorkspaceTargetCache and WorkspaceTargetCache[model] then return false end
	end
	local cameraPos=cam.CFrame.Position
	local distance=(anchor.Position-cameraPos).Magnitude
	local nearLimit=(level>=2) and 72 or 135
	if distance<=nearLimit then return false end
	local point=cam:WorldToViewportPoint(anchor.Position)
	local vp=cam.ViewportSize
	local margin=(level>=2) and 80 or 130
	local inside=point.Z>0 and point.X>=-margin and point.X<=vp.X+margin and point.Y>=-margin and point.Y<=vp.Y+margin
	if inside then return false end
	if level==1 then return distance>150 end
	return distance>82 or point.Z<=0
end

function PerformanceController:StepCull(level,budget)
	local count=#self.CullEntries
	if count<=0 then return end
	local cam=WS.CurrentCamera
	if not cam then return end
	budget=math.max(4,math.floor(tonumber(budget) or 18))
	local processed=0
	while processed<budget and count>0 do
		if self.CullCursor>count then self.CullCursor=1 end
		local index=self.CullCursor
		local entry=self.CullEntries[index]
		local obj=entry and entry.Object
		local anchor=entry and entry.Anchor
		if not entry or not obj or not obj.Parent or not anchor or not anchor.Parent then
			if obj then
				if self.Culled[obj] then self.CulledCount=math.max(0,(self.CulledCount or 1)-1) end
				self.Culled[obj]=nil; self.CullKnown[obj]=nil; self.CullOriginals[obj]=nil
			end
			self.CullEntries[index]=self.CullEntries[count]
			self.CullEntries[count]=nil
			count-=1
			if self.CullCursor>count then self.CullCursor=1 end
		else
			self:SetCulled(entry,self:ShouldCull(anchor,level,cam,entry))
			self.CullCursor=index+1
			processed+=1
		end
	end
end

function PerformanceController:UpdateSample(dt)
	dt=math.clamp(tonumber(dt) or 1/60,1/240,.25)
	self.SampleTime+=dt
	self.SampleFrames+=1
	self.WorstFrame=math.max(self.WorstFrame,dt)
	if self.SampleTime>=.50 then
		local measured=self.SampleFrames/math.max(self.SampleTime,.001)
		self.FPS=(self.FPS or measured)+(measured-(self.FPS or measured))*.45
		self.Stutter=self.WorstFrame>.065 or (self.FPS<38 and self.WorstFrame>.045)
		self.LowFPS=self.FPS<44
		self.SampleTime=0; self.SampleFrames=0; self.WorstFrame=0
	end
end
function PerformanceController:Tick(dt)
	dt=tonumber(dt) or 0
	self:UpdateSample(dt)
	self.DiscoveryElapsed=(self.DiscoveryElapsed or 0)+dt
	if self.DiscoveryElapsed>=.035 then
		self.DiscoveryElapsed=0
		self:StepDiscovery((self.FPS or 60)<40 and 3 or 7)
	end
	local level=self:GetAutoLevel()
	self.AutoLevel=level
	if level~=(self.LastLevel or 0) then
		if level<=0 and (self.CulledCount or 0)>0 then self:RestoreCullAll() end
		self.LastLevel=level
	end
	if level<=0 then return end
	self.CullElapsed+=dt
	local interval=level>=2 and .060 or .100
	if self.CullElapsed<interval then return end
	self.CullElapsed=0
	self:StepCull(level,level>=2 and 32 or 18)
end

function PerformanceController:SetEnabled(enabled,silent)
	enabled=enabled==true
	if self.Enabled==enabled and not silent then return end
	self.Enabled=enabled
	State.FixLag=enabled
	self:ApplyGameVisuals(enabled)
	if GlassBlur then pcall(function() GlassBlur.Size=enabled and 0 or (UI and UI.Visible and math.clamp(State.MenuBlur or 7,0,13) or 0) end) end
	if SS.PerformanceStatusCard and SS.PerformanceStatusCard.Set then
		SS.PerformanceStatusCard.Set(SS.LocalizeText(enabled and "Fix lag: BẬT" or "Fix lag: TẮT"),SS.LocalizeText(enabled and "Tối ưu mạnh + tự ẩn đồ họa ngoài tầm nhìn" or "Tự tối ưu nền theo FPS"))
	end
	if not silent then SS.SaveShiftSyncConfig(true) end
end
