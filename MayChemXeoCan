function SS.RunFS(entry,eventName,status)
	local function setStatus(a,b)
		if not status or not status.Row or not status.Row.Parent then return end
		pcall(status.Set,a,b)
	end

	local source=tostring(entry.Code or "")
	if source:gsub("%s+","")=="" then
		setStatus("Chưa có code","Control vẫn lưu giá trị bình thường")
		return
	end
	local valid,compileText,compileLine,fn=SS.ValidateCustomSource(source,entry.Id)
	if not valid then
		setStatus("Compile Error"..(compileLine and (" • dòng "..compileLine) or ""),compileText or "Không thể biên dịch")
		return false
	end
	if not fn then
		setStatus("Chưa có code","Control vẫn lưu giá trị bình thường")
		return true
	end

	setStatus("Đang chạy",eventName or "manual")
	task.spawn(function()
		local ctx=SS.FSContext(entry,eventName)
		ctx.Notify=function(a,b) setStatus(tostring(a or "Thông báo"),tostring(b or "")) end
		local okRun,err=xpcall(function()
			return fn(ctx)
		end,function(e)
			local message=tostring(e)
			local okTrace,trace=pcall(function() return debug.traceback(message,2) end)
			return okTrace and trace or message
		end)
		if okRun then
			setStatus("OK",eventName or "manual")
		else
			local runtimeText,runtimeLine=SS.FormatCustomError(err)
			setStatus("Runtime Error"..(runtimeLine and (" • dòng "..runtimeLine) or ""),runtimeText)
			warn("[ShiftSync Custom #"..tostring(entry.Id).."] "..tostring(runtimeText))
		end
	end)
	return true
end

function SS.GetCustomPage(tabName)
	tabName=SS.NormalizeCustomTabName(tabName)
	local existing=SS.CustomPages[tabName]
	if existing and existing.Page and existing.Page.Parent then return existing end
	local id=SS.CustomPageId(tabName)
	local page=UI:AddPage(id,tabName)
	local section=UI:AddSection(page,tabName)
	existing={Id=id,Page=page,Section=section}
	SS.CustomPages[tabName]=existing
	return existing
end

function SS.BuildCustomRuntimeControl(entry)
	entry.TabName=SS.NormalizeCustomTabName(entry.TabName)
	entry.ControlType=(entry.ControlType=="Toggle" or entry.ControlType=="Button" or entry.ControlType=="TextBox") and entry.ControlType or "Slider"
	entry.Min=math.floor(math.clamp(tonumber(entry.Min) or 0,-10000,9999)+.5)
	entry.Max=math.floor(math.clamp(tonumber(entry.Max) or 100,-9999,10000)+.5)
	if entry.Max<=entry.Min then entry.Max=math.min(10000,entry.Min+1) end
	entry.Value=math.floor(math.clamp(tonumber(entry.Value) or entry.Min,entry.Min,entry.Max)+.5)
	entry.TextValue=tostring(entry.TextValue or ""):sub(1,500)

	if entry.RuntimeRow then pcall(function() entry.RuntimeRow:Destroy() end) end
	local rec=SS.GetCustomPage(entry.TabName)
	local key="Custom_"..tostring(entry.Id)
	local status=SS.CustomStatus[entry.Id]
	local api
	if entry.ControlType=="Toggle" then
		api=UI:AddToggle(rec.Section,key,entry.Name or "Chức năng","Tùy biến • "..entry.TabName,entry.Enabled==true,function(v)
			entry.Enabled=v==true
			if not entry.Enabled then SS.CleanupFS(entry.Id) end
			SS.SaveShiftSyncConfig()
			SS.RunFS(entry,entry.Enabled and "toggle_on" or "toggle_off",status)
		end)
		entry.RuntimeRow=api.Row
	elseif entry.ControlType=="Button" then
		api=UI:AddButton(rec.Section,key,entry.Name or "Chức năng","Chạm để chạy",function()
			SS.RunFS(entry,"button",status)
		end)
		entry.RuntimeRow=api
	elseif entry.ControlType=="TextBox" then
		api=UI:AddTextBox(rec.Section,key,entry.Name or "Nội dung",entry.TextValue or "",false,function(v)
			entry.TextValue=tostring(v or ""):sub(1,500)
			SS.SaveShiftSyncConfig()
			SS.RunFS(entry,"text",status)
		end)
		entry.RuntimeRow=api.Row
	else
		api=UI:AddSlider(rec.Section,key,entry.Name or "Giá trị",entry.Min,entry.Max,entry.Value,function(v)
			entry.Value=v
			SS.SaveShiftSyncConfig()
			SS.RunFS(entry,"value",status)
		end)
		entry.RuntimeRow=api.Box
	end
	return api
end

function SS.ClearCustomPages()
	for _,rec in pairs(SS.CustomPages) do
		local id=rec.Id
		if UI.Active==id then UI:SelectPage("Aim",true) end
		if UI.Tabs[id] then pcall(function() UI.Tabs[id]:Destroy() end) end
		if UI.Pages[id] then pcall(function() UI.Pages[id]:Destroy() end) end
		UI.Tabs[id]=nil
		UI.Pages[id]=nil
		UI.PageSelectors[id]=nil
		UI.PageScales[id]=nil
	end
	SS.CustomPages={}
end

function SS.RefreshCustomPages()
	SS.ClearCustomPages()
	for _,entry in ipairs(State.FunctionStudio) do
		if type(entry)=="table" and not entry.Removed then
			local ok,err=pcall(SS.BuildCustomRuntimeControl,entry)
			if not ok then warn("[ShiftSync Custom] control skipped: "..tostring(err)) end
		end
	end
end

function SS.RemoveFSEntry(entry,section)
	entry.Enabled=false
	entry.Removed=true
	SS.CleanupFS(entry.Id)
	SS.CustomMemory[entry.Id]=nil
	for i=#State.FunctionStudio,1,-1 do
		if State.FunctionStudio[i]==entry then table.remove(State.FunctionStudio,i) break end
	end
	if section then pcall(function() section:Destroy() end) end
	SS.CustomEditors[entry.Id]=nil
	SS.CustomStatus[entry.Id]=nil
	if SS.ActiveCustomEditorId==entry.Id then SS.ActiveCustomEditorId=nil end
	SS.RefreshCustomPages()
	if SS.RefreshCustomManager then SS.RefreshCustomManager() end
	SS.SaveShiftSyncConfig(true)
end

function SS.ApplyCustomEntry(entry,status)
	entry.TabName=SS.NormalizeCustomTabName(entry.TabName)
	entry.Name=tostring(entry.Name or "Chức năng"):sub(1,40)
	entry.ControlType=(entry.ControlType=="Toggle" or entry.ControlType=="Button" or entry.ControlType=="TextBox") and entry.ControlType or "Slider"
	entry.Min=math.floor(math.clamp(tonumber(entry.Min) or 0,-10000,9999)+.5)
	entry.Max=math.floor(math.clamp(tonumber(entry.Max) or 100,-9999,10000)+.5)
	if entry.Max<=entry.Min then entry.Max=math.min(10000,entry.Min+1) end
	entry.Value=math.floor(math.clamp(tonumber(entry.Value) or entry.Min,entry.Min,entry.Max)+.5)
	entry.TextValue=tostring(entry.TextValue or ""):sub(1,500)
	local valid,text,line=SS.ValidateCustomSource(entry.Code,entry.Id)
	if not valid then
		if status then status.Set("Code lỗi"..(line and (" • dòng "..line) or ""),text or "Không thể biên dịch") end
		return false
	end
	SS.RefreshCustomPages()
	if SS.RefreshCustomManager then SS.RefreshCustomManager(entry.Id) end
	SS.SaveShiftSyncConfig(true)
	if status then status.Set("Đã áp dụng",entry.TabName.." • "..entry.ControlType.." • code hợp lệ") end
	return true
end

