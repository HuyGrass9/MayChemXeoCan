local MovementRuntime={
	LastForcedSpeed=nil,
	LastForcedJumpPower=nil
}

function SS.ApplyMovement()
	local hum=SS.GetHumanoid()
	if not hum or hum.Health<=0 then return end

	pcall(function()
		if State.Speed then
			if State.OriginalSpeed==nil then
				State.OriginalSpeed=hum.WalkSpeed
			end
			local targetSpeed=math.clamp(State.SpeedValue,16,500)
			if MovementRuntime.LastForcedSpeed
				and hum.WalkSpeed~=MovementRuntime.LastForcedSpeed
				and hum.WalkSpeed~=targetSpeed
			then
				State.OriginalSpeed=hum.WalkSpeed
			end
			if hum.WalkSpeed~=targetSpeed then hum.WalkSpeed=targetSpeed end
			MovementRuntime.LastForcedSpeed=targetSpeed
		elseif State.OriginalSpeed~=nil then
			if hum.WalkSpeed~=State.OriginalSpeed then hum.WalkSpeed=State.OriginalSpeed end
			State.OriginalSpeed=nil
			MovementRuntime.LastForcedSpeed=nil
		else
			MovementRuntime.LastForcedSpeed=nil
		end

		if State.Jump then
			if type(State.OriginalJump)~="table" then
				State.OriginalJump={
					UseJumpPower=hum.UseJumpPower,
					JumpPower=hum.JumpPower,
					JumpHeight=hum.JumpHeight
				}
			end
			local targetJump=math.clamp(State.JumpValue,50,500)
			if MovementRuntime.LastForcedJumpPower
				and hum.JumpPower~=MovementRuntime.LastForcedJumpPower
				and hum.JumpPower~=targetJump
			then
				State.OriginalJump={
					UseJumpPower=hum.UseJumpPower,
					JumpPower=hum.JumpPower,
					JumpHeight=hum.JumpHeight
				}
			end
			if not hum.UseJumpPower then hum.UseJumpPower=true end
			if hum.JumpPower~=targetJump then hum.JumpPower=targetJump end
			MovementRuntime.LastForcedJumpPower=targetJump
		elseif type(State.OriginalJump)=="table" then
			hum.UseJumpPower=State.OriginalJump.UseJumpPower
			hum.JumpPower=State.OriginalJump.JumpPower
			hum.JumpHeight=State.OriginalJump.JumpHeight
			State.OriginalJump=nil
			MovementRuntime.LastForcedJumpPower=nil
		else
			MovementRuntime.LastForcedJumpPower=nil
		end
	end)
end

