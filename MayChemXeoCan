function SS.CopyMacroConfig()
	local out={}
	for id,m in pairs(State.Macros) do
		out[id]={
			Visible=m.Visible==true,
			X=math.floor((tonumber(m.X) or 8)+.5),
			Y=math.floor((tonumber(m.Y) or 220)+.5),
			Size=math.floor((tonumber(m.Size) or 48)+.5),
			Transparency=math.clamp(tonumber(m.Transparency) or 0,0,.9)
		}
	end
	return out
end

function SS.CopyStringList(list)
	local out={}
	if type(list)=="table" then
		for _,value in ipairs(list) do
			value=tostring(value or ""):gsub("[%c]",""):gsub("^%s+",""):gsub("%s+$",""):sub(1,80)
			if value~="" then out[#out+1]=value end
		end
	end
	return out
end

function SS.CopyFunctionStudio()
	local out={}
	for _,entry in ipairs(State.FunctionStudio or {}) do
		if type(entry)=="table" and not entry.Removed then
			local minValue=math.floor(math.clamp(tonumber(entry.Min) or 0,-10000,9999)+.5)
			local maxValue=math.floor(math.clamp(tonumber(entry.Max) or 100,-9999,10000)+.5)
			if maxValue<=minValue then maxValue=math.min(10000,minValue+1) end
			out[#out+1]={
				Id=math.floor(tonumber(entry.Id) or (#out+1)),
				TabName=SS.NormalizeCustomTabName and SS.NormalizeCustomTabName(entry.TabName) or tostring(entry.TabName or "Game"):sub(1,18),
				Name=tostring(entry.Name or ("Function "..tostring(#out+1))):sub(1,40),
				ControlType=(entry.ControlType=="Toggle" or entry.ControlType=="Button" or entry.ControlType=="TextBox") and entry.ControlType or "Slider",
				Min=minValue,
				Max=maxValue,
				Value=math.floor(math.clamp(tonumber(entry.Value) or 50,minValue,maxValue)+.5),
				TextValue=tostring(entry.TextValue or ""):sub(1,500),
				Enabled=entry.Enabled==true,
				Code=tostring(entry.Code or ""):sub(1,12000)
			}
		end
	end
	return out
end

