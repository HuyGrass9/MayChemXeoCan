		danger and Color3.fromRGB(252,244,245) or C.White,
		danger and dangerSoft or (accent and C.P2 or C.GlassStrong),
		110
	)
	return o
end

local Tween
local ActiveTweens=setmetatable({}, {__mode="k"})
local UIAnimationScale=1

function SS.GlassInteractive(button,pressedScale)
	if not button or not button:IsA("GuiButton") then return nil end
	local scale=button:FindFirstChild("LiquidScale") or SS.New("UIScale",{Name="LiquidScale",Scale=1,Parent=button})
	local stroke=button:FindFirstChildOfClass("UIStroke")
	local glow=button:FindFirstChild("LiquidTouchGlow")
	if not glow then
		glow=SS.New("Frame",{
			Name="LiquidTouchGlow",Size=UDim2.fromScale(1,1),BackgroundColor3=C.White,
			BackgroundTransparency=1,BorderSizePixel=0,Active=false,ZIndex=button.ZIndex+1,Parent=button
		})
		SS.Round(glow,10)
	end
	local function settle()
		Tween(scale,{Scale=1},.09)
		Tween(glow,{BackgroundTransparency=1},.15)
		if stroke then Tween(stroke,{Transparency=.68},.12) end
	end
	SS.Keep(button.MouseEnter:Connect(function()
		if stroke then Tween(stroke,{Transparency=.50},.10) end
	end))
	SS.Keep(button.MouseLeave:Connect(settle))
	SS.Keep(button.InputBegan:Connect(function(input)
		if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
			Tween(scale,{Scale=math.max(.982,tonumber(pressedScale) or .986)},.055)
			glow.BackgroundTransparency=.86
			Tween(glow,{BackgroundTransparency=.97},.13)
		end
	end))
	SS.Keep(button.InputEnded:Connect(function(input)
		if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then settle() end
	end))
	return scale
end
Tween=function(o,p,d)
	if not o or not o.Parent then return end
	local previous=ActiveTweens[o]
	if previous then pcall(function() previous:Cancel() end) end
	local tw=TS:Create(
		o,
		TweenInfo.new((d or .13)*UIAnimationScale,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),
		p
	)
	ActiveTweens[o]=tw
	tw.Completed:Connect(function()
		if ActiveTweens[o]==tw then ActiveTweens[o]=nil end
	end)
	tw:Play()
	return tw
end

