function SS.NormalizeCustomTabName(name)
	name=tostring(name or "Game"):gsub("[%c]",""):gsub("^%s+",""):gsub("%s+$","")
	if name=="" then name="Game" end
	return name:sub(1,18)
end

function SS.CustomPageId(name)
	local normalized=SS.NormalizeCustomTabName(name)
	local clean=normalized:gsub("[^%w_]","_"):sub(1,12)
	if clean=="" then clean="Game" end
	local hash=216613626
	for i=1,#normalized do hash=(hash*131+normalized:byte(i))%2147483647 end
	return "Custom_"..clean.."_"..tostring(math.floor(hash))
end

function SS.CleanupFS(id)
	local list=SS.CustomCleanups[id]
	if not list then return end
	SS.CustomCleanups[id]=nil
	for _,item in ipairs(list) do
		pcall(function()
			if typeof(item)=="RBXScriptConnection" then
				item:Disconnect()
			elseif typeof(item)=="Instance" then
				item:Destroy()
			elseif type(item)=="function" then
				item()
			elseif type(item)=="table" and type(item.Disconnect)=="function" then
				item:Disconnect()
			end
		end)
	end
end

function SS.FSContext(entry,eventName)
	local id=entry.Id
	SS.CustomMemory[id]=SS.CustomMemory[id] or {}
	return {
		Enabled=entry.Enabled==true,
		Value=entry.Value,
		Text=entry.TextValue or "",
		ControlType=entry.ControlType or "Slider",
		Min=entry.Min,
		Max=entry.Max,
		Event=eventName,
		Tab=entry.TabName,
		Game={PlaceId=game.PlaceId,GameId=game.GameId,JobId=game.JobId},
		Player=LP,
		Character=SS.GetCharacter(),
		Root=SS.GetRoot(),
		Services={
			Players=Players,
			RunService=RS,
			Workspace=WS,
			TweenService=TS,
			UserInputService=UIS
		},
		Memory=SS.CustomMemory[id],
		AddCleanup=function(item)
			SS.CustomCleanups[id]=SS.CustomCleanups[id] or {}
			SS.CustomCleanups[id][#SS.CustomCleanups[id]+1]=item
			return item
		end,
		FindWorkspace=function(name)
			name=tostring(name or "")
			if name=="" then return nil end
			return WS:FindFirstChild(name,true)
		end,
		SetTweenTarget=function(obj) return SS.SetWorkspaceTweenTarget(obj) end,
		TweenToTarget=function() return SS.TweenToWorkspaceTarget() end,
		GetAimTarget=function() return FOVController and FOVController.Target or nil end,
