local RuntimeInitErrors={}
function SS.RuntimeSafe(label,fn)
	local ok,err=pcall(fn)
	if not ok then
		RuntimeInitErrors[label]=tostring(err)
		warn("[ShiftSync Runtime/"..tostring(label).."] "..tostring(err))
	end
	return ok
end

function SS.SynchronizeRuntimeState()
	if Destroyed then return end

	SS.RuntimeSafe("FOV",function() FOVController:SetEnabled(State.FOVEnabled) end)
	SS.RuntimeSafe("Aim",function() FOVController:SetAim(State.NPCAim) end)

	SS.RuntimeSafe("ESP",function()
		if State.ESP or State.Tracer or State.HP then
			SS.StartVisualLoop()
		else
			SS.StopVisualIfUnused()
		end
	end)

	SS.RuntimeSafe("Ballistics",function() BallisticsController:UpdateTool(true) end)
	SS.RuntimeSafe("Movement",SS.ApplyMovement)
	SS.RuntimeSafe("Macros",SS.SyncAllMacros)
end

function SS.ForceRuntimeRearm()
	if Destroyed then return end
	local wantAim=State.NPCAim
	local wantFOV=State.FOVEnabled
	State.NPCAim=wantAim
	State.FOVEnabled=wantFOV
	SS.RuntimeSafe("AimRearm",function()
		if wantAim or wantFOV then FOVController:Start(true) elseif FOVController.Connection then FOVController:Stop() end
	end)
	SS.RuntimeSafe("ESPRearm",function()
		if State.ESP or State.Tracer or State.HP then
			SS.StartVisualLoop(true)
		else
			SS.StopVisualIfUnused()
		end
	end)
	SS.RuntimeSafe("BallisticsRearm",function() BallisticsController:UpdateTool(true) end)
	SS.RuntimeSafe("MovementRearm",SS.ApplyMovement)
end

local RuntimeRearmSerial=0
function SS.ScheduleRuntimeRearm(reason,delayTime)
	RuntimeRearmSerial+=1
	local serial=RuntimeRearmSerial
	task.delay(delayTime or 0,function()
		if Destroyed or serial~=RuntimeRearmSerial then return end
		SS.RuntimeSafe("RuntimeRearm/"..tostring(reason or "manual"),SS.ForceRuntimeRearm)
	end)
end

function SS.StartRuntimeFeatures()
PerformanceController:SetEnabled(State.FixLag,true)
	SS.SynchronizeRuntimeState()

	task.spawn(function()
		if not game:IsLoaded() then pcall(function() game.Loaded:Wait() end) end
		local deadline=os.clock()+10
		repeat
			if Destroyed then return end
			local char=LP.Character
			local root=char and char:FindFirstChild("HumanoidRootPart")
			local hum=char and char:FindFirstChildOfClass("Humanoid")
			if WS.CurrentCamera and root and hum and hum.Health>0 then break end
			task.wait(.05)
		until os.clock()>=deadline

		if Destroyed then return end
		SS.ScheduleRuntimeRearm("startup-ready",.10)
		task.delay(.22,function()
			if Destroyed then return end
			for _,entry in ipairs(State.FunctionStudio) do
				if entry.ControlType=="Toggle" and entry.Enabled==true then
					SS.RunFS(entry,"toggle_on",SS.CustomStatus and SS.CustomStatus[entry.Id] or nil)
				end
			end
		end)
	end)
end
BootStage("runtime start")
