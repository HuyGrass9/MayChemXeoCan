	end
	return "-- ctx.Value là giá trị thanh kéo\nlocal value = ctx.Value\nif value >= 50 then\n    ctx.SetThemePreset(\"Rose\")\nelse\n    ctx.SetThemePreset(\"Lavender\")\nend\nctx.Notify(\"Giá trị\", tostring(value))"
