function SS.IsFriendlyPlayer(plr)
	if not plr or plr==LP then return true end
	local myTeam=LP.Team
	local theirTeam=plr.Team
	if myTeam and theirTeam and myTeam==theirTeam then return true end
	if not LP.Neutral and not plr.Neutral and LP.TeamColor==plr.TeamColor then return true end
	return false
end

function SS.GetTargetParts(plr)
	if not plr or plr==LP or (State.IgnoreAllies and SS.IsFriendlyPlayer(plr)) then return nil,nil end
	local char=plr.Character
	if not char then return nil,nil end
	local root=char:FindFirstChild("HumanoidRootPart")
	local hum=char:FindFirstChildOfClass("Humanoid")
	if not root or not hum or hum.Health<=0 then return nil,nil end
	return root,hum
end

function SS.GetNearestPlayer(originRoot)
	local root=originRoot or SS.GetRoot()
	if not root then return nil,math.huge end
	local nearest=nil
	local nearestDistance=math.huge
	for _,plr in ipairs(PlayerRegistry) do
		if plr~=LP and (not State.IgnoreAllies or not SS.IsFriendlyPlayer(plr)) then
			local targetRoot,targetHum=SS.GetTargetParts(plr)
			if targetRoot and targetHum then
				local d=(root.Position-targetRoot.Position).Magnitude
				if d<nearestDistance then
					nearestDistance=d
					nearest=plr
				end
			end
		end
	end
	return nearest,nearestDistance
end

function SS.GetSortedTargets(originRoot)
	local root=originRoot or SS.GetRoot()
	local list={}
	if not root then return list end
	for _,plr in ipairs(PlayerRegistry) do
		if plr~=LP and (not State.IgnoreAllies or not SS.IsFriendlyPlayer(plr)) then
			local targetRoot,targetHum=SS.GetTargetParts(plr)
			if targetRoot and targetHum then
				list[#list+1]={Player=plr,Distance=(root.Position-targetRoot.Position).Magnitude}
			end
		end
	end
	table.sort(list,function(a,b) return a.Distance<b.Distance end)
	return list
end


