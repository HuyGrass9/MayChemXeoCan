function UI:SetVisible(v)
	self.Visible=v==true
	local overlay=GUI and GUI:FindFirstChild("Overlay")

	if self.Visible then
		if MacroLayer then MacroLayer.Enabled=false end
		if FOVLayer then FOVLayer.Enabled=false end
		if overlay then overlay.Visible=false end
		Main.Visible=true
		Shadow.Visible=true
		if SS.SyncResizeHandle then SS.SyncResizeHandle() end
		MenuScale.Scale=1
		local targetTransparency=math.clamp((State.MenuTransparency or 16)/100,.08,.22)
		Main.BackgroundTransparency=math.clamp(targetTransparency+.16,.10,.44)
		GlassShield.BackgroundTransparency=.34
		GlassTint.BackgroundTransparency=.94
		local sheenGradient=GlassSheen:FindFirstChildOfClass("UIGradient")
		if sheenGradient then
			sheenGradient.Offset=Vector2.new(-1.15,0)
			Tween(sheenGradient,{Offset=Vector2.new(1.15,0)},.52)
		end
		task.defer(function() if SS.LiquidPulse then SS.LiquidPulse(1.15) end end)
		Tween(Main,{BackgroundTransparency=targetTransparency},.24)
		Tween(GlassShield,{BackgroundTransparency=math.clamp(targetTransparency*.72,.07,.16)},.26)
		Tween(GlassTint,{BackgroundTransparency=.86},.30)
		GlassCaustic.BackgroundTransparency=.98
		Tween(GlassCaustic,{BackgroundTransparency=.91},.34)
		local autoBlur=math.clamp(4+math.floor((targetTransparency-.10)*22+.5),4,13)
		State.MenuBlur=autoBlur
		local blurTarget=(State.FixLag or PerformanceController.LowFPS) and 0 or autoBlur
		if GlassBlur then Tween(GlassBlur,{Size=blurTarget},.18) end
		Tabs.CanvasPosition=Vector2.zero
		SS.ClampMain()
	else
		if ResizeHandle then ResizeHandle.Visible=false end
		if Input.Owner then SS.Release(Input.Owner) end
		if MacroLayer then MacroLayer.Enabled=true end
		if FOVLayer then FOVLayer.Enabled=true end
		if overlay then overlay.Visible=true end
		MenuScale.Scale=1
		Tween(Main,{BackgroundTransparency=.36},.14)
		Tween(GlassShield,{BackgroundTransparency=.48},.14)
		Tween(GlassTint,{BackgroundTransparency=.95},.14)
		Tween(GlassCaustic,{BackgroundTransparency=1},.12)
		if GlassBlur then Tween(GlassBlur,{Size=0},.15) end
		task.delay(.13,function()
			if not UI.Visible then
