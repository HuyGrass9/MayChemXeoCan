function SS.NearestColorPreset(hue)
	hue=(tonumber(hue) or 270)%360
	local presets={{"Lavender",270},{"Blue",216},{"Rose",334},{"Graphite",252}}
	local best,bestDistance="Lavender",math.huge
	for _,item in ipairs(presets) do
		local d=math.abs(hue-item[2])
		d=math.min(d,360-d)
		if d<bestDistance then best,bestDistance=item[1],d end
	end
	return best
end

