function SS.GetHealthBarRatio(root)
	if not root or typeof(root)~="Instance" then return nil end
	local pending={root}
	local head=1
	local checked=0
	while head<=#pending and checked<36 do
		local obj=pending[head]
		head+=1
		checked+=1
		if obj:IsA("TextLabel") or obj:IsA("TextButton") then
			local text=tostring(obj.Text or "")
			local a,b=text:match("(%d+%.?%d*)%s*/%s*(%d+%.?%d*)")
			if a and tonumber(b) and tonumber(b)>0 then
				return math.clamp((tonumber(a) or 0)/tonumber(b),0,1),tonumber(a),tonumber(b)
			end
		end
		if obj:IsA("GuiObject") then
			local key=string.lower(tostring(obj.Name or "")):gsub("[^%w]","")
			local explicitFill=key:find("fill",1,true) or key:find("progress",1,true) or key:find("foreground",1,true)
			local healthNamed=key:find("health",1,true) or key:find("hp",1,true) or key:find("bar",1,true)
			local parent=obj.Parent
			local nested=parent and parent:IsA("GuiObject")
			local xScale=tonumber(obj.Size.X.Scale) or 0
			local partial= xScale>0 and xScale<.995
			if explicitFill or (healthNamed and nested and partial) then
				local ratio=nil
				if xScale>0 and xScale<=1.05 then ratio=xScale end
				if (not ratio or ratio<=0) and nested then
					local pw=parent.AbsoluteSize.X
					local ow=obj.AbsoluteSize.X
					if pw>2 and ow>=0 and ow<pw*.995 then ratio=math.clamp(ow/pw,0,1) end
				end
				if ratio and ratio>=0 and ratio<=1 then return ratio,ratio,1 end
			end
		end
		for _,child in ipairs(obj:GetChildren()) do pending[#pending+1]=child end
	end
	return nil
end

function SS.ReadWorkspaceHealth(model,force)
	if not model or not model.Parent or not model:IsDescendantOf(WS) then return nil end
	if Players:GetPlayerFromCharacter(model) then return nil end
	local now=os.clock()
	local cached=WorkspaceHealthCache[model]
	local cacheWindow=(cached and cached.Info and cached.Info.Source=="HealthBar") and 1.20 or .30
	if not force and cached and now-(cached.Time or 0)<cacheWindow then return cached.Info end

	local hum=model:FindFirstChildOfClass("Humanoid")
	if hum then
		local info={Humanoid=hum,Health=hum.Health,MaxHealth=math.max(1,hum.MaxHealth),Alive=hum.Health>0,Source="Humanoid"}
		WorkspaceHealthCache[model]={Time=now,Info=info}
		return info
	end

	local health,maxHealth=nil,nil
	local hasHealthBar=false

	local okAttrs,attrs=pcall(function() return model:GetAttributes() end)
	if okAttrs and type(attrs)=="table" then
		for key,value in pairs(attrs) do
			local number=tonumber(value)
			if number then
				local n=string.lower(tostring(key or "")):gsub("[^%w]","")
				if n:find("maxhealth",1,true) or n=="maxhp" or n=="healthmax" then
					maxHealth=number
				elseif (n=="hp" or n=="health" or n=="currenthealth" or n:find("health",1,true)) and health==nil then
					health=number
				end
			end
		end
	end

	local pending=model:GetChildren()
	local head=1
	local checked=0
	while head<=#pending and checked<180 do
		local obj=pending[head]
		head+=1
		checked+=1
		local n=string.lower(tostring(obj.Name or "")):gsub("[^%w]","")
		local healthNamed=SS.IsHealthSignalName(obj.Name)

		if healthNamed and (obj:IsA("NumberValue") or obj:IsA("IntValue")) then
			local number=tonumber(obj.Value)
			if number then
				if n:find("maxhealth",1,true) or n=="maxhp" or n=="healthmax" then
					maxHealth=number
				elseif health==nil then
					health=number
				end
			end
		elseif healthNamed and (obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") or obj:IsA("GuiObject")) then
			local ratio,barHealth,barMax=SS.GetHealthBarRatio(obj)
			if ratio~=nil then
				hasHealthBar=true
				if health==nil then
					health=barHealth or ratio
					maxHealth=barMax or 1
				end
			end
		end

		if checked<180 then
			for _,child in ipairs(obj:GetChildren()) do
				pending[#pending+1]=child
			end
		end
	end

	local info=nil
	if health~=nil then
		maxHealth=math.max(tonumber(maxHealth) or math.max(health,1),1)
		info={Humanoid=nil,Health=health,MaxHealth=maxHealth,Alive=health>0,Source="HealthValue"}
	elseif hasHealthBar then
		info=nil
	end

	WorkspaceHealthCache[model]={Time=now,Info=info}
	return info
end

function SS.QueueWorkspaceTarget(obj)
	local model=SS.GetWorkspaceTargetModel(obj)
	if not model or WorkspaceTargetQueued[model] then return end
	WorkspaceTargetQueued[model]=true
	WorkspaceTargetQueue[#WorkspaceTargetQueue+1]=model
end

function SS.RefreshWorkspaceTarget(model)
	if not model then
		return false
	end
	if not model.Parent or not model:IsDescendantOf(WS) then
		WorkspaceTargetCache[model]=nil
		WorkspaceHealthCache[model]=nil
		return false
	end
	local info=SS.ReadWorkspaceHealth(model,true)
	local shape=SS.GetNPCShape and SS.GetNPCShape(model,info and info.Humanoid or nil) or nil
	if info and info.Alive and shape then
		WorkspaceTargetCache[model]={HealthInfo=info,Shape=shape,Seen=os.clock()}
		SS.WorkspaceBrowseDirty=true
		if info.Humanoid then NPCCache[model]=info.Humanoid end
		return true
	end
	WorkspaceTargetCache[model]=nil
	SS.WorkspaceBrowseDirty=true
	return false
end

function SS.AddNPCFromHumanoid(hum)
